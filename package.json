{
  "name": "komal-nakrani-publishing",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "capture:web-proof": "node scripts/capture-web-proof.mjs",
    "check:site": "node scripts/check-built-site.mjs",
    "check:render": "node scripts/check-rendered-site.mjs",
    "preview": "astro preview",
    "validate:publications": "node scripts/validate-publications.mjs",
    "validate:courses": "node scripts/validate-courses.mjs",
    "test:publications": "node --test tests/publication-validation.test.mjs",
    "test:pdf-artifacts": "${PDF_PYTHON:-python3} -m unittest tests/test_publication_pdf_raster.py",
    "test:courses": "node --test tests/course-validation.test.mjs",
    "test:companion": "node --test content/publications/forward-deployed-engineering/companion/tests/*.test.mjs",
    "test:companion:aae": "node --test content/publications/applied-ai-engineering/companion/tests/*.test.mjs",
    "demo:companion": "node content/publications/forward-deployed-engineering/companion/run.mjs",
    "rehearse:companion": "node content/publications/forward-deployed-engineering/companion/rehearse.mjs",
    "course:fde": "node content/courses/forward-deployed-engineering-lab/lab-kit/run.mjs",
    "test:course:fde": "node --test content/courses/forward-deployed-engineering-lab/lab-kit/tests/*.test.mjs",
    "build:pdf": "node scripts/build-publication-pdf.mjs",
    "check": "npm run validate:publications && npm run validate:courses && npm run test:publications && npm run test:pdf-artifacts && npm run test:courses && npm run test:companion && npm run test:companion:aae && npm run test:course:fde && npm run build && npm run check:site",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.9"
  },
  "devDependencies": {
    "@fontsource/space-grotesk": "^5.2.10",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "gray-matter": "^4.0.3"
  }
}
