{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://komalnakrani.com/schemas/agentic-ai-engineering/delegation-envelope-v1.json",
  "title":"FieldOps Identity and Delegation Envelope",
  "type":"object",
  "required":["id","version","fictional","identities","delegation","credentialHandling","approval","revocation","attackFixtures"],
  "properties":{
    "id":{"const":"AR-05"},"version":{"const":"1.0.0"},"fictional":{"const":true},
    "identities":{"type":"object","required":["humanPrincipal","servicePrincipal","agentInstance","task","run","resource"]},
    "delegation":{"type":"object","required":["principal","taskId","runId","agentId","audience","scopes","resources","issuedAt","expiresAt","consequenceCeiling"]},
    "credentialHandling":{"type":"object","required":["modelContext","resolutionPoint","passthrough"]},
    "approval":{"type":"object","required":["principal","taskId","runId","proposalHash","resource","partId","slotId","quantity","scope","issuedAt","expiresAt","oneUse","used","revoked"]},
    "revocation":{"type":"object","required":["checkedBeforeEveryInvocation","checkedBeforeEffect","auditReasonRequired"]},
    "attackFixtures":{"type":"array","minItems":6,"items":{"type":"object","required":["id","mutation","expected"]}}
  }
}
