{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"AR-01 Responsibility and Autonomy Decision",
  "type":"object",
  "required":["id","version","case","fictional","decisions","executionLevels","selectedLevel","disputedClaims","handoff"],
  "properties":{
    "id":{"const":"AR-01"},
    "version":{"type":"string"},
    "case":{"const":"FieldOps Relay"},
    "fictional":{"const":true},
    "decisions":{"type":"array","minItems":1,"items":{"type":"object","required":["id","decision","primaryOwner","classification","evidence","authority","escalation"],"properties":{"id":{"type":"string"},"decision":{"type":"string"},"primaryOwner":{"type":"string"},"classification":{"enum":["owned","partnered","escalated"]},"evidence":{"type":"array"},"authority":{"type":"string"},"escalation":{"type":"string"}}}},
    "executionLevels":{"type":"array","minItems":4,"maxItems":4},
    "selectedLevel":{"enum":["fixed","assisted","single-agent","multi-agent"]},
    "disputedClaims":{"type":"array"},
    "handoff":{"type":"object"}
  }
}
