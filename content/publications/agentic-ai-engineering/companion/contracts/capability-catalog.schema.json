{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://komalnakrani.com/schemas/agentic-ai-engineering/capability-catalog-v1.json",
  "title":"FieldOps Capability Catalog",
  "type":"object",
  "required":["id","version","fictional","capabilities","rejectedCapabilities","ambiguousEffectPolicy"],
  "properties":{
    "id":{"const":"AR-04"},"version":{"const":"1.0.0"},"fictional":{"const":true},
    "capabilities":{"type":"array","minItems":5,"items":{"type":"object","required":["id","version","intent","effectClass","inputSchema","outputSchema","preconditions","principal","scope","freshness","timeoutMs","errors","retry","idempotency","reconciliation","compensation","audit","redaction","double","deprecation"]}},
    "rejectedCapabilities":{"type":"array","minItems":3,"items":{"type":"string"}},
    "ambiguousEffectPolicy":{"type":"object","required":["onTimeout","sameKeyDifferentIntent","exactlyOnceClaim"]}
  }
}
