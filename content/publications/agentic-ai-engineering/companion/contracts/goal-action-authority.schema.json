{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"AR-02 Goal Action Authority Contract",
  "type":"object",
  "required":["id","version","taskId","principal","goal","completion","actions","budgets","stop","escalation","approval","nonGoals","mutationTests"],
  "properties":{
    "id":{"const":"AR-02"},
    "version":{"const":"1.0.0"},
    "taskId":{"type":"string"},
    "principal":{"type":"string"},
    "goal":{"type":"string"},
    "completion":{"type":"object","required":["predicate","evidence"]},
    "actions":{"type":"array","minItems":1,"items":{"type":"object","required":["id","class","effect","owner","authority","precondition","evidence","stop","escalation"],"properties":{"id":{"type":"string"},"class":{"enum":["read","compute","propose","communicate","effect","prohibited"]},"effect":{"type":"boolean"},"owner":{"type":"string"},"authority":{"type":"string"},"precondition":{"type":"string"},"evidence":{"type":"array"},"stop":{"type":"string"},"escalation":{"type":"string"}}}},
    "budgets":{"type":"object"},
    "stop":{"type":"object"},
    "escalation":{"type":"object"},
    "approval":{"type":"object","required":["requiredFor","binds","approver","expires","oneUse","revalidate"]},
    "nonGoals":{"type":"array"},
    "mutationTests":{"type":"array","minItems":5}
  }
}
