{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://komalnakrani.com/schemas/agentic-ai-engineering/run-state-v1.json",
  "title":"FieldOps Inspectable Run",
  "type":"object",
  "required":["id","version","fictional","states","terminalStates","transitions","budgets","events","completion","faultFixtures"],
  "properties":{
    "id":{"const":"AR-03"},"version":{"const":"1.0.0"},"fictional":{"const":true},
    "states":{"type":"array","uniqueItems":true,"minItems":10,"items":{"type":"string"}},
    "terminalStates":{"type":"array","uniqueItems":true,"minItems":4,"items":{"type":"string"}},
    "transitions":{"type":"array","minItems":10,"items":{"type":"object","required":["from","event","to","enforcedBy"],"properties":{"from":{"type":"string"},"event":{"type":"string"},"to":{"type":"string"},"enforcedBy":{"const":"harness"}},"additionalProperties":false}},
    "budgets":{"type":"object","required":["turns","actions","elapsedMs","effects"],"additionalProperties":{"type":"integer","minimum":0}},
    "events":{"type":"object","required":["requiredFields"],"properties":{"requiredFields":{"type":"array","minItems":10,"uniqueItems":true,"items":{"type":"string"}}}},
    "completion":{"type":"object","required":["evaluatedBy","requiredEvidence"],"properties":{"evaluatedBy":{"const":"harness"},"requiredEvidence":{"type":"array","minItems":1,"items":{"type":"string"}}}},
    "faultFixtures":{"type":"array","minItems":6,"items":{"type":"object","required":["id","expectedDisposition"]}}
  }
}
