{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://komalnakrani.com/books/applied-ai-engineering/companion/contracts/evaluation-case.schema.json",
  "title": "Patchwork evaluation case",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "caseId", "suiteVersion", "caseStatus", "partition", "contractClauseIds", "segments", "dataStates", "mechanisms", "consequences", "input", "expected", "provenance", "constructionGroup"],
  "properties": {
    "schemaVersion": {"const": 1},
    "caseId": {"type": "string", "pattern": "^PF-E[0-9]{3}$"},
    "suiteVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "caseStatus": {"const": "fictional-synthetic"},
    "partition": {"enum": ["development", "evaluator-development", "challenge", "release-evaluation"]},
    "contractClauseIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^PF-B[0-9]{2}$"}},
    "segments": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "dataStates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "mechanisms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "consequences": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "input": {"type": "object"},
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "effectCount", "reasonCodes"],
      "properties": {
        "state": {"enum": ["respond", "clarify", "abstain", "escalate", "degraded", "prohibited"]},
        "effectCount": {"const": 0},
        "reasonCodes": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "provenance": {"const": "deterministic-fixture-generator"},
    "constructionGroup": {"type": "string", "minLength": 3}
  }
}
