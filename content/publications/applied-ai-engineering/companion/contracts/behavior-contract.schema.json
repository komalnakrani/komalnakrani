{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://komalnakrani.com/books/applied-ai-engineering/companion/contracts/behavior-contract.schema.json",
  "title": "Applied AI behavior contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contractId", "version", "status", "caseStatus", "task", "scope", "fallback", "states", "clauses"],
  "properties": {
    "schemaVersion": {"const": 1},
    "contractId": {"type": "string", "pattern": "^[A-Z]{2}-[A-Z0-9]+$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["draft", "review", "approved", "withdrawn"]},
    "caseStatus": {"const": "fictional-synthetic"},
    "task": {"type": "string", "minLength": 20},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["includedSegments", "excludedSegments", "prohibitedEffects"],
      "properties": {
        "includedSegments": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "excludedSegments": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "prohibitedEffects": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "fallback": {"type": "string", "minLength": 10},
    "states": {"type": "array", "minItems": 6, "uniqueItems": true, "items": {"enum": ["respond", "clarify", "abstain", "escalate", "degraded", "prohibited"]}},
    "clauses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "state", "trigger", "requiredBehavior", "evidence", "failureDisposition", "authority", "changeTriggers"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z]{2}-B[0-9]{2}$"},
          "state": {"enum": ["respond", "clarify", "abstain", "escalate", "degraded", "prohibited"]},
          "trigger": {"type": "string", "minLength": 10},
          "requiredBehavior": {"type": "string", "minLength": 15},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
          "failureDisposition": {"enum": ["block", "narrow", "degrade", "warn-monitor", "inform"]},
          "authority": {"type": "string", "minLength": 3},
          "changeTriggers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}}
        }
      }
    }
  }
}
