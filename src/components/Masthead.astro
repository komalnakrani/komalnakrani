---
import Icon from './Icon.astro';

const nav = [
  ['/themes/', 'Themes'],
  ['/docs/getting-started/', 'Docs'],
  ['/bundles/', 'All-Access Pass'],
] as const;

const pathname = Astro.url.pathname;
---
<!-- Announcement Bar -->
<div style="background: var(--ark-ink); color: #ffffff; padding: 8px 16px; text-align: center; font-family: var(--mono); font-size: 11.5px; border-bottom: 1px solid rgba(255, 103, 17, 0.3); display: flex; align-items: center; justify-content: center; gap: 8px;">
  <span style="background: var(--accent); color: #ffffff; padding: 2px 6px; border-radius: var(--r-xs); font-weight: 700; font-size: 10px; text-transform: uppercase;">NEW</span>
  <span>Production Web Themes & Turnkey Architectures</span>
  <a href="/bundles/" style="color: var(--accent); text-decoration: underline; font-weight: 600; margin-left: 4px;">Get Lifetime Pass ($199) →</a>
</div>

<header class="mast">
  <div class="wrap mast-in">
    <a class="wm" href="/" aria-label="Komal Nakrani Home">
      <span class="glyph">KN</span>
      <span class="wmt">Komal Nakrani</span>
    </a>
    <nav class="nav" aria-label="Primary navigation">
      {nav.map(([href, label]) => {
        const isActive = pathname === href || (href !== '/' && pathname.startsWith(href));
        return (
          <a class={`nav-link ${isActive ? 'active' : ''}`} href={href}>
            {label}
          </a>
        );
      })}
    </nav>
    <div style="display: flex; align-items: center; gap: 12px;">
      <a href="/bundles/" class="btn btn-primary" style="font-size: 13.5px; padding: 9px 16px;">
        Get All Access
      </a>
      <button class="menu-btn" aria-label="Open navigation" aria-expanded="false" data-menu-btn>
        <span data-menu-icon-closed><Icon name="menu" /></span>
        <span data-menu-icon-open hidden><Icon name="x" /></span>
      </button>
    </div>
  </div>
  <div class="mobile-nav" data-mobile-nav>
    {nav.map(([href, label]) => <a href={href}>{label}</a>)}
    <a href="/bundles/" style="color: var(--accent); font-weight: 600;">Get All Access ($199)</a>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
  const navigation = document.querySelector<HTMLElement>('[data-mobile-nav]');
  const closed = document.querySelector<HTMLElement>('[data-menu-icon-closed]');
  const open = document.querySelector<HTMLElement>('[data-menu-icon-open]');
  if (button && navigation && closed && open) {
    button.addEventListener('click', () => {
      const expanded = navigation.classList.toggle('open');
      button.setAttribute('aria-expanded', String(expanded));
      closed.hidden = expanded;
      open.hidden = !expanded;
    });
  }
</script>
