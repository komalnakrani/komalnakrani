---
interface Props {
  page: {
    start: number;
    end: number;
    total: number;
    currentPage: number;
    size: number;
    lastPage: number;
    url: {
      current: string;
      prev: string | undefined;
      next: string | undefined;
    };
  };
  baseUrl?: string;
}

const { page, baseUrl = '/themes' } = Astro.props;

// Generate array of page numbers to render cleanly
const totalPages = page.lastPage;
const current = page.currentPage;

function getPageNumbers() {
  const pages: (number | string)[] = [];
  if (totalPages <= 7) {
    for (let i = 1; i <= totalPages; i++) pages.push(i);
  } else {
    pages.push(1);
    if (current > 3) pages.push('...');
    
    const start = Math.max(2, current - 1);
    const end = Math.min(totalPages - 1, current + 1);
    for (let i = start; i <= end; i++) {
      if (!pages.includes(i)) pages.push(i);
    }

    if (current < totalPages - 2) pages.push('...');
    pages.push(totalPages);
  }
  return pages;
}

const pageNumbers = getPageNumbers();

function pageUrl(p: number | string) {
  if (p === 1) return `${baseUrl}/`;
  return `${baseUrl}/${p}/`;
}
---

{totalPages > 1 && (
  <nav class="pagination-bar" aria-label="Catalog pagination">
    <div class="pagination-info">
      Showing <strong>{page.start + 1}–{page.end + 1}</strong> of <strong>{page.total}</strong> themes
    </div>

    <div class="pagination-controls">
      {page.url.prev ? (
        <a href={page.url.prev} class="pg-btn pg-prev" aria-label="Previous page">
          ← Previous
        </a>
      ) : (
        <span class="pg-btn pg-prev is-disabled" aria-disabled="true">
          ← Previous
        </span>
      )}

      <div class="pg-numbers">
        {pageNumbers.map((num) => (
          typeof num === 'number' ? (
            num === current ? (
              <span class="pg-num is-active" aria-current="page">{num}</span>
            ) : (
              <a href={pageUrl(num)} class="pg-num">{num}</a>
            )
          ) : (
            <span class="pg-ellipsis">{num}</span>
          )
        ))}
      </div>

      {page.url.next ? (
        <a href={page.url.next} class="pg-btn pg-next" aria-label="Next page">
          Next →
        </a>
      ) : (
        <span class="pg-btn pg-next is-disabled" aria-disabled="true">
          Next →
        </span>
      )}
    </div>
  </nav>
)}

<style>
  .pagination-bar {
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid var(--rule-3);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .pagination-info {
    font-size: 14px;
    color: var(--ink-3);
    font-family: var(--body);
  }
  .pagination-info strong {
    color: var(--ink);
  }

  .pagination-controls {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .pg-btn {
    display: inline-flex;
    align-items: center;
    padding: 8px 16px;
    border-radius: var(--r-pill);
    background: #ffffff;
    border: 1px solid var(--rule-2);
    color: var(--ink);
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .pg-btn:hover:not(.is-disabled) {
    background: var(--ink-900);
    color: #ffffff;
    border-color: var(--ink-900);
  }

  .pg-btn.is-disabled {
    opacity: 0.4;
    cursor: not-allowed;
    background: transparent;
  }

  .pg-numbers {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .pg-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 36px;
    height: 36px;
    padding: 0 8px;
    border-radius: 6px;
    background: #ffffff;
    border: 1px solid var(--rule-3);
    color: var(--ink);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .pg-num:hover:not(.is-active) {
    border-color: var(--ink-200);
    background: var(--paper-2);
  }

  .pg-num.is-active {
    background: var(--ink-900);
    color: #ffffff;
    border-color: var(--ink-900);
    font-weight: 600;
  }

  .pg-ellipsis {
    padding: 0 4px;
    color: var(--ink-3);
    font-size: 14px;
  }
</style>
