---
import Icon from './Icon.astro';
import { themes } from '../data/themes';
import { DROP, priceRange } from '../data/design';

const allAccessPrice = DROP.allAccessPrice;
const fallbackThemePrice = priceRange(themes).min;
---
<div id="checkout-modal" class="checkout-overlay" style="display: none;">
  <div class="checkout-box">
    <button id="close-checkout" class="close-btn" aria-label="Close Checkout">
      <Icon name="x" />
    </button>

    <div class="checkout-header">
      <div class="wm" style="margin-bottom: 8px;">
        <span class="glyph">KN</span>
        <span class="wmt">Komal</span>
        <span class="badge">Checkout</span>
      </div>
      <h3 id="checkout-title" class="h3" style="font-size: 22px;">Complete Your Order</h3>
      <p class="small" style="color: var(--ink-3); margin-top: 4px;">Instant download & license key generator.</p>
    </div>

    <!-- Plan toggle. Theme prices are per-theme, so the single-theme tab is
         labelled from whichever theme opened the modal. -->
    <div style="display: flex; gap: 6px; margin-top: 16px; background: var(--paper-3); padding: 4px; border-radius: var(--r-pill); border: 1px solid var(--rule-2);">
      <button id="plan-btn-single" type="button" class="plan-toggle-btn" data-plan="single">Single theme</button>
      <button id="plan-btn-pass" type="button" class="plan-toggle-btn active" data-plan="pass">All-access (${allAccessPrice})</button>
    </div>

    <!-- Order Summary Box -->
    <div class="order-summary">
      <div>
        <div id="summary-plan-name" style="font-family: var(--display); font-weight: 400; font-size: 16px; color: var(--ink);">Lifetime All-Access Pass</div>
        <div id="summary-plan-desc" style="font-size: 12px; color: var(--accent-text); margin-top: 2px;">Every theme · unlimited projects</div>
      </div>
      <div id="summary-plan-price" style="font-family: var(--display); font-weight: 400; font-size: 28px; letter-spacing: -.02em; color: var(--ink);">${allAccessPrice}</div>
    </div>

    <!-- Payment Form -->
    <form id="payment-form" onsubmit="return false;" style="margin-top: 20px;">
      <div class="form-group">
        <label class="form-label">Email Address</label>
        <input type="email" id="customer-email" required placeholder="developer@company.com" class="form-input" />
      </div>

      <div class="form-group">
        <label class="form-label">Card Number</label>
        <div class="card-input-wrapper">
          <input type="text" id="card-number" required placeholder="4242 4242 4242 4242" maxlength="19" class="form-input" />
          <span class="card-brand">VISA / MC</span>
        </div>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
        <div class="form-group">
          <label class="form-label">Expiry Date</label>
          <input type="text" id="card-expiry" required placeholder="MM/YY" maxlength="5" class="form-input" />
        </div>
        <div class="form-group">
          <label class="form-label">CVC Code</label>
          <input type="password" id="card-cvc" required placeholder="123" maxlength="4" class="form-input" />
        </div>
      </div>

      <button type="submit" id="pay-submit-btn" class="btn btn-primary btn-lg" style="width: 100%; margin-top: 16px; font-size: 16px; padding: 14px;">
        Complete Payment <Icon name="arrow-right" />
      </button>

      <div style="display: flex; align-items: center; justify-content: center; gap: 12px; margin-top: 14px; font-family: var(--mono); font-size: 11px; color: var(--ink-3);">
        <span>🔒 256-bit SSL Encrypted</span>
        <span>·</span>
        <span>Stripe & LemonSqueezy</span>
      </div>
    </form>

    <!-- Payment Success / License Key Screen -->
    <div id="payment-success-screen" style="display: none; text-align: center; padding: 20px 0;">
      <div style="width: 54px; height: 54px; border-radius: 50%; background: var(--sage-tint); color: var(--accent-text); display: flex; align-items: center; justify-content: center; margin: 0 auto 16px;">
        <Icon name="check" />
      </div>
      <h3 class="h3" style="font-size: 24px;">Payment Successful!</h3>
      <p class="body-t" style="margin: 8px 0 20px; font-size: 15px;">Your license key & learning guide download link generated.</p>

      <div style="background: var(--ink-900); color: var(--ink-inverse); padding: 16px; border-radius: var(--r-sm); font-size: 13px; margin-bottom: 20px;">
        <div style="font-size: 11px; color: var(--sage); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 6px;">Your License Key</div>
        <div id="generated-license-key" style="font-family: var(--code); font-size: 17px; letter-spacing: 0.1em; color: var(--ink-inverse);">KN-KEY-9842-7719</div>
      </div>

      <button id="close-success-btn" class="btn btn-secondary" style="width: 100%;">
        Close & Access Downloads
      </button>
    </div>
  </div>
</div>

<style>
.checkout-overlay {
  position: fixed;
  inset: 0;
  z-index: 999;
  background: rgba(16, 24, 32, 0.75);
  backdrop-filter: blur(12px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
}
.checkout-box {
  background: var(--surface);
  border: 1px solid var(--line-2);
  border-radius: var(--r-lg);
  width: 100%;
  max-width: 480px;
  padding: 32px;
  position: relative;
  box-shadow: 0 24px 64px rgba(16, 24, 32, 0.3);
  animation: modalRise 250ms var(--ease) both;
}
@keyframes modalRise {
  from { opacity: 0; transform: scale(0.96) translateY(10px); }
  to { opacity: 1; transform: scale(1) translateY(0); }
}
.close-btn {
  position: absolute;
  top: 20px;
  right: 20px;
  background: var(--surface-2);
  border: 1px solid var(--line-2);
  border-radius: var(--r-sm);
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ink);
  cursor: pointer;
}
.plan-toggle-btn {
  flex: 1;
  font-family: var(--body);
  font-weight: 600;
  font-size: 12px;
  padding: 7px 8px;
  border-radius: var(--r-xs);
  border: none;
  background: transparent;
  color: var(--ink-3);
  cursor: pointer;
  transition: all var(--dur) var(--ease);
}
.plan-toggle-btn.active {
  background: var(--surface);
  color: var(--ink);
  box-shadow: var(--sh-sm);
}
.order-summary {
  background: var(--surface-2);
  border: 1px solid var(--line-2);
  border-radius: var(--r-sm);
  padding: 16px 20px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16px;
}
.form-group {
  margin-bottom: 14px;
}
.form-label {
  display: block;
  font-family: var(--mono);
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--ink-3);
  margin-bottom: 6px;
}
.form-input {
  width: 100%;
  padding: 11px 14px;
  border-radius: var(--r-sm);
  border: 1px solid var(--line-2);
  background: var(--surface);
  font-family: var(--body);
  font-size: 14.5px;
  color: var(--ink);
  outline: none;
  transition: border-color var(--dur) var(--ease);
}
.form-input:focus {
  border-color: var(--sage);
}
.card-input-wrapper {
  position: relative;
}
.card-brand {
  position: absolute;
  right: 12px;
  top: 50%;
  transform: translateY(-50%);
  font-family: var(--mono);
  font-size: 10px;
  color: var(--ink-3);
}
</style>

<script is:inline define:vars={{ allAccessPrice, fallbackThemePrice }}>
  function initCheckout() {
    const modal = document.getElementById('checkout-modal');
    const closeBtn = document.getElementById('close-checkout');
    const form = document.getElementById('payment-form');
    const successScreen = document.getElementById('payment-success-screen');
    const licenseKeyEl = document.getElementById('generated-license-key');
    const closeSuccessBtn = document.getElementById('close-success-btn');

    const btnSingle = document.getElementById('plan-btn-single');
    const btnPass = document.getElementById('plan-btn-pass');
    const nameEl = document.getElementById('summary-plan-name');
    const descEl = document.getElementById('summary-plan-desc');
    const priceEl = document.getElementById('summary-plan-price');
    const submitBtn = document.getElementById('pay-submit-btn');

    // Remembers the theme that opened the modal, so toggling back to the
    // single-theme tab re-quotes that theme's own price rather than a constant.
    let lastTheme = { price: fallbackThemePrice, name: 'Single theme license' };

    function setPlan(plan, theme) {
      const isPass = plan === 'pass';
      if (theme) lastTheme = theme;

      btnPass?.classList.toggle('active', isPass);
      btnSingle?.classList.toggle('active', !isPass);

      const price = isPass ? allAccessPrice : lastTheme.price;
      if (nameEl) nameEl.textContent = isPass ? 'Lifetime all-access pass' : lastTheme.name;
      if (descEl) {
        descEl.textContent = isPass
          ? 'Every theme · unlimited projects'
          : '1 theme license · commercial use';
      }
      if (priceEl) priceEl.textContent = `$${price}`;
      if (submitBtn) submitBtn.textContent = `Complete payment ($${price})`;
    }

    btnSingle?.addEventListener('click', () => setPlan('single'));
    btnPass?.addEventListener('click', () => setPlan('pass'));

    // Only explicit triggers open checkout. The old handler bound every
    // .btn-primary on the page and guessed the plan from button text, which
    // breaks the moment a theme's price contains "29" or "199".
    document.querySelectorAll('[data-plan-price]').forEach((btn) => {
      btn.addEventListener('click', (event) => {
        event.preventDefault();
        const price = Number(btn.getAttribute('data-plan-price'));
        const name = btn.getAttribute('data-plan-name') || 'Single theme license';
        // Explicit, so a theme that happens to cost exactly the pass price is
        // still quoted as a single theme.
        if (btn.getAttribute('data-plan') === 'pass') {
          setPlan('pass');
        } else {
          setPlan('single', { price, name });
        }
        if (modal) modal.style.display = 'flex';
      });
    });

    setPlan('pass');

    closeBtn?.addEventListener('click', () => {
      if (modal) modal.style.display = 'none';
    });

    if (form && successScreen && modal && licenseKeyEl) {
      form.addEventListener('submit', (event) => {
        event.preventDefault();
        const a = Math.floor(1000 + Math.random() * 9000);
        const b = Math.floor(1000 + Math.random() * 9000);
        licenseKeyEl.textContent = `KN-KEY-${a}-${b}`;
        form.style.display = 'none';
        successScreen.style.display = 'block';
      });
    }

    closeSuccessBtn?.addEventListener('click', () => {
      if (modal) modal.style.display = 'none';
      if (form && successScreen) {
        form.style.display = 'block';
        successScreen.style.display = 'none';
      }
    });
  }

  document.addEventListener('DOMContentLoaded', initCheckout);
</script>
