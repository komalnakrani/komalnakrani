---
import { type Theme } from '../data/themes';
import { accentFor, kindFor, nameFor } from '../data/design';

interface Props {
  theme: Theme;
}

const { theme } = Astro.props;

const accent = accentFor(theme);
const kind = kindFor(theme);
const name = nameFor(theme);
// Only rendered when the theme carries a real former price.
const was = theme.wasPrice;
---
<article class="tcard">
  <!-- Accent-tinted frame holding a screenshot of the real site -->
  <a class="tcard-thumb" href={`/preview/${theme.slug}/`} style={`background: linear-gradient(140deg, ${accent}26, ${accent}0d);`} aria-label={`Live preview of ${name}`}>
    <div class="tcard-window">
      <div class="tcard-chrome">
        <div class="tcard-dot" style={`background: ${accent};`}></div>
        <div class="tcard-bar" style="width: 40px;"></div>
        <div style="flex: 1;"></div>
        <div class="tcard-bar" style="width: 22px;"></div>
      </div>
      <img
        class="tcard-shot"
        src={`/themes/${theme.slug}.webp`}
        alt={`Screenshot of the ${name} theme homepage`}
        width="800"
        height="800"
        loading="lazy"
        decoding="async"
      />
    </div>
  </a>

  <div class="tcard-body">
    <div class="tcard-head">
      <h3 class="tcard-name"><a href={`/themes/${theme.slug}/`}>{name}</a></h3>
      <div style="flex: 1;"></div>
      {was && <span class="tcard-was">${was}</span>}
      <span class="tcard-price">${theme.price}</span>
    </div>

    <div class="tcard-kind">{kind}</div>

    <p class="tcard-blurb">{theme.tagline}</p>

    <div class="tcard-foot">
      <span class="tcard-stack">{theme.techStack[0]}</span>
      <div style="flex: 1;"></div>
      <a class="tcard-cta" href={`/preview/${theme.slug}/`}>Preview</a>
    </div>
  </div>
</article>

<style>
  .tcard {
    background: #ffffff;
    border: 1px solid var(--rule-3);
    border-radius: var(--r-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: border-color var(--dur-slow) var(--ease), box-shadow var(--dur-slow) var(--ease), transform var(--dur-slow) var(--ease);
  }
  .tcard:hover {
    border-color: var(--ink-200);
    box-shadow: var(--sh);
    transform: translateY(-3px);
  }

  .tcard-thumb {
    display: block;
    height: 300px;
    padding: 14px 14px 0;
    border-bottom: 1px solid #EEEADE;
  }
  .tcard-thumb:hover { opacity: 1; }

  .tcard-window {
    background: #ffffff;
    border-radius: 10px 10px 0 0;
    box-shadow: 0 10px 26px rgba(0, 0, 0, .07);
    padding: 11px;
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 8px;
    transition: transform var(--dur-slow) var(--ease);
  }
  .tcard:hover .tcard-window { transform: translateY(-3px); }

  .tcard-chrome { display: flex; gap: 7px; align-items: center; flex-shrink: 0; }
  .tcard-dot { width: 12px; height: 12px; border-radius: 4px; flex-shrink: 0; }
  .tcard-bar { height: 5px; background: #EDEAE0; border-radius: 4px; }
  .tcard-shot {
    flex: 1;
    width: 100%;
    min-height: 0;
    object-fit: cover;
    object-position: top center;
    border-radius: 6px;
    background: var(--paper-3);
    display: block;
  }

  .tcard-body {
    padding: 17px 19px 19px;
    display: flex;
    flex-direction: column;
    gap: 9px;
    flex: 1;
  }
  .tcard-head { display: flex; align-items: baseline; gap: 10px; }
  .tcard-name {
    margin: 0;
    font-family: var(--display);
    font-size: 19px;
    font-weight: 400;
    letter-spacing: -.02em;
    line-height: 1.25;
  }
  .tcard-name a { color: var(--ink); }
  .tcard-was { font-size: 12px; color: var(--ink-3); text-decoration: line-through; }
  .tcard-price { font-size: 17px; color: var(--ink); }

  .tcard-kind { font-size: 12px; color: var(--ink-3); letter-spacing: .06em; }

  .tcard-blurb {
    margin: 0;
    font-size: 14px;
    line-height: 1.65;
    color: var(--ink-2);
    text-wrap: pretty;
    flex: 1;
  }

  .tcard-foot { display: flex; align-items: center; gap: 10px; margin-top: 4px; }
  .tcard-stack { font-size: 12px; color: var(--ink-3); }

  .tcard-cta {
    background: var(--ink-900);
    color: var(--paper);
    padding: 10px 20px;
    border-radius: var(--r-pill);
    font-size: 13px;
    transition: background var(--dur) var(--ease);
  }
  .tcard-cta:hover { background: var(--action-hover); opacity: 1; }
</style>
