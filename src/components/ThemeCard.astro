---
import Icon from './Icon.astro';
import type { Theme } from '../data/themes';

interface Props {
  theme: Theme;
}

const { theme } = Astro.props;

// Curated high-resolution artistic stock previews based on category
const fallbackImages: Record<string, string> = {
  saas: 'https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&w=800&q=80',
  agency: 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=800&q=80',
  portfolio: 'https://images.unsplash.com/photo-1507238691740-187a5b1d37b8?auto=format&fit=crop&w=800&q=80',
  shader: 'https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&w=800&q=80',
  docs: 'https://images.unsplash.com/photo-1555066931-4365d14bab8c?auto=format&fit=crop&w=800&q=80',
  ecommerce: 'https://images.unsplash.com/photo-1472851294608-062f824d29cc?auto=format&fit=crop&w=800&q=80',
  'job board': 'https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=800&q=80',
  directory: 'https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=800&q=80',
  'real estate': 'https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?auto=format&fit=crop&w=800&q=80',
  podcast: 'https://images.unsplash.com/photo-1590602847861-f357a9332bbc?auto=format&fit=crop&w=800&q=80',
  event: 'https://images.unsplash.com/photo-1511578314322-379afb476865?auto=format&fit=crop&w=800&q=80'
};

const cardImage = theme.imageUrl || fallbackImages[theme.category] || fallbackImages.saas;
const cleanSlug = theme.slug.replace(/\.webflow\.io$/g, '').replace(/-next$/g, '');
---
<article class="theme-card">
  <!-- Browser Window Frame Mockup -->
  <div class="card-browser-mockup">
    <div class="browser-header">
      <div class="browser-dots">
        <span class="dot red"></span>
        <span class="dot yellow"></span>
        <span class="dot green"></span>
      </div>
      <div class="browser-url">{cleanSlug}.komalnakrani.com</div>
      <span class="framework-tag">
        NEXT.JS 16
      </span>
    </div>

    <a href={`/preview/${theme.slug}/`} target="_blank" rel="noopener" class="card-stage-link" title={`Live Preview ${theme.name}`}>
      <img 
        src={cardImage} 
        alt={`${theme.name} - Next.js 16 Preview`}
        loading="lazy"
        class="card-preview-img"
      />
      <div class="stage-overlay">
        <span class="btn-preview-hover">
          Live Preview ↗
        </span>
      </div>
    </a>
  </div>

  <!-- Card Information Body -->
  <div class="card-body">
    <div class="card-meta-bar">
      <span class="cat-chip">{theme.category.toUpperCase()}</span>
      <span class="price-chip">$29</span>
    </div>

    <h3 class="card-title">
      <a href={`/themes/${theme.slug}/`}>{theme.name.replace(/ \(Next\.js Edition\)/gi, '')}</a>
    </h3>

    <p class="card-desc">{theme.tagline}</p>

    <div class="card-actions">
      <a href={`/preview/${theme.slug}/`} target="_blank" rel="noopener" class="card-btn card-btn-sec">
        Preview ↗
      </a>
      <a href={`/themes/${theme.slug}/`} class="card-btn card-btn-pri">
        Details ($29)
      </a>
    </div>
  </div>
</article>

<style>
.theme-card {
  background: #0f172a;
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 16px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}
.theme-card:hover {
  border-color: #ff6711;
  box-shadow: 0 16px 40px rgba(255, 103, 17, 0.2);
  transform: translateY(-4px);
}

.card-browser-mockup {
  background: #1e293b;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}
.browser-header {
  padding: 10px 14px;
  background: #0f172a;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.browser-dots {
  display: flex;
  gap: 6px;
}
.dot {
  width: 9px;
  height: 9px;
  border-radius: 50%;
}
.dot.red { background: #ef4444; }
.dot.yellow { background: #f59e0b; }
.dot.green { background: #10b981; }

.browser-url {
  font-family: var(--mono, monospace);
  font-size: 11px;
  color: #94a3b8;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 180px;
}
.framework-tag {
  font-family: var(--mono, monospace);
  font-size: 10px;
  font-weight: 700;
  padding: 2px 8px;
  border-radius: 4px;
  background: rgba(255, 103, 17, 0.18);
  color: #ff6711;
  border: 1px solid rgba(255, 103, 17, 0.35);
  text-transform: uppercase;
}

.card-stage-link {
  display: block;
  position: relative;
  height: 220px;
  overflow: hidden;
  background: #020617;
}
.card-preview-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: top;
  transition: transform 400ms ease;
}
.card-stage-link:hover .card-preview-img {
  transform: scale(1.06);
}
.stage-overlay {
  position: absolute;
  inset: 0;
  background: rgba(2, 6, 23, 0.65);
  backdrop-filter: blur(4px);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.25s ease;
}
.card-stage-link:hover .stage-overlay {
  opacity: 1;
}

.btn-preview-hover {
  background: #ff6711;
  color: #ffffff;
  font-size: 13px;
  font-weight: 700;
  padding: 10px 22px;
  border-radius: 9999px;
  box-shadow: 0 4px 18px rgba(255, 103, 17, 0.5);
  transform: translateY(4px);
  transition: transform 0.2s ease;
}
.card-stage-link:hover .btn-preview-hover {
  transform: translateY(0);
}

.card-body {
  padding: 22px;
  display: flex;
  flex-direction: column;
  flex: 1;
  background: #0f172a;
}
.card-meta-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}
.cat-chip {
  font-family: var(--mono, monospace);
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: #ff6711;
  font-weight: 700;
}
.price-chip {
  font-family: var(--display, sans-serif);
  font-weight: 700;
  font-size: 20px;
  color: #ffffff;
}
.card-title {
  font-family: var(--display, sans-serif);
  font-weight: 700;
  font-size: 19px;
  margin: 0 0 10px;
  line-height: 1.3;
}
.card-title a {
  color: #ffffff;
  text-decoration: none;
  transition: color 0.2s ease;
}
.card-title a:hover {
  color: #ff6711;
}
.card-desc {
  font-family: var(--body, sans-serif);
  font-size: 14px;
  color: #94a3b8;
  line-height: 1.55;
  margin: 0 0 22px;
  flex: 1;
}
.card-actions {
  display: flex;
  gap: 12px;
}
.card-btn {
  flex: 1;
  text-align: center;
  padding: 10px 14px;
  border-radius: 8px;
  font-size: 13.5px;
  font-weight: 600;
  text-decoration: none;
  transition: all 0.2s ease;
}
.card-btn-sec {
  background: rgba(255, 255, 255, 0.06);
  color: #ffffff;
  border: 1px solid rgba(255, 255, 255, 0.15);
}
.card-btn-sec:hover {
  background: rgba(255, 255, 255, 0.12);
  border-color: rgba(255, 255, 255, 0.3);
}
.card-btn-pri {
  background: #ff6711;
  color: #ffffff;
  border: 1px solid #ff6711;
  box-shadow: 0 2px 10px rgba(255, 103, 17, 0.3);
}
.card-btn-pri:hover {
  background: #ff8200;
  border-color: #ff8200;
}
</style>
