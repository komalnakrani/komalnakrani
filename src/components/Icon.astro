const isBrand = name in BRAND;
const dims = size ? { width: size, height: size } : { width: 24, height: 24 };
---
{
  isBrand ? (
    <svg viewBox="0 0 24 24" fill="currentColor" {...dims} aria-hidden="true" set:html={`<path d="${BRAND[name]}"/>`} />
  ) : (
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      {...dims}
      aria-hidden="true"
      set:html={LUCIDE[name] ??''}
    />
  )
}
