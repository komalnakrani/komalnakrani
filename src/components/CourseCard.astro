---
import type { CourseManifest } from '../data/courses';

interface Props { course: CourseManifest }
const { course } = Astro.props;
---
<a class="course-card" href={`/courses/${course.slug}/`}>
  <span class="course-card-k">Optional guided lab</span>
  <h3>{course.title}</h3>
  <p>{course.description}</p>
  <span class="course-card-meta">{course.modules.length} modules · {Math.round(course.durationMinutes / 60)} hours · {course.level}</span>
</a>
