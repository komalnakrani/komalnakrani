---
import { themes } from '../data/themes';
import { DROP, priceRange } from '../data/design';

const range = priceRange(themes);

interface Props {
  type?: 'website' | 'product';
  title?: string;
  description?: string;
}

const {
  type = 'website',
  title = 'Komal Nakrani | Production-ready web themes',
  description = 'Hand-built, production-ready Astro web themes with zero-JS output and full commercial source.',
} = Astro.props;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Komal Nakrani Themes',
  url: 'https://komalnakrani.com',
  logo: 'https://komalnakrani.com/favicon.svg',
  description: 'Publisher of production-ready web themes for founders, agencies and developers.',
  sameAs: [
    'https://github.com',
    'https://twitter.com'
  ]
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Komal Nakrani Marketplace',
  url: 'https://komalnakrani.com',
  description: description,
  publisher: {
    '@type': 'Organization',
    name: 'Komal Nakrani'
  }
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What are the themes built with?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Every theme is built with Astro and ships static, zero-JS-by-default output with hand-written CSS. You get the full source, and each theme has a live preview at every breakpoint before you buy.'
      }
    },
    {
      '@type': 'Question',
      name: 'How much does a single theme cost?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: range.flat
          ? `Every theme is $${range.min}, which includes full commercial source code and lifetime updates for that theme.`
          : `Themes are priced individually from $${range.min} to $${range.max}. Each price is listed on that theme's own page and includes full commercial source code and lifetime updates.`
      }
    },
    {
      '@type': 'Question',
      name: `What is included in the $${DROP.allAccessPrice} All-Access Pass?`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: `The $${DROP.allAccessPrice} All-Access Pass unlocks full commercial source code access to every theme in the catalog, every theme released from here on, unlimited client projects, and free updates forever. It is a single payment with no renewal.`
      }
    }
  ]
};
const passOfferSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Komal Nakrani All-Access Pass',
  description: 'Full commercial access to every production-ready web theme in the catalog, plus every theme released from here on. One payment, no renewal.',
  brand: { '@type': 'Brand', name: 'Komal Nakrani' },
  offers: {
    '@type': 'Offer',
    price: String(DROP.allAccessPrice),
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    url: 'https://komalnakrani.com/pricing/'
  }
};
---
<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(passOfferSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
