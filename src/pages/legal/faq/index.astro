---
import Layout from '../../../layouts/Layout.astro';
import K from '../../../components/K.astro';
import Icon from '../../../components/Icon.astro';

const faqCategories = [
  {
    title: 'General & Purchases',
    faqs: [
      {
        q: 'What is Komal Nakrani Themes?',
        a: 'A small catalog of hand-built web themes. Every theme is an Astro project that builds to static files, ships with its full source, and has a live preview you can open at any breakpoint before you pay.'
      },
      {
        q: 'What payment methods do you accept?',
        a: 'Checkout is handled by Dodo Payments, which acts as Merchant of Record — so cards, wallets and local methods are supported, and sales tax or VAT is calculated and remitted for your country automatically.'
      },
      {
        q: 'How do I access my files after purchasing?',
        a: 'You get an invitation to the private GitHub repository for what you bought, sent to your order email. That gives you the complete source and every future update in place — no re-downloading a zip when a theme changes.'
      }
    ]
  },
  {
    title: 'Licensing & Commercial Use',
    faqs: [
      {
        q: 'Can I use a purchased theme for paying client work?',
        a: 'Yes. Both individual theme purchases and the $199 All-Access Pass (coming soon) include full commercial licensing to build unlimited sites for yourself or for clients.'
      },
      {
        q: 'Can I re-sell or redistribute the theme source code?',
        a: 'No. You may not re-sell, sub-license or redistribute the theme files as a template, kit or starter. Sell the site you built, not the thing you built it from.'
      },
      {
        q: 'Do individual themes cost the same?',
        a: 'No. Each theme is priced on its own page according to its scope — a five-page landing site and a site with a full product catalog are not the same amount of work. The All-Access Pass is a flat $199 for all of them.'
      }
    ]
  },
  {
    title: 'Technical Questions',
    faqs: [
      {
        q: 'What are the themes built with?',
        a: 'Astro. Each theme builds to a directory of static HTML, CSS and assets with no server runtime, and ships zero JavaScript by default — a page with no interactive component sends none at all.'
      },
      {
        q: 'Where can I host them?',
        a: 'Anywhere that serves static files. Every live preview in the catalog runs on Cloudflare Pages, and the docs cover that setup along with Netlify, Vercel and GitHub Pages.'
      },
      {
        q: 'Do the themes include a CMS, payments or user accounts?',
        a: 'No. These are static sites. Editorial content is handled with Markdown content collections in the repo, and each theme ships a working RSS feed. Anything requiring a server — checkout, logins, a database — is yours to add.'
      },
      {
        q: 'Can I see a theme before buying it?',
        a: 'Yes, in full. Every theme has a live preview of the real deployed site, and its detail page lists every route it ships so you can open any of them directly.'
      }
    ]
  }
];
const allFaqs = faqCategories.flatMap((cat) => cat.faqs);
const faqBreadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Legal & Support', url: '/legal/faq/' },
  { name: 'FAQ Overview', url: '/legal/faq/' }
];
---
<Layout
  title="FAQ | Komal Nakrani"
  description="Answers on theme licensing, commercial use, the Astro stack these themes are built on, hosting and payment."
  faqs={allFaqs}
  breadcrumbs={faqBreadcrumbs}
  type="faq"
>
  <main class="rise">
    <section class="wrap section">
      <div style="max-width: 800px; margin: 0 auto;">
        <div style="text-align: center; margin-bottom: 48px;">
          <K idx="01">Legal & Support</K>
          <h1 class="display" style="margin-top: 14px;">
            Frequently Asked <span class="grad">Questions</span>
          </h1>
          <p class="lead" style="margin-top: 14px;">
            Clear answers regarding template licensing, commercial client rights, refund policies, and technical specifications.
          </p>
        </div>

        <!-- Quick Links Pill Bar -->
        <div style="display: flex; gap: 12px; justify-content: center; margin-bottom: 48px; flex-wrap: wrap;">
          <a href="/legal/faq/" class="btn btn-secondary active" style="font-size: 13.5px;">FAQ Overview</a>
          <a href="/legal/license/" class="btn btn-secondary" style="font-size: 13.5px;">License Agreement</a>
          <a href="/docs/licensing/" class="btn btn-secondary" style="font-size: 13.5px;">Licensing Guide</a>
        </div>

        <div style="display: flex; flex-direction: column; gap: 40px;">
          {faqCategories.map((cat) => (
            <div>
              <h2 class="h2" style="margin-bottom: 20px; border-bottom: 1px solid var(--line-2); padding-bottom: 10px; color: var(--ink);">
                {cat.title}
              </h2>
              <div style="display: flex; flex-direction: column; gap: 14px;">
                {cat.faqs.map((item, idx) => (
                  <details class="faq-item" open={idx === 0}>
                    <summary class="faq-summary">
                      <span class="faq-q-text">{item.q}</span>
                      <span class="faq-icon"><Icon name="chevron-down" size={18} /></span>
                    </summary>
                    <div class="faq-content">
                      <p class="faq-a-text">{item.a}</p>
                    </div>
                  </details>
                ))}
              </div>
            </div>
          ))}
        </div>

        <!-- Need Help Banner -->
        <div style="margin-top: 64px; padding: 36px; background: var(--surface-2); border: 1px solid var(--line-2); border-radius: var(--r-lg); text-align: center;">
          <h3 class="h3">Have a question not listed here?</h3>
          <p class="body-t" style="margin: 8px 0 20px;">Reach out directly to our technical support team for fast assistance.</p>
          <a href="/docs/getting-started/" class="btn btn-primary">
            Visit Documentation Center <Icon name="arrow-right" />
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .faq-item {
    background: #ffffff;
    border: 1px solid var(--line-2);
    border-radius: var(--r-lg);
    box-shadow: var(--sh-sm);
    overflow: hidden;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .faq-item[open] {
    border-color: var(--ink-200);
    box-shadow: var(--sh);
  }
  .faq-summary {
    padding: 20px 24px;
    font-size: 17px;
    font-weight: 400;
    color: var(--ink);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    list-style: none;
    user-select: none;
    transition: color 0.15s ease;
  }
  .faq-summary:hover {
    color: var(--accent-text);
  }
  .faq-summary::-webkit-details-marker {
    display: none;
  }
  .faq-icon {
    color: var(--accent-text);
    transition: transform 0.25s ease;
    display: flex;
    align-items: center;
  }
  .faq-item[open] .faq-icon {
    transform: rotate(180deg);
  }
  .faq-content {
    padding: 0 24px 22px;
    border-top: 1px solid var(--line);
  }
  .faq-a-text {
    font-size: 15px;
    color: var(--ink-2);
    line-height: 1.65;
    margin: 16px 0 0;
  }
</style>

