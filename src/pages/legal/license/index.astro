---
import Layout from '../../../layouts/Layout.astro';
import K from '../../../components/K.astro';
---
<Layout title="Commercial License Agreement | Komal Nakrani" description="Official commercial license agreement terms for individual $29 themes, $39 AI solution kits, and the $199 Lifetime All-Access Pass.">
  <main class="rise">
    <section class="wrap section">
      <div style="max-width: 800px; margin: 0 auto;">
        <K idx="01">Legal Terms</K>
        <h1 class="display" style="margin-top: 14px;">Commercial License Agreement</h1>
        <p class="small" style="color: var(--ink-3); margin-top: 8px;">Effective Date: August 2026</p>

        <div class="body-t" style="margin-top: 32px; display: flex; flex-direction: column; gap: 24px; font-size: 16.5px; line-height: 1.65;">
          <p>
            This Commercial License Agreement ("Agreement") governs your download and commercial use of Astro 5 themes, Next.js 15 templates, and Turnkey AI Solution Kits published by <strong>Komal Nakrani</strong>.
          </p>

          <h2 class="h2" style="font-size: 22px; color: var(--ink); border-bottom: 1px solid var(--line-2); padding-bottom: 8px;">1. Grant of License</h2>
          <p>
            Upon purchasing an individual item ($29 Theme / $39 AI Kit) or the $199 Lifetime All-Access Pass, Komal Nakrani grants you a non-exclusive, worldwide, perpetual commercial license to install, customize, and deploy the source code files.
          </p>

          <h2 class="h2" style="font-size: 22px; color: var(--ink); border-bottom: 1px solid var(--line-2); padding-bottom: 8px;">2. Permitted Uses</h2>
          <ul style="list-style: square; padding-left: 20px; display: flex; flex-direction: column; gap: 8px;">
            <td>Create unlimited websites and web apps for your personal business.</td>
            <td>Build unlimited commercial projects for paying clients.</td>
            <td>Use template source code inside commercial SaaS applications.</td>
          </ul>

          <h2 class="h2" style="font-size: 22px; color: var(--ink); border-bottom: 1px solid var(--line-2); padding-bottom: 8px;">3. Prohibited Uses</h2>
          <ul style="list-style: square; padding-left: 20px; display: flex; flex-direction: column; gap: 8px;">
            <td>You may NOT re-sell, bundle, or distribute uncompiled raw source code on public marketplaces.</td>
            <td>You may NOT claim original authorship of the uncompiled theme framework files.</td>
          </ul>
        </div>
      </div>
    </section>
  </main>
</Layout>
