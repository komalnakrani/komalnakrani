---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { themes } from '../../data/themes';
import { DODO } from '../../data/design';
import { DROP, PASS_INCLUDES, priceRange, priceLabel, checkoutUrl } from '../../data/design';

// Individual themes are priced on their own records and quoted on their own
// pages. This page quotes one number: the pass.
const range = priceRange(themes);
const passUrl = checkoutUrl(DODO.allAccessProductId);

const faqs = [
  {
    q: 'Can I still buy a single theme?',
    a: `Yes. Every theme is sold on its own page at its own price — ${priceLabel(range)}. The pass is for when you want more than one.`
  },
  {
    q: 'What does "lifetime" mean here?',
    a: 'Exactly what it says. The themes you unlock stay yours forever, every theme released after you buy is added to your account free, and updates are free forever. There is no renewal and no expiry.'
  },
  {
    q: 'Can I use these for client work?',
    a: 'Yes — unlimited client projects on the pass. The one thing you cannot do is resell or redistribute the raw theme files as templates themselves.'
  },
  {
    q: 'Do you offer refunds?',
    a: 'Every theme has a full live preview at every breakpoint before you pay, so you can see exactly what you are buying. Email Komal if something is not what the preview showed.'
  }
];
---
<Layout
  title={`Pricing — all-access pass $${DROP.allAccessPrice} | Komal Nakrani`}
  description={`One pass, every theme — including every theme released from here on. Unlock the full catalog of production-ready web themes for $${DROP.allAccessPrice}. Individual themes ${priceLabel(range)}.`}
>
  <main class="rise">
    <!-- ========================= THE OFFER ========================= -->
    <section class="wrap" style="padding: 84px 24px 0; text-align: center;">
      <h1 class="display" style="margin: 24px 0 0;">One pass.<br />Every theme.</h1>

      <p class="lead" style="max-width: 560px; margin: 22px auto 0;">
        There is one thing to buy on this page. It unlocks every theme in the catalog,
        across every category, plus every theme released from here on.
      </p>
    </section>

    <section class="wrap" style="padding: 48px 24px 0;">
      <div class="offer">
        <div class="offer-main">
          <div class="offer-eyebrow">ALL-ACCESS PASS</div>

          <div class="offer-figure">
            <span class="offer-now">${DROP.allAccessPrice}</span>
          </div>
          <p class="offer-sub">One payment · not a subscription</p>

          {passUrl ? (
            <a href={passUrl} class="btn btn-lg offer-cta">Get all-access — ${DROP.allAccessPrice}</a>
          ) : (
            <span class="btn btn-lg offer-cta is-disabled" aria-disabled="true">Checkout opening soon</span>
          )}

          <p class="offer-fine">
            Prefer just one? Every theme is sold on its own page at its own price
            — <a href="/themes/">browse the catalog</a>.
          </p>
        </div>

        <div class="offer-list">
          <div class="offer-list-head">What the pass includes</div>
          <ul>
            {PASS_INCLUDES.map((item) => (
              <li class="ai-feature-item" style="color: var(--ink-inverse);">
                <Icon name="check" /> {item}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- ===================== WHAT YOU UNLOCK ====================== -->
    <section class="wrap" style="padding: 84px 24px 0;">
      <div class="sec-head">
        <h2 class="h2" style="margin: 0;">What ${DROP.allAccessPrice} unlocks</h2>
        <a href="/themes/" style="font-size: 14px; color: var(--accent-text);">Browse every theme ➔</a>
      </div>

      <div class="unlock-grid">
        <div class="unlock-cell">
          <div class="unlock-num">All</div>
          <div class="unlock-lbl">production themes in the catalog</div>
        </div>
        <div class="unlock-cell">
          <div class="unlock-num">Every</div>
          <div class="unlock-lbl">category, from storefront to dashboard</div>
        </div>
        <div class="unlock-cell">
          <div class="unlock-num">Forever</div>
          <div class="unlock-lbl">new Friday releases, added free — not just a year</div>
        </div>
        <div class="unlock-cell">
          <div class="unlock-num">∞</div>
          <div class="unlock-lbl">client projects, no per-seat fees</div>
        </div>
      </div>
    </section>

    <!-- ============================ FAQ =========================== -->
    <section class="wrap" style="padding: 84px 24px 100px;">
      <div style="text-align: center; margin-bottom: 34px;">
        <h2 class="h2" style="margin: 0;">Before you buy</h2>
      </div>

      <div class="faq-list">
        {faqs.map((faq, idx) => (
          <details class="faq-row" open={idx === 0}>
            <summary>
              <span>{faq.q}</span>
              <span class="faq-chev"><Icon name="chevron-down" size={18} /></span>
            </summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>
    </section>
  </main>
</Layout>

<style>
  .drop-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--paper-3);
    border: 1px solid var(--rule-2);
    padding: 6px 16px 6px 7px;
    border-radius: var(--r-pill);
    font-size: 13px;
  }

  /* ---------------- The single offer ---------------- */
  .offer {
    background: var(--ink-900);
    color: var(--ink-inverse);
    border-radius: var(--r-lg);
    padding: clamp(28px, 5vw, 56px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: clamp(32px, 5vw, 56px);
    align-items: center;
    max-width: 960px;
    margin: 0 auto;
  }
  .offer-eyebrow { font-size: 12px; letter-spacing: .1em; color: var(--sage); }
  .offer-figure { display: flex; align-items: baseline; gap: 14px; margin: 16px 0 4px; }
  .offer-now { font-size: clamp(52px, 9vw, 76px); letter-spacing: -.04em; line-height: 1; }
  .offer-was { font-size: 20px; opacity: .45; text-decoration: line-through; }
  .offer-sub { margin: 0 0 26px; font-size: 15px; color: rgba(243, 241, 234, .7); }

  .offer-cta {
    width: 100%;
    background: var(--ink-inverse);
    color: var(--ink-900);
    border: 0;
    cursor: pointer;
  }
  .offer-cta:hover { opacity: .88; }
  .is-disabled { opacity: .5; cursor: not-allowed; pointer-events: none; }

  .offer-fine {
    margin: 16px 0 0;
    font-size: 13px;
    line-height: 1.65;
    color: rgba(243, 241, 234, .55);
  }
  .offer-fine a { color: var(--sage); text-decoration: underline; text-underline-offset: 3px; }

  .offer-list-head {
    font-size: 12px;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: rgba(243, 241, 234, .5);
    padding-bottom: 14px;
    margin-bottom: 16px;
    border-bottom: 1px solid rgba(243, 241, 234, .14);
  }
  .offer-list ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* ---------------- What it unlocks ---------------- */
  .unlock-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: 20px;
  }
  .unlock-cell {
    background: #ffffff;
    border: 1px solid var(--rule-3);
    border-radius: var(--r-lg);
    padding: 26px;
  }
  .unlock-num {
    font-family: var(--display);
    font-size: 40px;
    letter-spacing: -.03em;
    line-height: 1;
    color: var(--ink);
  }
  .unlock-lbl {
    font-size: 14px;
    line-height: 1.6;
    color: var(--ink-3);
    margin-top: 10px;
    text-wrap: pretty;
  }

  /* ---------------- FAQ ---------------- */
  .faq-list {
    max-width: 760px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .faq-row {
    background: #ffffff;
    border: 1px solid var(--rule-3);
    border-radius: var(--r-lg);
    overflow: hidden;
  }
  .faq-row summary {
    padding: 20px 24px;
    font-size: 17px;
    letter-spacing: -.01em;
    color: var(--ink);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    list-style: none;
    user-select: none;
  }
  .faq-row summary::-webkit-details-marker { display: none; }
  .faq-chev { color: var(--accent-text); display: flex; transition: transform var(--dur) var(--ease); }
  .faq-row[open] .faq-chev { transform: rotate(180deg); }
  .faq-row p {
    margin: 0;
    padding: 0 24px 22px;
    font-size: 15px;
    line-height: 1.72;
    color: var(--ink-2);
    text-wrap: pretty;
  }
</style>
