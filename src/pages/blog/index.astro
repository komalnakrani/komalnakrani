---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const featuredPost = posts.find((p) => p.data.featured) || posts[0];
const regularPosts = posts.filter((p) => p.id !== featuredPost?.id);

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(date);
}
---

<Layout
  title="Blog & Articles — Komal Nakrani | Astro & Web Performance Insights"
  description="Explore articles on Astro, web performance, theme engineering, Content Collections, MDX components, and zero-JS web design."
  type="website"
>
  <main class="blog-container">
    <div class="wrap">
      <!-- Masthead Header -->
      <div class="blog-hero">
        <div class="blog-eyebrow">Insights & Documentation</div>
        <h1 class="blog-title">Engineering High-Performance Web Themes</h1>
        <p class="blog-subtitle">
          Deep-dives into Astro framework, Content Collections, MDX components, web performance optimization, and theme design.
        </p>
      </div>

      <!-- Featured Post -->
      {featuredPost && (
        <section class="featured-section">
          <div class="featured-badge">Featured Launch Post</div>
          <article class="featured-card">
            <div class="featured-content">
              <div class="post-meta">
                <span class="post-category">{featuredPost.data.category}</span>
                <span class="meta-sep">•</span>
                <time datetime={featuredPost.data.pubDate.toISOString()}>
                  {formatDate(featuredPost.data.pubDate)}
                </time>
                <span class="meta-sep">•</span>
                <span>By {featuredPost.data.author}</span>
              </div>

              <h2 class="featured-title">
                <a href={`/blog/${featuredPost.id}/`}>{featuredPost.data.title}</a>
              </h2>

              <p class="featured-excerpt">{featuredPost.data.description}</p>

              <div class="post-tags">
                {featuredPost.data.tags.map((tag) => (
                  <span class="tag-chip">#{tag}</span>
                ))}
              </div>

              <a href={`/blog/${featuredPost.id}/`} class="read-more-btn">
                Read Article ➔
              </a>
            </div>
          </article>
        </section>
      )}

      <!-- Regular Posts Grid -->
      {regularPosts.length > 0 && (
        <section class="posts-section">
          <h3 class="section-heading">Recent Articles</h3>
          <div class="posts-grid">
            {regularPosts.map((post) => (
              <article class="post-card">
                <div class="post-meta">
                  <span class="post-category">{post.data.category}</span>
                  <span class="meta-sep">•</span>
                  <time datetime={post.data.pubDate.toISOString()}>
                    {formatDate(post.data.pubDate)}
                  </time>
                </div>

                <h3 class="post-card-title">
                  <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                </h3>

                <p class="post-card-excerpt">{post.data.description}</p>

                <div class="post-card-bottom">
                  <div class="post-tags">
                    {post.data.tags.slice(0, 3).map((tag) => (
                      <span class="tag-chip">#{tag}</span>
                    ))}
                  </div>
                  <a href={`/blog/${post.id}/`} class="card-link">
                    Read ➔
                  </a>
                </div>
              </article>
            ))}
          </div>
        </section>
      )}
    </div>
  </main>
</Layout>

<style>
  .blog-container {
    padding: 60px 0 100px;
  }

  .blog-hero {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 54px;
  }

  .blog-eyebrow {
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--sage-deep, #64764F);
    margin-bottom: 12px;
  }

  .blog-title {
    font-size: 42px;
    font-weight: 700;
    line-height: 1.15;
    color: var(--ink-900, #14140F);
    font-family: var(--font-display, sans-serif);
    margin: 0 0 16px;
  }

  .blog-subtitle {
    font-size: 18px;
    line-height: 1.6;
    color: var(--ink-500, #5C5B51);
    margin: 0;
  }

  .featured-section {
    margin-bottom: 60px;
  }

  .featured-badge {
    display: inline-block;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    background: var(--ink-900, #14140F);
    color: #F3F1EA;
    padding: 4px 12px;
    border-radius: 99px;
    margin-bottom: 12px;
  }

  .featured-card {
    background: #ffffff;
    border: 1px solid var(--rule-3, #E9E5D9);
    border-radius: 20px;
    padding: 40px;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.03);
  }

  .post-meta {
    font-size: 13px;
    color: var(--ink-400, #6E6C61);
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }

  .post-category {
    font-weight: 600;
    color: var(--sage-deep, #64764F);
  }

  .meta-sep {
    color: var(--rule-2, #E4E0D2);
  }

  .featured-title {
    font-size: 32px;
    font-weight: 700;
    line-height: 1.25;
    margin: 0 0 16px;
    font-family: var(--font-display, sans-serif);
  }

  .featured-title a {
    color: var(--ink-900, #14140F);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .featured-title a:hover {
    color: var(--sage-deep, #64764F);
  }

  .featured-excerpt {
    font-size: 17px;
    line-height: 1.65;
    color: var(--ink-500, #5C5B51);
    margin: 0 0 24px;
    max-width: 820px;
  }

  .post-tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }

  .tag-chip {
    font-size: 12px;
    font-weight: 500;
    color: var(--ink-500, #5C5B51);
    background: var(--paper-2, #F3F1EA);
    padding: 4px 10px;
    border-radius: 6px;
  }

  .read-more-btn {
    display: inline-block;
    padding: 12px 28px;
    background: var(--ink-900, #14140F);
    color: #F3F1EA;
    font-size: 14px;
    font-weight: 600;
    border-radius: 99px;
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .read-more-btn:hover {
    background: var(--ink-700, #2A2A22);
  }

  .section-heading {
    font-size: 24px;
    font-weight: 600;
    color: var(--ink-900, #14140F);
    margin: 0 0 24px;
    font-family: var(--font-display, sans-serif);
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 24px;
  }

  .post-card {
    background: #ffffff;
    border: 1px solid var(--rule-3, #E9E5D9);
    border-radius: 16px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .post-card:hover {
    border-color: var(--sage, #9BA88C);
    transform: translateY(-2px);
  }

  .post-card-title {
    font-size: 20px;
    font-weight: 600;
    line-height: 1.35;
    margin: 0 0 12px;
    font-family: var(--font-display, sans-serif);
  }

  .post-card-title a {
    color: var(--ink-900, #14140F);
    text-decoration: none;
  }

  .post-card-title a:hover {
    color: var(--sage-deep, #64764F);
  }

  .post-card-excerpt {
    font-size: 14px;
    line-height: 1.6;
    color: var(--ink-500, #5C5B51);
    margin: 0 0 20px;
  }

  .post-card-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .card-link {
    font-size: 13px;
    font-weight: 600;
    color: var(--ink-900, #14140F);
    text-decoration: none;
  }

  @media (max-width: 640px) {
    .blog-title {
      font-size: 32px;
    }
    .featured-card {
      padding: 24px;
    }
    .featured-title {
      font-size: 24px;
    }
  }
</style>
