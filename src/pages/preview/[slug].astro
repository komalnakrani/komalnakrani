---
import Icon from '../../components/Icon.astro';
import CheckoutModal from '../../components/CheckoutModal.astro';
import { themes, type Theme } from '../../data/themes';
import '../../styles/theme.css';
import '../../styles/components.css';

export function getStaticPaths() {
  return themes.map((theme) => ({
    params: { slug: theme.slug },
    props: { theme },
  }));
}

interface Props {
  theme: Theme;
}

const { theme } = Astro.props;

const cleanSlug = theme.slug
  .replace(/\.webflow\.io$/g, '')
  .replace(/webflow-html-website-template/g, 'template')
  .replace(/webflow-ecommerce-template/g, 'ecommerce')
  .replace(/-webflow-/g, '-')
  .replace(/^webflow-/g, '')
  .replace(/-webflow$/g, '')
  .replace(/webflow/g, 'komal')
  .replace(/-next$/g, '')
  .replace(/-astro$/g, '')
  .toLowerCase();

const customSubdomainUrl = `https://${cleanSlug}.komalnakrani.com`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Live Preview: {theme.name} | Komal Nakrani</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body style="margin: 0; padding: 0; background: #0d0d0d; color: #ffffff; overflow: hidden; font-family: var(--body);">
    
    <!-- Floating Minimal Top Bar -->
    <header class="preview-top-bar">
      <div class="ptb-left">
        <a href="/" class="wm" style="text-decoration: none;">
          <span class="glyph" style="width: 28px; height: 28px; font-size: 13px;">KN</span>
          <span class="wmt" style="color: #ffffff; font-size: 15px;">Komal Nakrani</span>
        </a>

        <!-- Theme Selector Dropdown -->
        <select id="preview-theme-select" class="theme-select-dropdown">
          {themes.map((t) => (
            <option value={`/preview/${t.slug}/`} selected={t.slug === theme.slug}>
              {t.name}
            </option>
          ))}
        </select>
      </div>

      <!-- Responsive Viewport Switcher -->
      <div class="ptb-center">
        <div class="device-switcher">
          <button class="device-btn active" data-viewport="100%" title="Desktop View">
            <svg viewBox="0 0 24 24" width="15" height="15" stroke="currentColor" stroke-width="2" fill="none"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
            <span>Desktop</span>
          </button>
          <button class="device-btn" data-viewport="768px" title="Tablet View">
            <svg viewBox="0 0 24 24" width="15" height="15" stroke="currentColor" stroke-width="2" fill="none"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
            <span>Tablet</span>
          </button>
          <button class="device-btn" data-viewport="375px" title="Mobile View">
            <svg viewBox="0 0 24 24" width="15" height="15" stroke="currentColor" stroke-width="2" fill="none"><rect x="5" y="2" width="14" height="20" rx="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
            <span>Mobile</span>
          </button>
        </div>
      </div>

      <!-- Single Primary CTA Button (White buttons removed) -->
      <div class="ptb-right">
        <a href="/bundles/" class="btn btn-primary" style="font-size: 13px; padding: 8px 18px; background: var(--accent); color: #ffffff; box-shadow: 0 4px 14px rgba(255, 103, 17, 0.4);">
          Get All-Access Bundle ($199) <Icon name="arrow-right" />
        </a>
      </div>
    </header>

    <!-- Secure Full-Screen Viewport iFrame Container -->
    <main class="iframe-view-main">
      <div id="iframe-viewport-wrapper" class="viewport-wrapper" style="width: 100%;">
        <iframe 
          id="preview-iframe" 
          src={customSubdomainUrl} 
          class="preview-iframe"
          title={`Live Interactive Preview of ${theme.name}`}
        ></iframe>
      </div>
    </main>

    <CheckoutModal />

    <style>
      .preview-top-bar {
        height: 52px;
        background: #0b0f19;
        color: #ffffff;
        padding: 0 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid rgba(255, 103, 17, 0.3);
      }
      .ptb-left {
        display: flex;
        align-items: center;
        gap: 16px;
      }
      .theme-select-dropdown {
        background: #1e293b;
        color: #ffffff;
        border: 1px solid rgba(255, 103, 17, 0.35);
        border-radius: var(--r-sm);
        padding: 6px 12px;
        font-family: var(--mono);
        font-size: 12.5px;
        outline: none;
        cursor: pointer;
      }
      .ptb-center {
        display: flex;
        align-items: center;
      }
      .device-switcher {
        display: flex;
        gap: 4px;
        background: #1e293b;
        padding: 4px;
        border-radius: var(--r-sm);
        border: 1px solid rgba(255, 255, 255, 0.1);
      }
      .device-btn {
        background: transparent;
        border: none;
        color: #94a3b8;
        padding: 4px 10px;
        border-radius: var(--r-xs);
        font-size: 12px;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 6px;
        transition: all 0.2s ease;
      }
      .device-btn:hover {
        color: #ffffff;
      }
      .device-btn.active {
        background: #ff6711;
        color: #ffffff;
      }
      .ptb-right {
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .iframe-view-main {
        height: calc(100vh - 52px);
        width: 100vw;
        background: #020617;
        display: flex;
        justify-content: center;
        align-items: center;
      }
      .viewport-wrapper {
        height: 100%;
        transition: width 300ms ease;
      }
      .preview-iframe {
        width: 100%;
        height: 100%;
        border: none;
        background: #ffffff;
      }

      @media (max-width: 768px) {
        .ptb-center { display: none; }
        .theme-select-dropdown { max-width: 140px; }
      }
    </style>

    <script>
      const select = document.getElementById('preview-theme-select') as HTMLSelectElement | null;
      if (select) {
        select.addEventListener('change', (e) => {
          const target = (e.target as HTMLSelectElement).value;
          if (target) window.location.href = target;
        });
      }

      const deviceBtns = document.querySelectorAll<HTMLButtonElement>('.device-btn');
      const wrapper = document.getElementById('iframe-viewport-wrapper');

      deviceBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          deviceBtns.forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');
          const vp = btn.getAttribute('data-viewport') || '100%';
          if (wrapper) wrapper.style.width = vp;
        });
      });
    </script>
  </body>
</html>
