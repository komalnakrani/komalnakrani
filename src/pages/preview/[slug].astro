---
import Icon from '../../components/Icon.astro';
import CheckoutModal from '../../components/CheckoutModal.astro';
import { themes, type Theme } from '../../data/themes';
import '../../styles/theme.css';
import '../../styles/components.css';

export function getStaticPaths() {
  return themes.map((theme) => ({
    params: { slug: theme.slug },
    props: { theme },
  }));
}

interface Props {
  theme: Theme;
}

const { theme } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Live Preview: {theme.name} | Komal Nakrani</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body style="margin: 0; padding: 0; background: #0d0d0d; color: #ffffff; overflow: hidden; font-family: var(--body);">
    
    <!-- Floating Minimal Top Bar (No Site Header/Footer) -->
    <header class="preview-top-bar">
      <div class="ptb-left">
        <a href="/" class="wm" style="text-decoration: none;">
          <span class="glyph" style="width: 28px; height: 28px; font-size: 13px;">KN</span>
          <span class="wmt" style="color: #ffffff; font-size: 15px;">Komal</span>
        </a>

        <!-- Theme Selector Dropdown -->
        <select id="preview-theme-select" class="theme-select-dropdown">
          {themes.map((t) => (
            <option value={`/preview/${t.slug}/`} selected={t.slug === theme.slug}>
              {t.name} ({t.framework.toUpperCase()})
            </option>
          ))}
        </select>
      </div>

      <!-- Responsive Viewport Switcher -->
      <div class="ptb-center">
        <div class="device-switcher">
          <button class="device-btn active" data-viewport="100%" title="Desktop View">
            <svg viewBox="0 0 24 24" width="15" height="15" stroke="currentColor" stroke-width="2" fill="none"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
            <span>Desktop</span>
          </button>
          <button class="device-btn" data-viewport="768px" title="Tablet View">
            <svg viewBox="0 0 24 24" width="15" height="15" stroke="currentColor" stroke-width="2" fill="none"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
            <span>Tablet</span>
          </button>
          <button class="device-btn" data-viewport="375px" title="Mobile View">
            <svg viewBox="0 0 24 24" width="15" height="15" stroke="currentColor" stroke-width="2" fill="none"><rect x="5" y="2" width="14" height="20" rx="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
            <span>Mobile</span>
          </button>
        </div>
      </div>

      <!-- Bundle Buy Links & CTAs -->
      <div class="ptb-right">
        <a href="/bundles/" class="btn btn-primary" style="font-size: 13px; padding: 7px 15px; background: var(--accent); color: #ffffff;">
          Get All-Access Bundle ($199) <Icon name="arrow-right" />
        </a>
        <button data-plan-price="29" data-plan-name={theme.name} class="btn btn-secondary pay-trigger-btn" style="font-size: 12.5px; padding: 7px 13px; color: #ffffff; border-color: rgba(255,255,255,0.2);">
          Buy Theme ($29)
        </button>
      </div>
    </header>

    <!-- Secure Full-Screen Viewport iFrame Container -->
    <main class="iframe-view-main">
      <div id="iframe-viewport-wrapper" class="viewport-wrapper" style="width: 100%;">
        <iframe 
          id="preview-iframe" 
          src={`/preview-demos/${theme.slug}/`} 
          class="preview-iframe"
          title={`Live Interactive Preview of ${theme.name}`}
        ></iframe>
      </div>
    </main>

    <CheckoutModal />

    <style>
      .preview-top-bar {
        height: 52px;
        background: var(--ark-ink);
        color: #ffffff;
        padding: 0 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid rgba(255, 103, 17, 0.3);
      }
      .ptb-left {
        display: flex;
        align-items: center;
        gap: 16px;
      }
      .theme-select-dropdown {
        background: var(--ark-ink-soft);
        color: #ffffff;
        border: 1px solid rgba(255, 103, 17, 0.3);
        border-radius: var(--r-sm);
        padding: 5px 12px;
        font-family: var(--body);
        font-size: 13px;
        outline: none;
        cursor: pointer;
        max-width: 220px;
      }
      .theme-select-dropdown option {
        background: var(--ark-ink);
        color: #ffffff;
      }
      .device-switcher {
        display: flex;
        background: var(--ark-ink-soft);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: var(--r-pill);
        padding: 2px;
        gap: 2px;
      }
      .device-btn {
        background: transparent;
        border: none;
        color: var(--ark-grey-300);
        font-family: var(--body);
        font-size: 11.5px;
        font-weight: 600;
        padding: 5px 12px;
        border-radius: var(--r-pill);
        display: inline-flex;
        align-items: center;
        gap: 5px;
        cursor: pointer;
        transition: all var(--dur) var(--ease);
      }
      .device-btn:hover { color: #ffffff; }
      .device-btn.active {
        background: var(--accent);
        color: #ffffff;
      }
      .ptb-right {
        display: flex;
        align-items: center;
        gap: 10px;
      }
      .iframe-view-main {
        height: calc(100vh - 52px);
        display: flex;
        align-items: center;
        justify-content: center;
        background: #0d0d0d;
        overflow-x: auto;
      }
      .viewport-wrapper {
        height: 100%;
        max-width: 100%;
        transition: width 300ms var(--ease);
      }
      .preview-iframe {
        width: 100%;
        height: 100%;
        border: none;
        background: #ffffff;
      }

      @media (max-width: 800px) {
        .device-switcher span { display: none; }
        .theme-select-dropdown { max-width: 130px; }
      }
    </style>

    <script>
      function initPreviewShell() {
        const dropdown = document.getElementById('preview-theme-select') as HTMLSelectElement | null;
        const viewportWrapper = document.getElementById('iframe-viewport-wrapper');
        const deviceBtns = document.querySelectorAll<HTMLButtonElement>('.device-btn');

        if (dropdown) {
          dropdown.addEventListener('change', (e) => {
            const url = (e.target as HTMLSelectElement).value;
            if (url) window.location.href = url;
          });
        }

        deviceBtns.forEach((btn) => {
          btn.addEventListener('click', () => {
            deviceBtns.forEach((b) => b.classList.remove('active'));
            btn.classList.add('active');

            const viewportWidth = btn.getAttribute('data-viewport');
            if (viewportWrapper && viewportWidth) {
              viewportWrapper.style.width = viewportWidth;
            }
          });
        });
      }

      document.addEventListener('DOMContentLoaded', initPreviewShell);
    </script>
  </body>
</html>
