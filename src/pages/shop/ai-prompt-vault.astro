---
import Layout from '../../layouts/Layout.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Shop', url: '/shop/' },
  { name: 'AI Prompt Vault', url: '/shop/ai-prompt-vault/' }
];

const productMeta = {
  name: 'ChatGPT & Claude Prompt Vault for Educators',
  description: '200+ field-tested prompts for primary teachers, educators, and solopreneurs.',
  price: 27,
  currency: 'USD',
  image: '/images/blog/chatgpt-prompt-vault-for-teachers.jpg',
  brand: 'Komal Nakrani',
  category: 'Prompt Engineering'
};
---

<Layout
  title="ChatGPT & Claude Prompt Vault for Educators | Komal Nakrani"
  description="200+ field-tested AI prompts for primary and secondary teachers. Copy and paste exact prompts for differentiated lesson plans, parent emails, and rubrics."
  product={productMeta}
  breadcrumbs={breadcrumbs}
>
  <main class="wrap" style="padding: 64px 24px 100px;">
    <section class="product-hero">
      <div class="product-info">
        <span class="badge" style="background: #1E293B; color: #fff; padding: 6px 14px; font-weight: 700; border-radius: 6px; font-size: 12px;">PROMPT VAULT</span>
        <h1 class="display" style="font-size: 40px; margin: 16px 0 12px;">ChatGPT & Claude Prompt Vault for Educators</h1>
        <p style="font-size: 18px; color: #1E293B; font-weight: 600; margin-bottom: 16px;">200+ Field-Tested Prompts for Instant Classroom & Admin Automation</p>
        <p style="font-size: 16px; color: var(--ink-600, #555555); line-height: 1.6; margin-bottom: 24px;">
          Stop wasting hours typing vague prompts into ChatGPT. Access our curated prompt stack using the CREO framework to generate differentiated lesson plans, empathetic parent emails, and grading rubrics in seconds.
        </p>

        <div class="price-box">
          <span class="price">$27 <small style="font-size: 14px; color: #777; font-weight: 400;">USD (One-time payment)</small></span>
          <span class="guarantee">✓ PDF & Notion Library Format • Copy & Paste Ready</span>
        </div>

        <div style="margin-top: 24px;">
          <a href="https://gumroad.com" target="_blank" rel="noopener" class="btn btn-primary" style="padding: 16px 32px; font-size: 18px; display: inline-block;">Get Prompt Vault ($27) ➔</a>
        </div>
      </div>

      <div class="product-preview">
        <img src="/images/blog/chatgpt-prompt-vault-for-teachers.jpg" alt="Prompt Vault Preview" class="hero-img" />
      </div>
    </section>

    <section class="features-section">
      <h2 style="font-size: 32px; text-align: center; margin-bottom: 40px;">What Prompt Categories Are Included?</h2>
      <div class="features-grid">
        <div class="feature-card">
          <h3>📝 Differentiated Lesson Planning</h3>
          <p>Prompts for multi-level classroom activities, IEP accommodations, and subject-specific units.</p>
        </div>
        <div class="feature-card">
          <h3>✉️ Parent Communication & Emails</h3>
          <p>Empathetic email generators for sensitive student updates, behavior reports, and newsletters.</p>
        </div>
        <div class="feature-card">
          <h3>🎯 Assessment & Rubric Builders</h3>
          <p>Instant grading criteria, formative quiz questions, and exit ticket generators.</p>
        </div>
        <div class="feature-card">
          <h3>🚀 Educator Side-Hustle Prompts</h3>
          <p>Prompts to turn teaching expertise into Notion templates, Canva kits, and online coaching offers.</p>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .product-hero { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; margin-bottom: 80px; }
  .price-box { background: var(--paper-2, #F3F1EA); padding: 20px; border-radius: 12px; border: 1px solid var(--rule-2, #E4E0D2); }
  .price { font-size: 36px; font-weight: 800; color: var(--ink-900, #1A1A1A); display: block; }
  .guarantee { font-size: 13px; color: var(--sage-deep, #2C4A3E); font-weight: 600; margin-top: 6px; display: block; }
  .hero-img { width: 100%; border-radius: 16px; box-shadow: 0 16px 40px rgba(0,0,0,0.1); border: 1px solid var(--rule-2, #E4E0D2); }
  .features-section { padding-top: 40px; border-top: 1px solid var(--rule-2, #E4E0D2); }
  .features-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 24px; }
  .feature-card { background: var(--paper-1, #FAF8F5); padding: 28px; border-radius: 14px; border: 1px solid var(--rule-2, #E4E0D2); }
  .feature-card h3 { font-size: 20px; margin-bottom: 10px; }
  .feature-card p { font-size: 15px; color: var(--ink-600, #555555); line-height: 1.5; }
  @media (max-width: 768px) { .product-hero { grid-template-columns: 1fr; } }
</style>
