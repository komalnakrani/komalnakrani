---
import Layout from '../layouts/Layout.astro';
import ThemeCard from '../components/ThemeCard.astro';
import Icon from '../components/Icon.astro';
import { themes, CATEGORIES, isThemeInCategory } from '../data/themes';
import { priceRange, priceLabel, PASS_INCLUDES, DROP } from '../data/design';

// The drop leads with featured themes and tops up with the rest, so the grid
// is never short regardless of how many are flagged.
const drop = [
  ...themes.filter((t) => t.featured),
  ...themes.filter((t) => !t.featured)
].slice(0, 6);

const themeCount = themes.length;
const themePrice = priceLabel(priceRange(themes));

const popularCategories = [
  'technology',
  'portfolio-and-agency',
  'retail-and-e-commerce',
  'blog-and-editorial',
  'documentation',
  'education'
];
const categoryCards = CATEGORIES
  .map((cat) => ({ ...cat, count: themes.filter((t) => isThemeInCategory(t, cat.slug)).length }))
  .filter((cat) => cat.count > 0)
  .sort((a, b) => (popularCategories.indexOf(a.slug) + 1 || 99) - (popularCategories.indexOf(b.slug) + 1 || 99))
  .slice(0, 6);

---
<Layout
  title="Komal Nakrani | Themes that look like you hired someone"
  description={`Hand-built, production-ready web themes — SaaS, storefront, portfolio, dashboard and more. Preview every breakpoint before you pay. Individual themes ${themePrice}, all-access pass coming soon at $${DROP.allAccessPrice}.`}
>
  <main id="top">
    <!-- ============================ HERO ============================ -->
    <section class="wrap" style="padding: 84px 24px 56px; text-align: center;">
      <h1 class="display" style="margin: 24px 0 0;">
        Themes that look like<br />you hired someone.
      </h1>

      <p class="lead" style="max-width: 570px; margin: 22px auto 0;">
        Hand-built, production-ready templates — SaaS, storefront, portfolio,
        dashboard and more. Preview every breakpoint before you pay a rupee.
      </p>

      <div class="hero-actions">
        <a href="/pricing/" class="btn btn-primary btn-lg">Get All-Access Pass ($199)</a>
        <a href="#themes" class="btn btn-secondary btn-lg">Browse the themes</a>
      </div>

      <div class="hero-meta">
        <span>{themeCount} themes, {themePrice} each</span>
        <span>Full source included</span>
        <span>Lifetime updates</span>
      </div>
    </section>

    <!-- ========================= THE DROP =========================== -->
    <section id="themes" class="wrap" style="padding: 0 24px 20px;">
      <div class="sec-head">
        <h2 class="h2" style="margin: 0;">The themes</h2>
        <p style="margin: 0; font-size: 14px; color: var(--ink-3);">
          Every one is a full multi-page Astro site, not a landing page.
        </p>
      </div>

      <div class="drop-grid">
        {drop.map((theme) => <ThemeCard theme={theme} />)}
      </div>

      <div style="text-align: center; margin-top: 32px;">
        <a href="/themes/" class="btn btn-secondary">Browse every theme</a>
      </div>
    </section>

    <!-- ======================== CATEGORIES ========================== -->
    <section class="wrap" style="padding: 84px 24px 0;">
      <div class="sec-head">
        <h2 class="h2" style="margin: 0;">Browse by what you're building</h2>
        <a href="/categories/" style="font-size: 14px; color: var(--accent-text);">All categories ➔</a>
      </div>

      <div class="cat-grid">
        {categoryCards.map((cat) => (
          <a href={`/categories/${cat.slug}/`} class="cat-card">
            <h3 class="cat-name">{cat.name}</h3>
            <p class="cat-desc">{cat.description}</p>
            <span class="cat-go">Explore ➔</span>
          </a>
        ))}
      </div>
    </section>

    <!-- ========================== STORY ============================= -->
    <section id="story" class="wrap" style="padding: 84px 24px;">
      <div class="story-card">
        <div>
          <div style="font-size: 12px; letter-spacing: .1em; color: var(--sage);">ABOUT THE STUDIO</div>
          <h2 style="font-size: clamp(26px, 3.4vw, 38px); letter-spacing: -.03em; line-height: 1.2; margin: 14px 0 0;">
            Five years teaching. Two years shipping. One studio.
          </h2>
          <p class="body-t" style="margin: 18px 0 0;">
            Komal taught computer science before she wrote software for a living — which is why
            these themes read like lesson plans: every file named for what it does, every section
            commented, nothing you have to reverse-engineer at 1am.
          </p>
          <p class="body-t" style="margin: 14px 0 0;">
            Every theme is a real Astro project you clone from a private repository — not a zip of
            static HTML. Buy one and the updates keep arriving with a git pull.
          </p>
        </div>
        <div style="display: grid; gap: 12px;">
          <div class="stat-cell">
            <div class="stat-num">{themeCount}</div>
            <div class="stat-lbl">themes, each one a full multi-page site</div>
          </div>
          <div class="stat-cell">
            <div class="stat-num">{themePrice}</div>
            <div class="stat-lbl">per theme, or ${DROP.allAccessPrice} for all of them</div>
          </div>
        </div>
      </div>
    </section>

    <!-- ========================= PRICING ============================ -->
    <section id="pricing" class="wrap" style="padding: 0 24px 100px;">
      <div style="text-align: center; margin-bottom: 34px;">
        <h2 class="h2" style="margin: 0;">One pass. Every theme.</h2>
        <p style="font-size: 16px; color: var(--ink-2); margin: 14px 0 0;">
          Every theme in the catalog, plus every theme released from here on.
        </p>
      </div>

      <div class="offer">
        <div>
          <div class="offer-eyebrow" style="letter-spacing: 0.08em; text-transform: uppercase;">🔥 LAUNCH SPECIAL — FIRST 100 CUSTOMERS ONLY</div>
          <div class="offer-figure" style="display: flex; align-items: baseline; justify-content: center; gap: 12px;">
            <span class="offer-now">${DROP.allAccessPrice} USD</span>
            <span style="font-size: 24px; text-decoration: line-through; opacity: 0.5;">${DROP.regularPrice} USD</span>
          </div>
          <p class="offer-sub">One-time payment · Save $300 USD</p>

          <a href="/pricing/" class="btn btn-lg offer-cta">Get All-Access Pass — ${DROP.allAccessPrice} USD</a>

          <p class="offer-fine">
            Prefer a single theme? Each one is priced on its own page —
            <a href="#themes">see them all</a>.
          </p>
        </div>

        <div class="offer-list">
          <div class="offer-list-head">What the pass includes</div>
          <ul>
            {PASS_INCLUDES.map((item) => (
              <li class="ai-feature-item" style="color: var(--ink-inverse);">
                <Icon name="check" /> {item}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  </main>

</Layout>

<style>

  /* ---------------- Hero ---------------- */
  .drop-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--paper-3);
    border: 1px solid var(--rule-2);
    padding: 6px 16px 6px 7px;
    border-radius: var(--r-pill);
    font-size: 13px;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    margin-top: 32px;
  }
  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 26px;
    justify-content: center;
    margin-top: 36px;
    font-size: 13px;
    color: var(--ink-3);
  }

  /* ---------------- Grids ---------------- */
  .drop-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 290px), 1fr));
    gap: 20px;
  }

  .cat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 20px;
  }
  .cat-card {
    background: #ffffff;
    border: 1px solid var(--rule-3);
    border-radius: var(--r-lg);
    padding: 24px;
    display: flex;
    flex-direction: column;
    transition: border-color var(--dur) var(--ease), transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }
  .cat-card:hover {
    border-color: var(--ink-200);
    transform: translateY(-3px);
    box-shadow: var(--sh);
    opacity: 1;
  }
  .cat-count { font-size: 12px; color: var(--ink-3); letter-spacing: .06em; }
  .cat-name { font-size: 19px; letter-spacing: -.02em; margin: 8px 0 0; }
  .cat-desc {
    font-size: 14px;
    line-height: 1.65;
    color: var(--ink-2);
    margin: 9px 0 18px;
    flex: 1;
    text-wrap: pretty;
  }
  .cat-go { font-size: 13px; color: var(--accent-text); }

  /* ---------------- Story ---------------- */
  .story-card {
    background: #ffffff;
    border: 1px solid var(--rule-3);
    border-radius: var(--r-lg);
    padding: clamp(28px, 5vw, 56px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 40px;
    align-items: center;
  }

  /* ---------------- Pricing (single offer, mirrors /pricing/) ---------------- */
  .offer {
    background: var(--ink-900);
    color: var(--ink-inverse);
    border-radius: var(--r-lg);
    padding: clamp(28px, 5vw, 56px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: clamp(32px, 5vw, 56px);
    align-items: center;
    max-width: 960px;
    margin: 0 auto;
  }
  .offer-eyebrow { font-size: 12px; letter-spacing: .1em; color: var(--sage); }
  .offer-figure { display: flex; align-items: baseline; gap: 14px; margin: 16px 0 4px; }
  .offer-now { font-size: clamp(52px, 9vw, 76px); letter-spacing: -.04em; line-height: 1; }
  .offer-was { font-size: 20px; opacity: .45; text-decoration: line-through; }
  .offer-sub { margin: 0 0 26px; font-size: 15px; color: rgba(243, 241, 234, .7); }

  .offer-cta {
    width: 100%;
    background: var(--ink-inverse);
    color: var(--ink-900);
    border: 0;
  }
  .offer-cta:hover { opacity: .88; }

  .offer-fine {
    margin: 16px 0 0;
    font-size: 13px;
    line-height: 1.65;
    color: rgba(243, 241, 234, .55);
  }
  .offer-fine a { color: var(--sage); text-decoration: underline; text-underline-offset: 3px; }

  .offer-list-head {
    font-size: 12px;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: rgba(243, 241, 234, .5);
    padding-bottom: 14px;
    margin-bottom: 16px;
    border-bottom: 1px solid rgba(243, 241, 234, .14);
  }
  .offer-list ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* ---------------- Ticker ---------------- */

  @media (max-width: 640px) {
  }
</style>
