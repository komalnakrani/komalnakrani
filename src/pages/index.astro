---
import Layout from '../layouts/Layout.astro';
import K from '../components/K.astro';
import Icon from '../components/Icon.astro';
import ThemeCard from '../components/ThemeCard.astro';
import { themes } from '../data/themes';

const nextThemes = themes.filter((t) => t.framework === 'nextjs');

const techPills = [
  'Next.js 16 App Router', 'TypeScript', 'Tailwind CSS', 'React 19', 
  'Framer Motion', 'Pinecone Vector DB', 'LangChain', 'CrewAI Framework',
  'OpenAI GPT-4o', 'Claude 3.5 Sonnet', 'Pagefind Search'
];

const faqs = [
  {
    q: 'What makes Komal Nakrani themes faster than traditional market templates?',
    a: 'Every Next.js 16 theme utilizes Server Components, React 19, and Framer Motion micro-interactions for sub-second page loads and 100/100 Core Web Vitals performance.'
  },
  {
    q: 'What is included with each $29 Theme?',
    a: 'Each Next.js theme includes complete production-ready source code, modular App Router page layouts, mobile-first responsive styling, and complete commercial usage licensing.'
  },
  {
    q: 'How does the $199 Lifetime All-Access Pass work?',
    a: 'The $199 All-Access Pass provides lifetime commercial source code access to all Next.js themes and turnkey AI Solution Kits with free updates forever and zero recurring subscriptions.'
  },
  {
    q: 'Can I use these themes for commercial client projects?',
    a: 'Yes. Both individual theme purchases ($29) and the $199 Lifetime All-Access Pass include full commercial licensing for unlimited personal and client projects.'
  }
];
---
<Layout title="Komal Nakrani | Production Next.js 16 Themes" description="Production-grade Next.js 16 App Router templates engineered for high-performance web applications.">
  <main class="rise">
    <!-- Hero Section -->
    <section class="wrap hero">
      <div class="hero-grid">
        <div>
          <div class="hero-badge">
            <span class="dot"></span>
            Next.js 16 App Router Engine + Production Architecture
          </div>
          <h1 class="display">
            Production-Grade Web Themes.<br />
            <span class="grad">Engineered for Performance.</span>
          </h1>
          <p class="lead">
            Engineered for high-performing tech startups, agencies, and AI developers. Pre-configured with 100/100 Core Web Vitals performance, type-safe APIs, and ready-to-deploy Next.js 16 App Router workflows.
          </p>
          <div class="hero-cta">
            <a class="btn btn-primary btn-lg" href="/themes/">
              Explore Themes <Icon name="arrow-right" />
            </a>
            <a class="btn btn-secondary btn-lg" href="/bundles/">
              Get All-Access Pass ($199)
            </a>
          </div>
        </div>

        <div class="hero-card">
          <div style="font-size: 11px; font-family: var(--mono); color: var(--accent); margin-bottom: 8px;">COMPETENCE ENGINE</div>
          <h3 style="font-size: 18px; margin-bottom: 12px;">Turnkey Next.js Architectures</h3>
          <p style="font-size: 13.5px; color: var(--fg-muted); line-height: 1.6; margin-bottom: 20px;">
            Complete Next.js 16 App Router source code for SaaS, AI Apps, Editorial Studios, 3D Shaders, and Developer Docs.
          </p>
          <div style="display: flex; flex-direction: column; gap: 10px;">
            <div style="display: flex; align-items: center; justify-content: space-between; padding: 10px 14px; background: rgba(255,255,255,0.03); border: 1px solid var(--bd-subtle); border-radius: var(--r-sm); font-size: 13px;">
              <span>Next.js 16 App Router</span>
              <span style="color: #22c55e; font-weight: 600;">100/100 Vitals</span>
            </div>
            <div style="display: flex; align-items: center; justify-content: space-between; padding: 10px 14px; background: rgba(255,255,255,0.03); border: 1px solid var(--bd-subtle); border-radius: var(--r-sm); font-size: 13px;">
              <span>TypeScript + Tailwind CSS</span>
              <span style="color: var(--accent); font-weight: 600;">Production</span>
            </div>
            <div style="display: flex; align-items: center; justify-content: space-between; padding: 10px 14px; background: rgba(255,255,255,0.03); border: 1px solid var(--bd-subtle); border-radius: var(--r-sm); font-size: 13px;">
              <span>Framer Motion Micro-Interactions</span>
              <span style="color: #60a5fa; font-weight: 600;">Included</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Tech Stack Ribbon -->
    <div style="border-y: 1px solid var(--bd-subtle); background: rgba(255,255,255,0.015); padding: 14px 0; overflow: hidden;">
      <div class="wrap" style="display: flex; align-items: center; gap: 24px; flex-wrap: wrap; justify-content: center; font-family: var(--mono); font-size: 12px; color: var(--fg-muted);">
        <span style="color: var(--accent); font-weight: 700;">STACK:</span>
        {techPills.map((pill) => (
          <span style="opacity: 0.85;">• {pill}</span>
        ))}
      </div>
    </div>

    <!-- Featured Next.js Themes Showcase -->
    <section class="wrap section">
      <div style="display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 32px; flex-wrap: wrap; gap: 16px;">
        <div>
          <K idx="02">Featured Catalog</K>
          <h2 style="font-size: 28px; margin-top: 8px;">Next.js 16 Production Themes</h2>
        </div>
        <a class="btn btn-secondary" href="/themes/">View All Themes ({nextThemes.length}) →</a>
      </div>
      <div class="grid grid-3">
        {nextThemes.slice(0, 9).map((theme) => (
          <ThemeCard theme={theme} />
        ))}
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="wrap section" style="border-t: 1px solid var(--bd-subtle);">
      <div style="text-align: center; max-width: 600px; margin: 0 auto 48px;">
        <K idx="03">Frequently Asked Questions</K>
        <h2 style="font-size: 28px; margin-top: 8px;">Everything You Need to Know</h2>
      </div>
      <div style="max-width: 800px; margin: 0 auto; display: flex; flex-direction: column; gap: 16px;">
        {faqs.map((faq) => (
          <details style="background: rgba(255,255,255,0.02); border: 1px solid var(--bd-subtle); border-radius: var(--r-md); padding: 18px 24px;">
            <summary style="font-weight: 600; font-size: 16px; cursor: pointer; color: #fff;">{faq.q}</summary>
            <p style="margin-top: 12px; color: var(--fg-muted); font-size: 14.5px; line-height: 1.6;">{faq.a}</p>
          </details>
        ))}
      </div>
    </section>
  </main>
</Layout>
