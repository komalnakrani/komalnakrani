---
import Layout from '../layouts/Layout.astro';
import K from '../components/K.astro';
import Icon from '../components/Icon.astro';
import ThemeCard from '../components/ThemeCard.astro';
import { themes } from '../data/themes';

const nextThemes = themes.filter((t) => t.framework === 'nextjs');

const techPills = [
  'Next.js 16 App Router', 'TypeScript', 'Tailwind CSS', 'React 19', 
  'Framer Motion', 'Server Components', 'Clean Minimal Design', '100/100 Vitals'
];

const faqs = [
  {
    q: 'What makes Komal Nakrani themes faster than traditional market templates?',
    a: 'Every Next.js 16 theme utilizes React Server Components, React 19, and Framer Motion micro-interactions for sub-second page loads and 100/100 Core Web Vitals performance.'
  },
  {
    q: 'What is included with each $29 Theme?',
    a: 'Each Next.js theme includes complete production-ready source code, modular App Router page layouts, mobile-first responsive styling, and complete commercial usage licensing.'
  },
  {
    q: 'How does the $199 Lifetime All-Access Pass work?',
    a: 'The $199 All-Access Pass provides lifetime commercial source code access to all Next.js themes with free updates forever and zero recurring subscriptions.'
  },
  {
    q: 'Can I use these themes for commercial client projects?',
    a: 'Yes. Both individual theme purchases ($29) and the $199 Lifetime All-Access Pass include full commercial licensing for unlimited personal and client projects.'
  }
];
---
<Layout title="Komal Nakrani | Premium Next.js 16 Themes & Templates" description="Explore production-grade Next.js 16 App Router web themes engineered for high-performance SaaS, creative agencies, and developers. Buy individual themes for $29 or $199 Lifetime All-Access.">
  <main class="rise" style="background: #090d16; color: #ffffff;">
    <!-- Hero Section -->
    <section class="wrap hero" style="padding-top: 60px; padding-bottom: 60px;">
      <div class="hero-grid" style="display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 40px; align-items: center;">
        <div>
          <div class="hero-badge" style="background: rgba(255, 103, 17, 0.15); color: #ff6711; border: 1px solid rgba(255, 103, 17, 0.3); padding: 6px 14px; border-radius: 9999px; font-family: var(--mono); font-size: 12px; display: inline-flex; align-items: center; gap: 8px; margin-bottom: 20px;">
            <span class="dot" style="width: 8px; height: 8px; border-radius: 50%; background: #ff6711;"></span>
            Next.js 16 App Router Engine + Production Architecture
          </div>
          <h1 class="display" style="font-size: 52px; line-height: 1.1; margin-bottom: 20px;">
            Production-Grade <br />
            <span class="grad" style="color: #ff6711;">Next.js Themes.</span>
          </h1>
          <p class="lead" style="font-size: 18px; color: #94a3b8; line-height: 1.6; margin-bottom: 32px; max-width: 580px;">
            Engineered for high-performing tech startups, agencies, and developers. Built with React 19, TypeScript, Tailwind CSS, and Framer Motion for 100/100 Core Web Vitals performance.
          </p>
          <div class="hero-cta" style="display: flex; gap: 14px; flex-wrap: wrap;">
            <a class="btn btn-primary btn-lg" href="/themes/" style="background: #ff6711; color: #ffffff; padding: 14px 28px; border-radius: 10px; font-weight: 700; text-decoration: none; box-shadow: 0 4px 18px rgba(255, 103, 17, 0.4);">
              Explore Next.js Themes <Icon name="arrow-right" />
            </a>
            <a class="btn btn-secondary btn-lg" href="/bundles/" style="background: rgba(255,255,255,0.06); color: #ffffff; border: 1px solid rgba(255,255,255,0.15); padding: 14px 28px; border-radius: 10px; font-weight: 600; text-decoration: none;">
              Get All-Access Pass ($199)
            </a>
          </div>
        </div>

        <div class="hero-card" style="background: #0f172a; border: 1px solid rgba(255,255,255,0.12); padding: 28px; border-radius: 20px; box-shadow: 0 12px 36px rgba(0,0,0,0.3);">
          <div style="font-size: 11px; font-family: var(--mono); color: #ff6711; font-weight: 700; margin-bottom: 8px; letter-spacing: 0.08em; text-transform: uppercase;">NEXT.JS MARKETPLACE</div>
          <h3 style="font-size: 22px; margin-bottom: 12px; color: #ffffff;">Turnkey Next.js Themes</h3>
          <p style="font-size: 14px; color: #94a3b8; line-height: 1.6; margin-bottom: 24px;">
            Complete Next.js 16 App Router source code for SaaS, Creative Agencies, 3D Shaders, and Developer Documentation.
          </p>
          <div style="display: flex; flex-direction: column; gap: 12px;">
            <div style="display: flex; align-items: center; justify-content: space-between; padding: 12px 16px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 8px; font-size: 13.5px;">
              <span style="color: #ffffff;">Next.js 16 App Router</span>
              <span style="color: #10b981; font-weight: 600;">100/100 Vitals</span>
            </div>
            <div style="display: flex; align-items: center; justify-content: space-between; padding: 12px 16px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 8px; font-size: 13.5px;">
              <span style="color: #ffffff;">TypeScript + Tailwind CSS</span>
              <span style="color: #ff6711; font-weight: 600;">Production</span>
            </div>
            <div style="display: flex; align-items: center; justify-content: space-between; padding: 12px 16px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 8px; font-size: 13.5px;">
              <span style="color: #ffffff;">Framer Motion Micro-Interactions</span>
              <span style="color: #38bdf8; font-weight: 600;">Included</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Tech Stack Ribbon -->
    <div style="border-top: 1px solid rgba(255,255,255,0.08); border-bottom: 1px solid rgba(255,255,255,0.08); background: rgba(255,255,255,0.02); padding: 16px 0;">
      <div class="wrap" style="display: flex; align-items: center; gap: 24px; flex-wrap: wrap; justify-content: center; font-family: var(--mono); font-size: 12.5px; color: #94a3b8;">
        <span style="color: #ff6711; font-weight: 700;">TECH STACK:</span>
        {techPills.map((pill) => (
          <span style="opacity: 0.9;">• {pill}</span>
        ))}
      </div>
    </div>

    <!-- Featured Next.js Themes Showcase -->
    <section class="wrap section" style="padding-top: 80px; padding-bottom: 80px;">
      <div style="display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 40px; flex-wrap: wrap; gap: 16px;">
        <div>
          <K idx="01">Featured Next.js Catalog</K>
          <h2 class="h2" style="margin-top: 8px; font-size: 36px; color: #ffffff;">High-Performance Web Themes</h2>
        </div>
        <a href="/themes/" class="btn btn-secondary" style="background: rgba(255,255,255,0.06); color: #ffffff; border: 1px solid rgba(255,255,255,0.15); padding: 10px 20px; border-radius: 8px; text-decoration: none;">
          View All Next.js Themes ({nextThemes.length}) →
        </a>
      </div>

      <div class="themes-catalog-grid">
        {nextThemes.slice(0, 6).map((theme) => (
          <ThemeCard theme={theme} />
        ))}
      </div>
    </section>

    <!-- All-Access Pass Banner -->
    <section class="wrap section" style="padding-bottom: 80px;">
      <div style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); border: 1px solid #ff6711; border-radius: 24px; padding: 48px; text-align: center; box-shadow: 0 20px 50px rgba(255, 103, 17, 0.15);">
        <span style="background: #ff6711; color: #ffffff; padding: 4px 12px; border-radius: 9999px; font-family: var(--mono); font-size: 11px; font-weight: 700; text-transform: uppercase;">LIFETIME ALL-ACCESS</span>
        <h2 style="font-size: 38px; color: #ffffff; margin: 16px 0;">Unlock All Next.js Themes for $199</h2>
        <p style="font-size: 16px; color: #94a3b8; max-width: 600px; margin: 0 auto 32px; line-height: 1.6;">
          Get unlimited commercial access to every Next.js 16 theme with free updates forever and zero recurring subscriptions.
        </p>
        <a href="/bundles/" class="btn btn-primary btn-lg" style="background: #ff6711; color: #ffffff; padding: 16px 36px; border-radius: 12px; font-size: 16px; font-weight: 700; text-decoration: none; box-shadow: 0 6px 24px rgba(255, 103, 17, 0.4);">
          Get Lifetime All-Access ($199) →
        </a>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="wrap section" style="padding-bottom: 100px;">
      <div style="text-align: center; max-width: 640px; margin: 0 auto 48px;">
        <K idx="02">Frequently Asked Questions</K>
        <h2 style="font-size: 36px; color: #ffffff; margin-top: 8px;">Everything You Need to Know</h2>
      </div>

      <div style="max-width: 800px; margin: 0 auto; display: flex; flex-direction: column; gap: 20px;">
        {faqs.map((faq) => (
          <div style="background: #0f172a; border: 1px solid rgba(255,255,255,0.1); border-radius: 14px; padding: 24px;">
            <h3 style="font-size: 18px; color: #ffffff; margin: 0 0 10px;">{faq.q}</h3>
            <p style="font-size: 14.5px; color: #94a3b8; line-height: 1.6; margin: 0;">{faq.a}</p>
          </div>
        ))}
      </div>
    </section>
  </main>
</Layout>

<style>
  .themes-catalog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 32px;
    max-width: 1200px;
    margin: 0 auto;
  }
  @media (max-width: 768px) {
    .hero-grid {
      grid-template-columns: 1fr !important;
    }
    .display {
      font-size: 38px !important;
    }
    .themes-catalog-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
