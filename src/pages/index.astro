---
import Layout from '../layouts/Layout.astro';
import ThemeCard from '../components/ThemeCard.astro';
import Icon from '../components/Icon.astro';
import { themes, CATEGORIES, isThemeInCategory } from '../data/themes';
import { nameFor, scarcityFor, priceRange, priceLabel, PASS_INCLUDES, DROP, TICKS } from '../data/design';

// The drop leads with featured themes and tops up with the rest, so the grid
// is never short regardless of how many are flagged.
const drop = [
  ...themes.filter((t) => t.featured),
  ...themes.filter((t) => !t.featured)
].slice(0, 6);

// Drives the hero badge and the licences-claimed / seats-left figures.
const dropStats = drop.map((t) => ({ name: nameFor(t), ...scarcityFor(t) }));
const soldTotal = themes.reduce((n, t) => n + scarcityFor(t).sold, 0);
const seatsLeft = dropStats.length
  ? DROP.licenseCap - Math.round(dropStats.reduce((n, t) => n + t.sold, 0) / dropStats.length)
  : DROP.licenseCap;
const allAccessWas = DROP.allAccessWas;
const themePrice = priceLabel(priceRange(themes));

const popularCategories = [
  'technology',
  'portfolio-and-agency',
  'retail-and-e-commerce',
  'blog-and-editorial',
  'documentation',
  'education'
];
const categoryCards = CATEGORIES
  .map((cat) => ({ ...cat, count: themes.filter((t) => isThemeInCategory(t, cat.slug)).length }))
  .filter((cat) => cat.count > 0)
  .sort((a, b) => (popularCategories.indexOf(a.slug) + 1 || 99) - (popularCategories.indexOf(b.slug) + 1 || 99))
  .slice(0, 6);

---
<Layout
  title="Komal Nakrani | Themes that look like you hired someone"
  description={`Hand-built, production-ready web themes — SaaS, storefront, portfolio, dashboard and more. Preview every breakpoint before you pay. Individual themes ${themePrice}, all-access $${DROP.allAccessPrice}.`}
>
  <main id="top">
    <!-- ============================ HERO ============================ -->
    <section class="wrap" style="padding: 84px 24px 56px; text-align: center;">
      <div class="drop-badge">
        <span class="pill-new">NEW</span>
        {dropStats[0]?.name} shipped this morning
      </div>

      <h1 class="display" style="margin: 24px 0 0;">
        Themes that look like<br />you hired someone.
      </h1>

      <p class="lead" style="max-width: 570px; margin: 22px auto 0;">
        Hand-built, production-ready templates — SaaS, storefront, portfolio,
        dashboard and more. Preview every breakpoint before you pay a rupee.
      </p>

      <div class="hero-actions">
        <a href="/pricing/" class="btn btn-primary btn-lg">Claim founding price</a>
        <a href="#themes" class="btn btn-secondary btn-lg">Browse the drop</a>
      </div>

      <div class="hero-meta">
        <span>{DROP.waitlist.toLocaleString()} builders on the waitlist</span>
        <span>Full source included</span>
        <span>Lifetime updates</span>
      </div>
    </section>

    <!-- ========================= THE DROP =========================== -->
    <section id="themes" class="wrap" style="padding: 0 24px 20px;">
      <div class="sec-head">
        <h2 class="h2" style="margin: 0;">The September drop</h2>
        <p style="margin: 0; font-size: 14px; color: var(--ink-3);">
          New theme every Friday. Price rises as licenses sell.
        </p>
      </div>

      <div class="drop-grid">
        {drop.map((theme) => <ThemeCard theme={theme} />)}
      </div>

      <div style="text-align: center; margin-top: 32px;">
        <a href="/themes/" class="btn btn-secondary">Browse every theme</a>
      </div>
    </section>

    <!-- ======================== CATEGORIES ========================== -->
    <section class="wrap" style="padding: 84px 24px 0;">
      <div class="sec-head">
        <h2 class="h2" style="margin: 0;">Browse by what you're building</h2>
        <a href="/categories/" style="font-size: 14px; color: var(--accent-text);">All categories ➔</a>
      </div>

      <div class="cat-grid">
        {categoryCards.map((cat) => (
          <a href={`/categories/${cat.slug}/`} class="cat-card">
            <h3 class="cat-name">{cat.name}</h3>
            <p class="cat-desc">{cat.description}</p>
            <span class="cat-go">Explore ➔</span>
          </a>
        ))}
      </div>
    </section>

    <!-- ========================== STORY ============================= -->
    <section id="story" class="wrap" style="padding: 84px 24px;">
      <div class="story-card">
        <div>
          <div style="font-size: 12px; letter-spacing: .1em; color: var(--sage);">FIRST DROP, EVER</div>
          <h2 style="font-size: clamp(26px, 3.4vw, 38px); letter-spacing: -.03em; line-height: 1.2; margin: 14px 0 0;">
            Five years teaching. Two years shipping. One studio.
          </h2>
          <p class="body-t" style="margin: 18px 0 0;">
            Komal taught computer science before she wrote software for a living — which is why
            these themes read like lesson plans: every file named for what it does, every section
            commented, nothing you have to reverse-engineer at 1am.
          </p>
          <p class="body-t" style="margin: 14px 0 0;">
            This is her first release to the market. Founding prices stay founding prices — for the
            first {DROP.licenseCap} licenses only.
          </p>
        </div>
        <div style="display: grid; gap: 12px;">
          <div class="stat-cell">
            <div class="stat-num">{soldTotal.toLocaleString()}</div>
            <div class="stat-lbl">licenses claimed in 11 days</div>
          </div>
          <div class="stat-cell">
            <div class="stat-num">{DROP.waitlist.toLocaleString()}</div>
            <div class="stat-lbl">on the waitlist for the next drop</div>
          </div>
        </div>
      </div>
    </section>

    <!-- ========================= PRICING ============================ -->
    <section id="pricing" class="wrap" style="padding: 0 24px 100px;">
      <div style="text-align: center; margin-bottom: 34px;">
        <h2 class="h2" style="margin: 0;">One pass. Every theme.</h2>
        <p style="font-size: 16px; color: var(--ink-2); margin: 14px 0 0;">
          Founding price holds for {seatsLeft} more passes, then it goes to ${allAccessWas}.
        </p>
      </div>

      <div class="offer">
        <div>
          <div class="offer-eyebrow">ALL-ACCESS PASS</div>
          <div class="offer-figure">
            <span class="offer-now">${DROP.allAccessPrice}</span>
            <span class="offer-was">${allAccessWas}</span>
          </div>
          <p class="offer-sub">One payment · not a subscription</p>

          <a href="/pricing/" class="btn btn-lg offer-cta">Get all-access — ${DROP.allAccessPrice}</a>

          <p class="offer-fine">
            Only {seatsLeft} founding passes left. Prefer a single theme? Each one is priced on
            its own page — <a href="#themes">see the drop</a>.
          </p>
        </div>

        <div class="offer-list">
          <div class="offer-list-head">What the pass includes</div>
          <ul>
            {PASS_INCLUDES.map((item) => (
              <li class="ai-feature-item" style="color: var(--ink-inverse);">
                <Icon name="check" /> {item}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  </main>

  <!-- ========================== TICKER ============================= -->
  <div class="ticker" data-ticker hidden>
    <div class="ticker-dot"></div>
    <div>
      <div style="font-size: 13px;" data-ticker-main></div>
      <div style="font-size: 12px; color: var(--ink-3); margin-top: 2px;" data-ticker-sub></div>
    </div>
    <button type="button" class="ticker-close" data-ticker-close aria-label="Dismiss notifications">×</button>
  </div>

  <script define:vars={{ TICKS }}>
    /* ---------------- Social proof ticker ---------------- */
    const ticker = document.querySelector('[data-ticker]');
    const tickerMain = document.querySelector('[data-ticker-main]');
    const tickerSub = document.querySelector('[data-ticker-sub]');
    const tickerClose = document.querySelector('[data-ticker-close]');
    if (ticker && tickerMain && tickerSub) {
      let tick = 0;
      const paint = () => {
        const entry = TICKS[tick % TICKS.length];
        tickerMain.textContent = `${entry[0]} ${entry[1]}`;
        tickerSub.textContent = `${2 + (tick % 7)} minutes ago`;
        ticker.hidden = false;
        ticker.style.animation = 'none';
        void ticker.offsetWidth;
        ticker.style.animation = 'komalUp .5s ease both';
      };
      const timer = setInterval(() => {
        tick += 1;
        paint();
      }, 5200);
      setTimeout(paint, 1800);
      tickerClose?.addEventListener('click', () => {
        clearInterval(timer);
        ticker.remove();
      });
    }
  </script>
</Layout>

<style>

  /* ---------------- Hero ---------------- */
  .drop-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--paper-3);
    border: 1px solid var(--rule-2);
    padding: 6px 16px 6px 7px;
    border-radius: var(--r-pill);
    font-size: 13px;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    margin-top: 32px;
  }
  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 26px;
    justify-content: center;
    margin-top: 36px;
    font-size: 13px;
    color: var(--ink-3);
  }

  /* ---------------- Grids ---------------- */
  .drop-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 290px), 1fr));
    gap: 20px;
  }

  .cat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 20px;
  }
  .cat-card {
    background: #ffffff;
    border: 1px solid var(--rule-3);
    border-radius: var(--r-lg);
    padding: 24px;
    display: flex;
    flex-direction: column;
    transition: border-color var(--dur) var(--ease), transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }
  .cat-card:hover {
    border-color: var(--ink-200);
    transform: translateY(-3px);
    box-shadow: var(--sh);
    opacity: 1;
  }
  .cat-count { font-size: 12px; color: var(--ink-3); letter-spacing: .06em; }
  .cat-name { font-size: 19px; letter-spacing: -.02em; margin: 8px 0 0; }
  .cat-desc {
    font-size: 14px;
    line-height: 1.65;
    color: var(--ink-2);
    margin: 9px 0 18px;
    flex: 1;
    text-wrap: pretty;
  }
  .cat-go { font-size: 13px; color: var(--accent-text); }

  /* ---------------- Story ---------------- */
  .story-card {
    background: #ffffff;
    border: 1px solid var(--rule-3);
    border-radius: var(--r-lg);
    padding: clamp(28px, 5vw, 56px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 40px;
    align-items: center;
  }

  /* ---------------- Pricing (single offer, mirrors /pricing/) ---------------- */
  .offer {
    background: var(--ink-900);
    color: var(--ink-inverse);
    border-radius: var(--r-lg);
    padding: clamp(28px, 5vw, 56px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: clamp(32px, 5vw, 56px);
    align-items: center;
    max-width: 960px;
    margin: 0 auto;
  }
  .offer-eyebrow { font-size: 12px; letter-spacing: .1em; color: var(--sage); }
  .offer-figure { display: flex; align-items: baseline; gap: 14px; margin: 16px 0 4px; }
  .offer-now { font-size: clamp(52px, 9vw, 76px); letter-spacing: -.04em; line-height: 1; }
  .offer-was { font-size: 20px; opacity: .45; text-decoration: line-through; }
  .offer-sub { margin: 0 0 26px; font-size: 15px; color: rgba(243, 241, 234, .7); }

  .offer-cta {
    width: 100%;
    background: var(--ink-inverse);
    color: var(--ink-900);
    border: 0;
  }
  .offer-cta:hover { opacity: .88; }

  .offer-fine {
    margin: 16px 0 0;
    font-size: 13px;
    line-height: 1.65;
    color: rgba(243, 241, 234, .55);
  }
  .offer-fine a { color: var(--sage); text-decoration: underline; text-underline-offset: 3px; }

  .offer-list-head {
    font-size: 12px;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: rgba(243, 241, 234, .5);
    padding-bottom: 14px;
    margin-bottom: 16px;
    border-bottom: 1px solid rgba(243, 241, 234, .14);
  }
  .offer-list ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* ---------------- Ticker ---------------- */
  .ticker[hidden] { display: none; }
  .ticker {
    position: fixed;
    left: 20px;
    bottom: 20px;
    z-index: 50;
    display: flex;
    gap: 12px;
    align-items: center;
    background: rgba(255, 255, 255, .94);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid var(--rule-3);
    border-radius: var(--r-pill);
    padding: 11px 14px 11px 14px;
    box-shadow: var(--sh);
    max-width: calc(100vw - 40px);
  }
  .ticker-dot {
    width: 8px;
    height: 8px;
    border-radius: var(--r-pill);
    background: var(--sage-deep);
    flex-shrink: 0;
  }
  .ticker-close {
    background: transparent;
    border: 0;
    color: var(--ink-4);
    font-size: 18px;
    line-height: 1;
    padding: 0 4px;
    cursor: pointer;
  }
  .ticker-close:hover { color: var(--ink); }

  @media (max-width: 640px) {
    .ticker { left: 12px; right: 12px; bottom: 12px; max-width: none; }
  }
</style>
