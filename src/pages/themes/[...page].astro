---
import Layout from '../../layouts/Layout.astro';
import K from '../../components/K.astro';
import ThemeCard from '../../components/ThemeCard.astro';
import CategorySidebar from '../../components/CategorySidebar.astro';
import Pagination from '../../components/Pagination.astro';
import { themes, type Theme } from '../../data/themes';

export async function getStaticPaths({ paginate }: { paginate: any }) {
  // Sort themes: featured first, then standard catalog order
  const sortedThemes = [
    ...themes.filter((t) => t.featured),
    ...themes.filter((t) => !t.featured)
  ];
  return paginate(sortedThemes, { pageSize: 100 });
}

interface Props {
  page: {
    data: Theme[];
    start: number;
    end: number;
    total: number;
    currentPage: number;
    size: number;
    lastPage: number;
    url: {
      current: string;
      prev: string | undefined;
      next: string | undefined;
    };
  };
}

const { page } = Astro.props;
const catalogThemes = page.data;
---
<Layout
  title={`Production Themes — Page ${page.currentPage} | Komal Nakrani Marketplace`}
  description={`Explore production-grade templates (Page ${page.currentPage} of ${page.lastPage}) categorized across our curated theme categories.`}
>
  <main class="rise" style="background: var(--bg); min-height: 100vh; color: var(--ink);">
    <section class="wrap section" style="padding-top: 40px; padding-bottom: 80px;">
      <div style="text-align: center; max-width: 760px; margin: 0 auto 40px;">
        <K idx="01">Theme Catalog</K>
        <h1 class="display" style="margin-top: 14px;">Production themes</h1>
        <p class="lead" style="margin-top: 14px; color: var(--ink-2); font-size: 17px; line-height: 1.6;">
          Engineered for high-performing tech startups, agencies, and developers. Showing 100 themes per page.
        </p>
      </div>

      <!-- 2-Column Marketplace Layout -->
      <div class="cat-marketplace-layout">
        <!-- Sticky Sidebar with All Categories -->
        <CategorySidebar activeCategory="all" />

        <!-- Main Catalog Area -->
        <div class="cat-main-content">
          <!-- Search Bar -->
          <div style="margin-bottom: 24px;">
            <input
              type="text"
              id="theme-search-input"
              placeholder="Search themes by name, category, or tech stack on this page..."
              class="search-input"
            />
          </div>

          <!-- Themes Grid -->
          <div class="themes-catalog-grid" id="themes-grid">
            {catalogThemes.map((theme) => {
              const catsList = theme.categories && theme.categories.length > 0 ? theme.categories.join(' ') : theme.category;
              return (
                <div
                  class="theme-card-wrapper"
                  data-category={catsList}
                  data-framework={theme.framework}
                  data-name={theme.name.toLowerCase()}
                  data-tech={theme.techStack.join(' ').toLowerCase()}
                >
                  <ThemeCard theme={theme} />
                </div>
              );
            })}
          </div>

          <div id="no-results" style="display: none; text-align: center; padding: 60px 20px; background: #ffffff; border-radius: var(--r-lg); border: 1px solid var(--rule-3); margin-top: 24px;">
            <p style="font-size: 18px; color: var(--ink-2);">No themes found matching your search criteria on this page.</p>
            <button id="reset-filters-btn" class="btn btn-secondary" style="margin-top: 16px; padding: 10px 24px;">Reset Search</button>
          </div>

          <!-- 100 Items Per Page Pagination Component -->
          <Pagination page={page} baseUrl="/themes" />
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .cat-marketplace-layout {
    display: flex;
    gap: 32px;
    align-items: flex-start;
  }
  .cat-main-content {
    flex: 1;
    min-width: 0;
  }
  .search-input {
    width: 100%;
    padding: 14px 22px;
    border-radius: var(--r-pill);
    background: #ffffff;
    border: 1px solid var(--rule-2);
    color: var(--ink);
    font-family: var(--body);
    font-size: 15px;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .search-input:focus {
    border-color: var(--sage);
    box-shadow: 0 0 0 3px var(--sage-tint);
  }
  .themes-catalog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 290px), 1fr));
    gap: 20px;
  }

  @media (max-width: 960px) {
    .cat-marketplace-layout {
      flex-direction: column;
    }
  }
  @media (max-width: 640px) {
    .themes-catalog-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const searchInput = document.getElementById('theme-search-input') as HTMLInputElement | null;
  const themeCards = document.querySelectorAll<HTMLElement>('.theme-card-wrapper');
  const noResults = document.getElementById('no-results');
  const resetBtn = document.getElementById('reset-filters-btn');

  function filterGrid() {
    const query = searchInput?.value.toLowerCase().trim() || '';
    let visibleCount = 0;

    themeCards.forEach((card) => {
      const cardName = card.getAttribute('data-name') || '';
      const cardTech = card.getAttribute('data-tech') || '';
      const cardCat = card.getAttribute('data-category') || '';

      const matchesSearch = !query || cardName.includes(query) || cardTech.includes(query) || cardCat.includes(query);

      if (matchesSearch) {
        card.style.display = 'block';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    if (noResults) {
      noResults.style.display = visibleCount === 0 ? 'block' : 'none';
    }
  }

  searchInput?.addEventListener('input', filterGrid);

  resetBtn?.addEventListener('click', () => {
    if (searchInput) {
      searchInput.value = '';
      filterGrid();
    }
  });
</script>
