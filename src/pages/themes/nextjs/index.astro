---
import Layout from '../../../layouts/Layout.astro';
import K from '../../../components/K.astro';
import ThemeCard from '../../../components/ThemeCard.astro';
import { themes } from '../../../data/themes';

const nextThemes = themes.filter((t) => t.framework === 'nextjs');
---
<Layout title="100 Next.js 15 App Router Templates | Komal Nakrani" description="Browse 100 production Next.js 15 App Router themes with Server Actions, Stripe, React 19, and pre-wired AI components.">
  <main class="rise">
    <section class="wrap section">
      <div style="max-width: 720px; margin-bottom: 28px;">
        <K idx="01">Next.js 15 Marketplace</K>
        <h1 class="display" style="margin-top: 14px;">
          100 Production <span class="grad">Next.js Themes</span>
        </h1>
        <p class="lead" style="margin-top: 14px;">
          Full-stack Next.js 15 App Router templates equipped with Server Actions, Stripe subscriptions, NextAuth, and pre-wired AI workspaces.
        </p>
      </div>

      <!-- Live Search Bar -->
      <div style="margin-bottom: 28px;">
        <input type="text" id="next-search-input" placeholder="🔍 Search 100 Next.js 15 themes..." class="form-input" style="padding: 14px 18px; font-size: 15px; border-radius: var(--r-pill);" />
      </div>

      <div class="grid-cards" data-next-grid>
        {nextThemes.map((theme) => (
          <div data-name={theme.name.toLowerCase()} data-tech={theme.techStack.join(' ').toLowerCase()} class="theme-card-wrapper">
            <ThemeCard theme={theme} />
          </div>
        ))}
      </div>
    </section>
  </main>
</Layout>

<script>
  const searchInput = document.getElementById('next-search-input') as HTMLInputElement | null;
  const wrappers = document.querySelectorAll<HTMLElement>('[data-next-grid] .theme-card-wrapper');

  if (searchInput) {
    searchInput.addEventListener('input', () => {
      const q = searchInput.value.toLowerCase().trim();
      wrappers.forEach((w) => {
        const name = w.getAttribute('data-name') || '';
        const tech = w.getAttribute('data-tech') || '';
        if (!q || name.includes(q) || tech.includes(q)) {
          w.style.display = 'flex';
          w.style.flexDirection = 'column';
        } else {
          w.style.display = 'none';
        }
      });
    });
  }
</script>
