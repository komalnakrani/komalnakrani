---
import Layout from '../../../layouts/Layout.astro';
import K from '../../../components/K.astro';
import ThemeCard from '../../../components/ThemeCard.astro';
import { themes } from '../../../data/themes';

const astroThemes = themes.filter((t) => t.framework === 'astro');
---
<Layout title="100 Premium Astro 5 Themes & Starters | Komal Nakrani" description="Browse 100 ultra-fast, zero-JS Astro 5 themes for SaaS, Agencies, Portfolios, 3D WebGL Canvas, Docs, and E-Commerce.">
  <main class="rise">
    <section class="wrap section">
      <div style="max-width: 720px; margin-bottom: 28px;">
        <K idx="01">Astro 5 Marketplace</K>
        <h1 class="display" style="margin-top: 14px;">
          100 Premium <span class="grad">Astro Themes</span>
        </h1>
        <p class="lead" style="margin-top: 14px;">
          Ultra-fast, zero-JS-by-default templates built on Astro 5. Achieve 100/100 Lighthouse speed scores with full source code ownership.
        </p>
      </div>

      <!-- Live Search Bar -->
      <div style="margin-bottom: 28px;">
        <input type="text" id="astro-search-input" placeholder="🔍 Search 100 Astro 5 themes..." class="form-input" style="padding: 14px 18px; font-size: 15px; border-radius: var(--r-pill);" />
      </div>

      <div class="grid-cards" data-astro-grid>
        {astroThemes.map((theme) => (
          <div data-name={theme.name.toLowerCase()} data-tech={theme.techStack.join(' ').toLowerCase()} class="theme-card-wrapper">
            <ThemeCard theme={theme} />
          </div>
        ))}
      </div>
    </section>
  </main>
</Layout>

<script>
  const searchInput = document.getElementById('astro-search-input') as HTMLInputElement | null;
  const wrappers = document.querySelectorAll<HTMLElement>('[data-astro-grid] .theme-card-wrapper');

  if (searchInput) {
    searchInput.addEventListener('input', () => {
      const q = searchInput.value.toLowerCase().trim();
      wrappers.forEach((w) => {
        const name = w.getAttribute('data-name') || '';
        const tech = w.getAttribute('data-tech') || '';
        if (!q || name.includes(q) || tech.includes(q)) {
          w.style.display = 'flex';
          w.style.flexDirection = 'column';
        } else {
          w.style.display = 'none';
        }
      });
    });
  }
</script>
