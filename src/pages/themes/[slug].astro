---
import Layout from '../../layouts/Layout.astro';
import K from '../../components/K.astro';
import Icon from '../../components/Icon.astro';
import CheckoutModal from '../../components/CheckoutModal.astro';
import { themes, type Theme } from '../../data/themes';

export function getStaticPaths() {
  return themes.map((theme) => ({
    params: { slug: theme.slug },
    props: { theme },
  }));
}

interface Props {
  theme: Theme;
}

const { theme } = Astro.props;

const pagesList = [
  { name: 'Homepage', desc: 'Hero section, feature grid, testimonials, pricing table, and newsletter CTA' },
  { name: 'About Us', desc: 'Company mission, studio timeline, team grid, and brand values' },
  { name: 'Services & Capabilities', desc: 'Detailed service offerings, feature breakdowns, and process flow' },
  { name: 'Pricing & Plans', desc: 'Interactive monthly/annual pricing comparison table with feature badges' },
  { name: 'MDX Blog Hub & Articles', desc: 'MDX-powered blog index with tag filtering and single post reader' },
  { name: 'Contact & Support', desc: 'Interactive contact form, support channels, and office location cards' },
  { name: 'Legal & Cookie Consent', desc: 'GDPR Privacy Policy, Terms of Service, and Osano CookieConsent banner' },
];
---
<Layout title={`${theme.name} - ${theme.framework === 'astro' ? 'Next.js 16' : 'Next.js 15'} Theme | Komal Nakrani`} description={theme.description}>
  <main class="rise">
    <!-- Theme Detail Hero -->
    <section class="wrap section" style="padding-top: 40px;">
      <!-- Breadcrumb -->
      <div style="font-family: var(--mono); font-size: 12px; color: var(--ink-3); margin-bottom: 20px; display: flex; gap: 8px; align-items: center;">
        <a href="/themes/" style="color: var(--ink-2); text-decoration: none;">Themes</a>
        <span>/</span>
        <a href={`/themes/${theme.framework}/`} style="color: var(--ink-2); text-decoration: none; text-transform: uppercase;">{theme.framework}</a>
        <span>/</span>
        <span style="color: var(--accent); font-weight: 600;">{theme.name}</span>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 340px; gap: 48px; align-items: start;">
        <div>
          <div class="hero-badge" style="margin-bottom: 16px;">
            <span class="dot"></span>
            {theme.badge}
          </div>
          <h1 class="display" style="font-size: clamp(36px, 4.5vw, 56px); margin: 0 0 16px; line-height: 1.1;">
            {theme.name}
          </h1>
          <p class="lead" style="font-size: 19px; color: var(--ink-2); line-height: 1.6; margin-bottom: 24px;">
            {theme.tagline}
          </p>

          <!-- Tech Stack Pills -->
          <div style="display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 32px;">
            {theme.techStack.map((tech) => (
              <span style="font-family: var(--mono); font-size: 11.5px; background: var(--surface-2); color: var(--ink); border: 1px solid var(--line-2); padding: 4px 12px; border-radius: var(--r-pill);">
                {tech}
              </span>
            ))}
          </div>

          <!-- Dual CTAs -->
          <div style="display: flex; gap: 16px; flex-wrap: wrap; align-items: center;">
            <a href={`/preview/${theme.slug}/`} target="_blank" rel="noopener" class="btn btn-primary btn-lg">
              Live Preview <Icon name="arrow-right" />
            </a>
            <button data-plan-price="29" data-plan-name={theme.name} class="btn btn-secondary btn-lg pay-trigger-btn">
              Buy Theme ($29)
            </button>
            <a href="/bundles/" class="btn btn-secondary btn-lg" style="color: var(--accent);">
              Get All-Access ($199)
            </a>
          </div>
        </div>

        <!-- Right Pricing Box Sidebar -->
        <div style="background: var(--surface); border: 1px solid var(--line-2); border-radius: var(--r-lg); padding: 32px; box-shadow: var(--sh-md);">
          <div style="font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent); font-weight: 700; margin-bottom: 6px;">COMMERCIAL LICENSE</div>
          <div style="font-family: var(--display); font-weight: 700; font-size: 40px; color: var(--ink); line-height: 1;">$29 <span style="font-size: 14px; color: var(--ink-3); font-weight: 400;">/ single theme</span></div>
          <p class="small" style="color: var(--ink-3); margin: 8px 0 24px;">One-time payment · Instant source code download</p>

          <ul style="list-style: none; padding: 0; margin: 0 0 24px; display: flex; flex-direction: column; gap: 10px;">
            <li class="ai-feature-item"><Icon name="check" /> Full 100% Source Code Access</li>
            <li class="ai-feature-item"><Icon name="check" /> 7 Multi-Page Layouts Included</li>
            <li class="ai-feature-item"><Icon name="check" /> Pages / Sanity CMS Pre-configured</li>
            <li class="ai-feature-item"><Icon name="check" /> Osano CookieConsent Banner</li>
            <li class="ai-feature-item"><Icon name="check" /> Unlimited Personal & Client License</li>
            <li class="ai-feature-item"><Icon name="check" /> Free Lifetime Updates</li>
          </ul>

          <button data-plan-price="29" data-plan-name={theme.name} class="btn btn-primary btn-lg pay-trigger-btn" style="width: 100%; margin-bottom: 12px;">
            Buy Single License ($29)
          </button>
          <a href="/bundles/" class="btn btn-secondary" style="width: 100%; text-align: center; justify-content: center;">
            Or Unlock All 200 Themes ($199)
          </a>
        </div>
      </div>

      <!-- Main Browser Preview Stage -->
      <div style="margin-top: 48px; background: var(--ark-ink); border-radius: var(--r-lg); overflow: hidden; border: 1px solid rgba(255, 103, 17, 0.3); box-shadow: var(--sh-lg);">
        <div style="padding: 12px 20px; background: rgba(255,255,255,0.04); border-bottom: 1px solid rgba(255,255,255,0.08); display: flex; align-items: center; justify-content: space-between;">
          <div style="display: flex; gap: 6px;">
            <span style="width: 10px; height: 10px; border-radius: 50%; background: #ff5f56;"></span>
            <span style="width: 10px; height: 10px; border-radius: 50%; background: #ffbd2e;"></span>
            <span style="width: 10px; height: 10px; border-radius: 50%; background: #27c93f;"></span>
          </div>
          <div style="font-family: var(--mono); font-size: 12px; color: var(--accent);">komalnakrani.com/preview/{theme.slug}/</div>
          <a href={`/preview/${theme.slug}/`} target="_blank" rel="noopener" style="font-family: var(--mono); font-size: 11px; color: #ffffff; text-decoration: none; background: rgba(255,103,17,0.2); padding: 3px 10px; border-radius: var(--r-xs);">
            Open Full Preview ↗
          </a>
        </div>
        <div style="height: 540px; background: #0d0d0d;">
          <iframe src={`/preview-demos/${theme.slug}/`} style="width: 100%; height: 100%; border: none;"></iframe>
        </div>
      </div>
    </section>

    <!-- Included Multi-Page Breakdown (Komal Bastion Style) -->
    <section class="wrap section" style="border-top: 1px dashed var(--line-2);">
      <div style="text-align: center; max-width: 680px; margin: 0 auto 48px;">
        <K idx="01">Complete Theme Architecture</K>
        <h2 class="h1" style="margin-top: 10px;">Included Multi-Page Layouts</h2>
        <p class="body-t" style="margin-top: 8px;">
          Every theme includes a full suite of pre-built production pages with zero dummy placeholders.
        </p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 24px;">
        {pagesList.map((pg, idx) => (
          <div style="background: var(--surface); border: 1px solid var(--line-2); border-radius: var(--r-lg); padding: 24px;">
            <div style="font-family: var(--mono); font-size: 12px; color: var(--accent); font-weight: 700; margin-bottom: 8px;">0{idx + 1}. PAGE LAYOUT</div>
            <h3 class="h3" style="font-size: 19px; color: var(--ink); margin-bottom: 8px;">{pg.name}</h3>
            <p class="body-t" style="font-size: 14px; color: var(--ink-2); margin: 0; line-height: 1.5;">{pg.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Features & Technical Specifications -->
    <section class="wrap section" style="background: var(--surface-2); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);">
      <div class="wrap">
        <div class="sec-head">
          <div>
            <K idx="02">Engineering Standard</K>
            <h2 class="h1">Technical Specifications</h2>
            <p class="body-t" style="margin-top: 6px;">Built to modern Web standards for maximum speed and SEO optimization.</p>
          </div>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 24px;">
          {theme.features.map((feat) => (
            <div style="background: var(--surface); border: 1px solid var(--line-2); padding: 24px; border-radius: var(--r-lg);">
              <div style="color: var(--accent); margin-bottom: 12px;"><Icon name="check" /></div>
              <h4 style="font-family: var(--display); font-weight: 700; font-size: 17px; color: var(--ink); margin: 0 0 6px;">{feat}</h4>
              <p class="small" style="color: var(--ink-2); margin: 0; line-height: 1.5;">Type-safe, battle-tested implementation for production builds.</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- All-Access Pass Banner -->
    <section class="wrap section">
      <div class="pass-banner">
        <div class="pass-content">
          <div>
            <span class="hero-badge" style="background: rgba(255,103,17,0.15); color: var(--ark-orange-bright); border-color: rgba(255,103,17,0.4);">
              UNLIMITED ACCESS PASS
            </span>
            <h2 class="pass-title">Get {theme.name} + 199 Other Themes</h2>
            <p class="pass-desc">
              Unlock full commercial source code access to all 100 Web sites, all 100 Next.js 15 themes, and all 4 AI Solution Kits for $199 lifetime.
            </p>
          </div>
          <div class="pass-pricing-card">
            <div class="pass-price">$199 <span>/ lifetime</span></div>
            <p class="small" style="color: var(--ark-grey-400); margin: 8px 0 20px;">Single payment · Unlimited commercial use</p>
            <a href="/bundles/" class="btn btn-primary btn-lg" style="width: 100%;">
              Get All-Access Pass ($199) <Icon name="arrow-right" />
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
  
  <CheckoutModal />
</Layout>
