---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import ThemeCard from '../../components/ThemeCard.astro';
import { themes, isThemeInCategory, type Theme } from '../../data/themes';
import { accentFor, kindFor, nameFor, liveUrlFor, liveHostFor, iframeSrcFor, checkoutUrl, DROP, DEVICES } from '../../data/design';

export function getStaticPaths() {
  return themes.map((theme) => ({
    params: { slug: theme.slug },
    props: { theme },
  }));
}

interface Props {
  theme: Theme;
}

const { theme } = Astro.props;

// Everything on this page derives from the theme's brief plus its preview URL.
const accent = accentFor(theme);
const kind = kindFor(theme);
const liveUrl = liveUrlFor(theme);
const iframeSrc = iframeSrcFor(theme);
const liveHost = liveHostFor(theme);
const name = nameFor(theme);
const was = theme.wasPrice;
const buyUrl = checkoutUrl(theme.dodoProductId);

const related = themes
  .filter((t) => t.slug !== theme.slug && isThemeInCategory(t, theme.category))
  .slice(0, 3);

// The real routes this theme ships, from its own record.
const pagesList = theme.pages ?? [];
// liveUrl carries no trailing slash and every path starts with one, so join
// them without letting a double or missing slash through.
const pageUrl = (path: string) => `${liveUrl.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;
---
<Layout title={`${name} — ${kind.toLowerCase()} theme | Komal Nakrani`} description={theme.description} image={`/og/${theme.slug}.jpg`}>
  <main class="rise">
    <!-- ========================== BRIEF ========================== -->
    <section class="wrap" style="padding: 32px 24px 0;">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/themes/">Themes</a>
        <span>/</span>
        <a href={`/categories/${theme.category}/`}>{kind}</a>
        <span>/</span>
        <span class="here">{name}</span>
      </nav>

      <div class="brief">
        <div>
          <div class="drop-badge">
            <span class="pill-new" style={`background: ${accent};`}>{theme.badge || 'THEME'}</span>
            {kind}
          </div>

          <h1 class="display" style="font-size: clamp(34px, 5vw, 56px); margin: 20px 0 0;">{name}</h1>

          <p class="lead" style="margin: 18px 0 0; max-width: 560px;">{theme.tagline}</p>

          <div class="stack-pills">
            {theme.techStack.map((tech) => <span class="stack-pill">{tech}</span>)}
          </div>

          <div class="brief-actions">
            <a href={`/preview/${theme.slug}/`} class="btn btn-primary btn-lg">Open live preview</a>
            {buyUrl ? (
              <a href={buyUrl} class="btn btn-secondary btn-lg">Buy theme (${theme.price})</a>
            ) : (
              <span class="btn btn-secondary btn-lg is-disabled" aria-disabled="true">Checkout opening soon</span>
            )}
          </div>
        </div>

        <!-- Licence card -->
        <aside class="licence">
          <div class="price-eyebrow">COMMERCIAL LICENSE</div>
          <div style="display: flex; align-items: baseline; gap: 10px; margin: 12px 0 4px;">
            <span style="font-size: 40px; letter-spacing: -.03em;">${theme.price}</span>
            {was && <span style="font-size: 15px; color: var(--ink-3); text-decoration: line-through;">${was}</span>}
          </div>
          <p class="small" style="margin: 0 0 20px;">One-time payment · private GitHub repository access</p>

          <ul class="licence-list">
            <li class="ai-feature-item"><Icon name="check" /> Full source code access</li>
            {pagesList.length > 0 && <li class="ai-feature-item"><Icon name="check" /> {pagesList.length} page layouts, all built out</li>}
            <li class="ai-feature-item"><Icon name="check" /> Commented, readable source</li>
            <li class="ai-feature-item"><Icon name="check" /> Unlimited client projects</li>
            <li class="ai-feature-item"><Icon name="check" /> Free lifetime updates</li>
          </ul>

          {buyUrl ? (
            <a href={buyUrl} class="btn btn-primary licence-cta">Buy single license (${theme.price})</a>
          ) : (
            <span class="btn btn-primary licence-cta is-disabled" aria-disabled="true">Checkout opening soon</span>
          )}
          <a href="/pricing/" class="btn btn-secondary licence-cta" style="margin-top: 10px;">
            Or all-access (${DROP.allAccessPrice})
          </a>
        </aside>
      </div>
    </section>

    <!-- ====================== LIVE PREVIEW ======================= -->
    <section class="wrap" style="padding: 48px 24px 0;">
      <div class="panel-warm" style="padding: 16px;">
        <div class="pv-toolbar">
          <div class="pv-address">{liveHost}</div>
          <div style="flex: 1;"></div>
          <div class="pv-tabs" role="tablist" aria-label="Choose a device size">
            {DEVICES.map((d, i) => (
              <button type="button" class={`pv-tab ${i === 0 ? 'on' : ''}`} data-device-tab={d.id} role="tab" aria-selected={i === 0}>
                {d.label}
              </button>
            ))}
          </div>
          <a href={`/preview/${theme.slug}/`} class="pv-full">Full screen ➚</a>
        </div>

        <div style="display: flex; justify-content: center; padding: 6px 0 2px;">
          <div class="pv-frame" data-frame>
            <div class="pv-fallback" data-fallback>
              <img class="pv-poster" src={`/themes/${theme.slug}.webp`} alt="" aria-hidden="true" width="800" height="500" />
              <div class="pv-fallback-note">
                <div class="pv-fallback-dot" style={`background: ${accent};`}></div>
                <span>Loading the live site from <strong>{liveHost}</strong></span>
                <a href={liveUrl} target="_blank" rel="noopener">Open it directly ➚</a>
              </div>
            </div>
            <iframe
              data-live-frame
              src={iframeSrc}
              title={`Live preview of ${name}`}
              loading="lazy"
              referrerpolicy="no-referrer"
              sandbox="allow-scripts allow-same-origin allow-forms allow-popups"
            ></iframe>
          </div>
        </div>

        <div class="pv-caption">
          <span data-frame-label>{DEVICES[0].note}</span>
          <span class="pv-sep"></span>
          <span>{name} — live site</span>
        </div>
      </div>
    </section>

    <!-- ========================= THE BRIEF ======================== -->
    <section class="wrap" style="padding: 84px 24px 0;">
      <div class="brief-body">
        <div>
          <h2 class="h2" style="margin: 0;">What this theme is for</h2>
          <p class="body-t" style="margin: 18px 0 0;">{theme.description}</p>
        </div>
        <div class="spec-list">
          {theme.features.map((feat) => (
            <div class="spec-row">
              <span class="spec-tick" style={`color: ${accent};`}><Icon name="check" size={16} /></span>
              <span>{feat}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ========================= INCLUDED ========================= -->
    {pagesList.length > 0 && (
    <section class="wrap" style="padding: 84px 24px 0;">
      <div class="sec-head">
        <h2 class="h2" style="margin: 0;">Every page, already built</h2>
        <p style="margin: 0; font-size: 14px; color: var(--ink-3);">Every route below is live — open any one of them.</p>
      </div>

      <div class="page-grid">
        {pagesList.map((pg, idx) => (
          <a class="page-card" href={pageUrl(pg.path)} target="_blank" rel="noopener">
            <div class="page-idx" style={`color: ${accent};`}>{String(idx + 1).padStart(2, '0')}</div>
            <h3 style="font-size: 17px; letter-spacing: -.02em; margin: 8px 0 0;">{pg.name}</h3>
            <p class="page-desc">{pg.desc}</p>
            <p class="page-path">{pg.path} ➚</p>
          </a>
        ))}
      </div>
    </section>
    )}

    <!-- ========================== RELATED ========================= -->
    {related.length > 0 && (
      <section class="wrap" style="padding: 84px 24px 0;">
        <div class="sec-head">
          <h2 class="h2" style="margin: 0;">More in {kind.toLowerCase()}</h2>
          <a href={`/categories/${theme.category}/`} style="font-size: 14px; color: var(--accent-text);">See the category ➔</a>
        </div>
        <div class="drop-grid">
          {related.map((t) => <ThemeCard theme={t} />)}
        </div>
      </section>
    )}

    <!-- ======================== ALL-ACCESS ======================== -->
    <section class="wrap" style="padding: 84px 24px 100px;">
      <div class="panel-ink" style="padding: clamp(28px, 5vw, 48px); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 40px; align-items: center;">
        <div>
          <div style="font-size: 12px; letter-spacing: .1em; color: var(--sage);">ALL-ACCESS PASS</div>
          <h2 style="font-size: clamp(26px, 3.4vw, 38px); letter-spacing: -.03em; line-height: 1.2; color: var(--ink-inverse); margin: 14px 0 0;">
            Get {name} and every other theme.
          </h2>
          <p style="font-size: 16px; line-height: 1.7; color: rgba(243,241,234,.75); margin: 16px 0 0; text-wrap: pretty;">
            One pass unlocks every theme in the catalog, every theme released from here on, and
            unlimited client projects.
          </p>
        </div>
        <div style="text-align: center;">
          <div style="font-size: 44px; letter-spacing: -.03em; color: var(--ink-inverse);">
            ${DROP.allAccessPrice}
          </div>
          <p style="font-size: 13px; color: rgba(243,241,234,.55); margin: 8px 0 20px;">Single payment · unlimited commercial use</p>
          <a href="/pricing/" class="btn btn-lg" style="width: 100%; background: var(--ink-inverse); color: var(--ink-900);">
            Get all-access (${DROP.allAccessPrice})
          </a>
        </div>
      </div>
    </section>
  </main>


  <script define:vars={{ DEVICES }}>
    // A cross-origin iframe still fires `load` for an error page, so this only
    // clears the placeholder once the browser reports something arrived.
    const liveFrame = document.querySelector('[data-live-frame]');
    const fallback = document.querySelector('[data-fallback]');
    liveFrame?.addEventListener('load', () => {
      if (fallback) fallback.style.display = 'none';
    });

    const frameBox = document.querySelector('[data-frame]');
    const frameLabel = document.querySelector('[data-frame-label]');
    const deviceTabs = Array.from(document.querySelectorAll('[data-device-tab]'));

    deviceTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const device = DEVICES.find((d) => d.id === tab.dataset.deviceTab) || DEVICES[0];
        deviceTabs.forEach((n) => {
          const on = n === tab;
          n.classList.toggle('on', on);
          n.setAttribute('aria-selected', String(on));
        });
        if (frameBox) {
          frameBox.style.maxWidth = device.w + 'px';
          frameBox.style.borderRadius =
            device.id === 'mobile' ? '32px' : device.id === 'tablet' ? '22px' : '14px';
          frameBox.style.padding = device.id === 'desktop' ? '10px' : '14px';
        }
        if (frameLabel) frameLabel.textContent = device.note;
      });
    });
  </script>
</Layout>

<style>
  .crumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--ink-3);
    margin-bottom: 24px;
    flex-wrap: wrap;
  }
  .crumbs a { color: var(--ink-2); }
  .crumbs a:hover { color: var(--ink); opacity: 1; }
  .crumbs .here { color: var(--accent-text); }

  .brief {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: 48px;
    align-items: start;
  }
  .drop-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--paper-3);
    border: 1px solid var(--rule-2);
    padding: 6px 16px 6px 7px;
    border-radius: var(--r-pill);
    font-size: 12px;
    letter-spacing: .06em;
    color: var(--ink-3);
  }
  .drop-badge .pill-new { color: #fff; letter-spacing: .07em; }

  .stack-pills { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 28px; }
  .stack-pill {
    font-size: 12px;
    background: var(--paper-3);
    color: var(--ink-2);
    border: 1px solid var(--rule);
    padding: 5px 13px;
    border-radius: var(--r-pill);
  }
  .brief-actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 28px; }

  .licence {
    background: #ffffff;
    border: 1px solid var(--rule-3);
    border-radius: var(--r-lg);
    padding: 28px;
    position: sticky;
    top: 96px;
  }
  .price-eyebrow { font-size: 12px; letter-spacing: .1em; color: var(--ink-4); }
  .licence-list {
    list-style: none;
    padding: 0;
    margin: 0 0 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .licence-cta { width: 100%; }
  .is-disabled {
    opacity: .45;
    cursor: not-allowed;
    pointer-events: none;
  }
  .tcard-track {
    height: 4px;
    background: var(--paper-3);
    border-radius: 4px;
    overflow: hidden;
  }
  .small.low { color: var(--clay); }

  /* Preview panel */
  .pv-toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
    margin-bottom: 14px;
  }
  .pv-address {
    background: var(--paper);
    border: 1px solid var(--rule-2);
    border-radius: var(--r-pill);
    padding: 9px 18px;
    font-size: 13px;
    color: var(--ink-3);
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .pv-tabs {
    display: flex;
    gap: 3px;
    background: var(--paper);
    border: 1px solid var(--rule-2);
    border-radius: var(--r-pill);
    padding: 4px;
    overflow-x: auto;
    max-width: 100%;
  }
  .pv-tab {
    border: 0;
    font-family: inherit;
    font-size: 13px;
    padding: 8px 15px;
    border-radius: var(--r-pill);
    cursor: pointer;
    white-space: nowrap;
    background: transparent;
    color: var(--ink-500);
    transition: background var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .pv-tab:hover { color: var(--ink); }
  .pv-tab.on { background: var(--ink-900); color: var(--paper); }
  .pv-full {
    font-size: 13px;
    color: var(--paper);
    background: var(--ink-900);
    padding: 10px 18px;
    border-radius: var(--r-pill);
  }
  .pv-full:hover { opacity: .88; }

  .pv-frame {
    width: 100%;
    max-width: 1000px;
    height: 620px;
    background: #fff;
    padding: 10px;
    border: 1px solid var(--rule-2);
    border-radius: 14px;
    box-shadow: var(--sh-lg);
    transition: max-width .35s var(--ease), border-radius .3s var(--ease), padding .3s var(--ease);
  }
  .pv-frame { position: relative; }
  .pv-frame iframe {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
    border-radius: 10px;
    background: #fff;
  }
  /* Sits behind the iframe: visible while the remote page loads, and left
     showing if the URL never resolves, so a dead preview reads as an
     explanation rather than a blank rectangle. */
  /* The screenshot stands in until the live iframe paints, so the panel is
     never an empty rectangle — and still reads correctly if the site is down. */
  .pv-fallback {
    position: absolute;
    inset: 10px;
    z-index: 0;
    border-radius: 10px;
    overflow: hidden;
    background: var(--paper);
    font-size: 14px;
    color: var(--ink-3);
  }
  .pv-poster {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
  }
  .pv-fallback-note {
    position: absolute;
    left: 50%;
    bottom: 18px;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
    max-width: calc(100% - 24px);
    overflow: hidden;
    background: rgba(251, 250, 246, .94);
    backdrop-filter: blur(10px);
    border: 1px solid var(--rule-2);
    border-radius: var(--r-pill);
    padding: 9px 18px;
    font-size: 13px;
  }
  .pv-fallback-note strong { color: var(--ink-2); font-weight: 400; }
  .pv-fallback strong { color: var(--ink-2); font-weight: 400; }
  .pv-fallback a { color: var(--accent-text); }
  .pv-fallback-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    animation: pulse 2.4s infinite;
  }
  .pv-caption {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 18px;
    align-items: center;
    justify-content: center;
    margin-top: 14px;
    font-size: 13px;
    color: var(--ink-3);
  }
  .pv-sep { width: 1px; height: 12px; background: var(--rule-2); }

  /* Brief body */
  .brief-body {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 40px;
    align-items: start;
  }
  .spec-list { display: flex; flex-direction: column; gap: 12px; }
  .spec-row {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-2);
    background: #ffffff;
    border: 1px solid var(--rule-3);
    border-radius: var(--r);
    padding: 14px 18px;
  }
  .spec-tick { display: flex; flex-shrink: 0; margin-top: 2px; }

  /* Included pages */
  .page-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 270px), 1fr));
    gap: 20px;
  }
  .page-card {
    display: block;
    background: #ffffff;
    border: 1px solid var(--rule-3);
    border-radius: var(--r-lg);
    padding: 24px;
    transition: border-color var(--dur) var(--ease), transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }
  .page-card:hover {
    border-color: var(--ink-200);
    transform: translateY(-3px);
    box-shadow: var(--sh);
    opacity: 1;
  }
  .page-desc {
    font-size: 14px;
    line-height: 1.65;
    color: var(--ink-2);
    margin: 8px 0 0;
    text-wrap: pretty;
  }
  .page-path {
    font-family: var(--code);
    font-size: 12.5px;
    color: var(--ink-3);
    margin: 12px 0 0;
    word-break: break-all;
  }
  .page-idx { font-size: 13px; letter-spacing: .08em; }

  .drop-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 290px), 1fr));
    gap: 20px;
  }

  @media (max-width: 900px) {
    .brief { grid-template-columns: 1fr; gap: 32px; }
    .licence { position: static; }
    .pv-frame { height: 460px; }
  }
</style>
