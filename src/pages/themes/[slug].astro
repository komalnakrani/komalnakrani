---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { themes, type Theme } from '../../data/themes';

export function getStaticPaths() {
  return themes.map((theme) => ({
    params: { slug: theme.slug },
    props: { theme },
  }));
}

interface Props {
  theme: Theme;
}

const { theme } = Astro.props;
---
<Layout title={`${theme.name} Theme - Astro & Next.js | Komal Nakrani`} description={theme.description}>
  <main class="rise">
    <section class="wrap section">
      <div style="display: grid; grid-template-columns: 1fr 360px; gap: 48px; align-items: start;">
        <div>
          <a href="/themes/" class="k" style="margin-bottom: 20px; display: inline-flex; align-items: center; gap: 6px;">
            ← Back to Themes
          </a>
          <h1 class="display" style="font-size: clamp(34px, 4vw, 52px);">{theme.name}</h1>
          <p class="lead" style="margin-top: 14px; max-width: 640px;">{theme.tagline}</p>

          <div style={`height: 320px; background: ${theme.imageBg}; border-radius: var(--r-lg); margin: 32px 0; border: 1px solid var(--line-2); display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden;`}>
            <div style="text-align: center; color: #ffffff; z-index: 2;">
              <h3 style="font-family: var(--display); font-size: 32px; color: #ffffff;">{theme.name}</h3>
              <p class="mono" style="color: rgba(255,255,255,0.8); margin-top: 8px;">Interactive Live Demo Shell</p>
              <a href={`/preview/${theme.slug}/`} target="_blank" rel="noopener" class="btn btn-primary" style="margin-top: 16px;">
                Open Live Preview <Icon name="arrow-right" />
              </a>
            </div>
          </div>

          <div style="margin-top: 40px;">
            <h2 class="h2" style="margin-bottom: 16px;">What's Included</h2>
            <p class="body-t" style="margin-bottom: 24px;">{theme.description}</p>

            <ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 12px;">
              {theme.features.map((feat) => (
                <li style="display: flex; align-items: center; gap: 10px; font-family: var(--body); font-size: 16px;">
                  <span style="color: var(--accent); display: flex; align-items: center;"><Icon name="check" /></span>
                  <span>{feat}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div style="background: var(--surface); border: 1px solid var(--line-2); border-radius: var(--r-lg); padding: 28px; position: sticky; top: 96px; box-shadow: var(--sh);">
          <div style="margin-bottom: 24px; padding-bottom: 20px; border-bottom: 1px solid var(--line);">
            <div style="font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--ink-3);">Single Theme License</div>
            <div class="theme-price" style="font-size: 36px; margin: 6px 0 14px; color: var(--ink);">
              $29 <span style="font-size: 14px; color: var(--ink-3);">one-time</span>
            </div>
            <a href="#" data-plan-price="29" data-plan-name={theme.name} class="btn btn-primary btn-lg pay-trigger-btn" style="width: 100%;">
              Buy Single Theme ($29)
            </a>
          </div>

          <div>
            <div style="font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent);">Best Value Plan</div>
            <div class="theme-price" style="font-size: 28px; margin: 4px 0 6px; color: var(--ink);">
              $199 <span style="font-size: 13px; color: var(--ink-3);">/ lifetime</span>
            </div>
            <p class="small" style="color: var(--ink-2); margin-bottom: 14px;">Unlocks all 200 themes + 4 AI kits with lifetime updates.</p>
            <a href="/bundles/" class="btn btn-secondary" style="width: 100%;">
              Get $199 All-Access Pass
            </a>
          </div>

          <div style="margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--line);">
            <div style="font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--ink-3); margin-bottom: 10px;">Tech Stack</div>
            <div style="display: flex; flex-wrap: wrap; gap: 6px;">
              {theme.techStack.map((tech) => (
                <span class="tech-item">{tech}</span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
