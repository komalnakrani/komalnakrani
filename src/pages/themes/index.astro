---
import Layout from '../../layouts/Layout.astro';
import K from '../../components/K.astro';
import Icon from '../../components/Icon.astro';
import ThemeCard from '../../components/ThemeCard.astro';
import { themes } from '../../data/themes';

// Filter strictly Next.js themes
const nextThemes = themes.filter((t) => t.framework === 'nextjs');

// Komal Nakrani Original Category Taxonomy
const komalCategories = [
  { slug: 'all', label: 'All Next.js Themes' },
  { slug: 'saas', label: 'SaaS & B2B' },
  { slug: 'ai-app', label: 'AI Agent Apps' },
  { slug: 'agency', label: 'Creative & Editorial' },
  { slug: 'shader', label: 'WebGL & 3D Shaders' },
  { slug: 'docs', label: 'Developer Docs' },
  { slug: 'ecommerce', label: 'Marketplace & Stores' },
  { slug: 'portfolio', label: 'Portfolios & Media' },
  { slug: 'directory', label: 'Directories & Job Boards' }
];
---
<Layout title="Next.js 16 Production Web Themes | Komal Nakrani Marketplace" description="Explore production-grade Next.js 16 App Router templates categorized across SaaS, AI Apps, Editorial Studios, 3D Shaders, Developer Docs, and Marketplaces.">
  <main class="rise">
    <section class="wrap section">
      <div style="text-align: center; max-width: 760px; margin: 0 auto 40px;">
        <K idx="01">Next.js 16 Product Catalog</K>
        <h1 class="display" style="margin-top: 14px;">
          Next.js 16 Production <span class="grad">Themes</span>
        </h1>
        <p class="lead" style="margin-top: 14px;">
          Engineered for high-performing tech startups, agencies, and AI developers. Buy individual Next.js themes for $29 or unlock all themes + AI kits for $199 lifetime.
        </p>
      </div>

      <!-- Komal Nakrani Category Filter Bar -->
      <div class="komal-cat-bar">
        <div class="cat-bar-track">
          {komalCategories.map((cat, idx) => (
            <button class={`cat-pill-btn ${idx === 0 ? 'active' : ''}`} data-cat-filter={cat.slug}>
              {cat.label}
            </button>
          ))}
        </div>
      </div>

      <!-- Live Search Bar -->
      <div style="max-width: 600px; margin: 0 auto 48px; position: relative;">
        <input
          type="text"
          id="theme-search-input"
          placeholder="Search Next.js themes by name, category, or tech stack..."
          style="width: 100%; padding: 14px 20px; border-radius: var(--r-md); background: rgba(255,255,255,0.04); border: 1px solid var(--bd-subtle); color: #fff; font-size: 15px; outline: none; transition: border-color 0.2s;"
        />
      </div>

      <!-- Next.js Themes Grid -->
      <div class="grid grid-3" id="themes-grid">
        {nextThemes.map((theme) => (
          <div class="theme-card-wrapper" data-category={theme.category} data-framework={theme.framework} data-name={theme.name.toLowerCase()} data-tech={theme.techStack.join(' ').toLowerCase()}>
            <ThemeCard theme={theme} />
          </div>
        ))}
      </div>

      <div id="no-results" style="display: none; text-align: center; padding: 60px 20px;">
        <p style="font-size: 18px; color: var(--fg-muted);">No Next.js themes found matching your filter criteria.</p>
        <button id="reset-filters-btn" class="btn btn-secondary" style="margin-top: 16px;">Reset Search & Filters</button>
      </div>
    </section>
  </main>
</Layout>

<style>
  .komal-cat-bar {
    display: flex;
    justify-content: center;
    margin-bottom: 32px;
    overflow-x: auto;
    padding: 4px 0;
  }
  .cat-bar-track {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .cat-pill-btn {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--bd-subtle);
    color: var(--fg-muted);
    padding: 8px 18px;
    border-radius: 9999px;
    font-size: 13.5px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .cat-pill-btn:hover {
    color: #fff;
    border-color: rgba(255, 103, 17, 0.4);
    background: rgba(255, 103, 17, 0.08);
  }
  .cat-pill-btn.active {
    background: var(--accent);
    color: #ffffff;
    border-color: var(--accent);
    font-weight: 600;
    box-shadow: 0 4px 14px rgba(255, 103, 17, 0.35);
  }
</style>

<script>
  const searchInput = document.getElementById('theme-search-input') as HTMLInputElement | null;
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.cat-pill-btn');
  const themeCards = document.querySelectorAll<HTMLElement>('.theme-card-wrapper');
  const noResults = document.getElementById('no-results');
  const resetBtn = document.getElementById('reset-filters-btn');

  let activeCategory = 'all';

  function filterGrid() {
    const query = searchInput?.value.toLowerCase().trim() || '';
    let visibleCount = 0;

    themeCards.forEach((card) => {
      const cardCat = card.getAttribute('data-category') || '';
      const cardName = card.getAttribute('data-name') || '';
      const cardTech = card.getAttribute('data-tech') || '';

      const matchesCat = activeCategory === 'all' || cardCat === activeCategory || (activeCategory === 'shader' && cardCat === 'agency');
      const matchesSearch = !query || cardName.includes(query) || cardTech.includes(query);

      if (matchesCat && matchesSearch) {
        card.style.display = 'block';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    if (noResults) {
      noResults.style.display = visibleCount === 0 ? 'block' : 'none';
    }
  }

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      activeCategory = btn.getAttribute('data-cat-filter') || 'all';
      filterGrid();
    });
  });

  searchInput?.addEventListener('input', filterGrid);

  resetBtn?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    activeCategory = 'all';
    filterBtns.forEach((b) => b.classList.remove('active'));
    filterBtns[0]?.classList.add('active');
    filterGrid();
  });
</script>
