---
import Layout from '../layouts/Layout.astro';
import Btn from '../components/Btn.astro';
import K from '../components/K.astro';
---
<Layout title="Page not found | Komal Nakrani" noindex>
  <main class="wrap" style="padding-top:96px; padding-bottom:128px">
    <K idx="404">Not found</K>
    <h1 class="h1" style="margin-top:18px">This page is not in the library.</h1>
    <p class="lead" style="margin-top:16px">It may belong to an unpublished role or a future edition.</p>
    <div style="margin-top:28px"><Btn href="/" icon="arrow-left">Return home</Btn></div>
  </main>
</Layout>
