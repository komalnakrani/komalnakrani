---
import Layout from '../../layouts/Layout.astro';
import K from '../../components/K.astro';
import { ROLES } from '../../data/publications';
---
<Layout title="Roles | Komal Nakrani" description="Role learning paths and original books by Komal Nakrani.">
  <main class="rise">
    <section class="wrap" style="padding-top:64px">
      <K sig>Role library</K>
      <h1 class="h1" style="margin:18px 0 0">Roles</h1>
      <p class="lead" style="margin-top:16px; max-width:760px">
        Each role starts with a validated boundary and competency map before any book is written.
      </p>
    </section>
    <section class="wrap section" style="padding-top:60px">
      {ROLES.length > 0 ? (
        <div class="topics">
          {ROLES.map((role) => (
            <a class="topic" href={`/roles/${role.slug}/`}>
              <span class="tc">{role.status}</span>
              <span class="tn">{role.title}</span>
              <span class="td">{role.summary}</span>
            </a>
          ))}
        </div>
      ) : (
        <div style="border-top:1px solid var(--line-2); padding-top:28px; max-width:760px">
          <K idx="00">Research queue</K>
          <h2 class="h2" style="margin-top:16px">Role publications are being built sequentially.</h2>
          <p class="body-t" style="margin-top:14px">A role appears here only after its scope and evidence have been reviewed.</p>
        </div>
      )}
    </section>
  </main>
</Layout>
