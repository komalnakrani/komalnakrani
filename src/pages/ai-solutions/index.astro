---
import Layout from '../../layouts/Layout.astro';
import K from '../../components/K.astro';
import AISolutionCard from '../../components/AISolutionCard.astro';
import { aiSolutions } from '../../data/ai-solutions';
---
<Layout title="Turnkey AI Solutions & AI Agent Kits | Komal Nakrani" description="Ready-to-deploy AI solutions, RAG engines, multi-agent pipelines, local LLM wrappers, and sub-400ms voice AI agents.">
  <main class="rise">
    <section class="wrap section">
      <div style="max-width: 720px; margin-bottom: 40px;">
        <K idx="01">Turnkey AI Kits</K>
        <h1 class="display" style="margin-top: 14px;">
          No-Brainer <span class="grad">AI Solutions</span>
        </h1>
        <p class="lead" style="margin-top: 18px;">
          Stop wrestling with complex AI glue code. Production-ready AI agent architectures, vector pipelines, and streaming UIs ready to drop into your codebase.
        </p>
      </div>

      <div class="grid-cards">
        {aiSolutions.map((solution) => (
          <AISolutionCard solution={solution} />
        ))}
      </div>
    </section>
  </main>
</Layout>
