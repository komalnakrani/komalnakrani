---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { aiSolutions, type AISolution } from '../../data/ai-solutions';

export function getStaticPaths() {
  return aiSolutions.map((solution) => ({
    params: { slug: solution.slug },
    props: { solution },
  }));
}

interface Props {
  solution: AISolution;
}

const { solution } = Astro.props;
---
<Layout title={`${solution.name} - AI Solution Kit | Komal Nakrani`} description={solution.description}>
  <main class="rise">
    <section class="wrap section">
      <div style="display: grid; grid-template-columns: 1fr 360px; gap: 48px; align-items: start;">
        <div>
          <a href="/ai-solutions/" class="k" style="margin-bottom: 20px; display: inline-flex; align-items: center; gap: 6px;">
            ← Back to AI Solutions
          </a>
          <h1 class="display" style="font-size: clamp(32px, 3.8vw, 48px);">{solution.name}</h1>
          <p class="lead" style="margin-top: 14px; max-width: 640px;">{solution.tagline}</p>

          <div style="background: var(--ark-ink); color: #ffffff; border-radius: var(--r-lg); padding: 28px; margin: 32px 0; border: 1px solid rgba(255, 103, 17, 0.3);">
            <div style="font-family: var(--mono); font-size: 11px; text-transform: uppercase; color: var(--accent); letter-spacing: 0.12em; margin-bottom: 8px;">Architecture Blueprint</div>
            <div style="font-family: var(--mono); font-size: 15px; line-height: 1.6; color: var(--ark-paper);">{solution.architecture}</div>
          </div>

          <div>
            <h2 class="h2" style="margin-bottom: 16px;">What's Included in Kit</h2>
            <p class="body-t" style="margin-bottom: 24px;">{solution.description}</p>

            <ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 14px;">
              {solution.features.map((feat) => (
                <li style="display: flex; align-items: flex-start; gap: 10px; font-family: var(--body); font-size: 16px; line-height: 1.5;">
                  <span style="color: var(--accent); display: flex; align-items: center; margin-top: 2px;"><Icon name="check" /></span>
                  <span>{feat}</span>
                </li>
              ))}
            </ul>

            <h3 class="h3" style="margin: 36px 0 16px;">Primary Production Use Cases</h3>
            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 12px;">
              {solution.useCases.map((useCase) => (
                <div style="background: var(--surface-2); border: 1px solid var(--line); border-radius: var(--r-sm); padding: 14px; font-family: var(--body); font-size: 14px; font-weight: 500;">
                  {useCase}
                </div>
              ))}
            </div>
          </div>
        </div>

        <div style="background: var(--surface); border: 1px solid var(--line-2); border-radius: var(--r-lg); padding: 28px; position: sticky; top: 96px; box-shadow: var(--sh);">
          <div style="margin-bottom: 24px; padding-bottom: 20px; border-bottom: 1px solid var(--line);">
            <div style="font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--ink-3);">Single Solution Kit</div>
            <div class="theme-price" style="font-size: 36px; margin: 6px 0 6px; color: var(--ink);">
              $39 <span style="font-size: 14px; color: var(--ink-3);">one-time</span>
            </div>
            <p class="small" style="color: var(--ink-2); margin-bottom: 14px;">Includes source code + Learning & Setup Guide PDF.</p>
            <a href="#" data-plan-price="39" data-plan-name={solution.name} class="btn btn-primary btn-lg pay-trigger-btn" style="width: 100%;">
              Buy Solution Kit ($39)
            </a>
          </div>

          <div>
            <div style="font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent);">Best Value Plan</div>
            <div class="theme-price" style="font-size: 28px; margin: 4px 0 6px; color: var(--ink);">
              $199 <span style="font-size: 13px; color: var(--ink-3);">/ lifetime</span>
            </div>
            <p class="small" style="color: var(--ink-2); margin-bottom: 14px;">Unlocks all AI kits + 200 themes with lifetime updates.</p>
            <a href="/bundles/" class="btn btn-secondary" style="width: 100%;">
              Get $199 All-Access Pass
            </a>
          </div>

          <div style="margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--line);">
            <div style="font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--ink-3); margin-bottom: 10px;">Tech Stack</div>
            <div style="display: flex; flex-wrap: wrap; gap: 6px;">
              {solution.techStack.map((tech) => (
                <span class="tech-item">{tech}</span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
