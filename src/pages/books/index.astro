---
import Layout from '../../layouts/Layout.astro';
import K from '../../components/K.astro';
import BookCard from '../../components/BookCard.astro';
import { BOOKS } from '../../data/publications';
---
<Layout title="Books | Komal Nakrani" description="Original role-based books by Komal Nakrani.">
  <main class="rise">
    <section class="wrap" style="padding-top:64px">
      <K sig>The library</K>
      <h1 class="h1" style="margin:18px 0 0">Books</h1>
      <p class="lead" style="margin-top:16px; max-width:760px">
        Every publication here is written fresh for a defined professional role and released only after source and editorial review.
      </p>
    </section>
    <section class="wrap catalog" style="padding-top:60px; padding-bottom:96px">
      {BOOKS.length > 0 ? (
        <div class="catgrid">{BOOKS.map((book) => <BookCard book={book} />)}</div>
      ) : (
        <div class="ticked" style="border:1px solid var(--line-2); background:var(--surface); padding:48px; max-width:760px">
          <K idx="00">Editorial queue</K>
          <h2 class="h2" style="margin-top:16px">The first original title is in preparation.</h2>
          <p class="body-t" style="margin:14px 0 0">No inherited books are displayed. New publications will appear after their research, manuscript, source, and edition checks pass.</p>
        </div>
      )}
    </section>
  </main>
</Layout>
