---
import Layout from '../../layouts/Layout.astro';
import Btn from '../../components/Btn.astro';
import Cover from '../../components/Cover.astro';
import K from '../../components/K.astro';
import { BOOKS } from '../../data/publications';

export function getStaticPaths() {
  return BOOKS.filter((book) => book.status === 'published').map((book) => ({
    params: { id: book.slug },
    props: { book },
  }));
}

const { book } = Astro.props;
---
<Layout title={`${book.title} | Komal Nakrani`} description={book.description}>
  <main class="rise">
    <article class="wrap read book-reader">
      <Btn variant="ghost" href="/books/" icon="arrow-left">All books</Btn>
      <header class="reader-hero">
        <div class="reader-cover"><Cover book={book} /></div>
        <div>
          <K idx={book.edition.label} sig>{book.series.title} · Volume {book.volume}</K>
          <h1 class="h1" style="margin:18px 0 0">{book.title}</h1>
          <p class="lead" style="margin-top:14px">{book.subtitle}</p>
          <p class="body-t" style="margin-top:22px">{book.description}</p>
          <div class="reader-actions" aria-label="Book actions">
            <Btn href={`/books/${book.slug}/${book.chapters[0].slug}/`} icon="book-open">Start reading</Btn>
            {book.pdf.enabled && (
              <Btn variant="secondary" href={`/downloads/${book.pdf.filename}`} icon="file-text">
                Download PDF
              </Btn>
            )}
          </div>
          <dl class="specrow reader-spec">
            <div><dt class="sk">Edition</dt><dd class="sv">{book.edition.label}</dd></div>
            <div><dt class="sk">Version</dt><dd class="sv">{book.edition.version}</dd></div>
            <div><dt class="sk">Published</dt><dd class="sv"><time datetime={book.edition.publishedAt ?? undefined}>{book.edition.publishedAt}</time></dd></div>
          </dl>
        </div>
      </header>
      <section class="reader-toc" aria-label="Table of contents">
        <K>Table of contents</K>
        <div class="chapter-list" style="margin-top:18px">
          {book.chapters.map((chapter, index) => (
            <a class="chapter-row" href={`/books/${book.slug}/${chapter.slug}/`}>
              <span class="chapter-no">{String(index + 1).padStart(2, '0')}</span>
              <span><strong>{chapter.title}</strong><em>{chapter.summary}</em></span>
              <small>{chapter.minutes} min</small>
            </a>
          ))}
        </div>
      </section>
      <div class="reader-actions">
        <Btn variant="ghost" href={`/books/${book.slug}/editions/`}>Editions</Btn>
        <Btn variant="ghost" href={`/books/${book.slug}/errata/`}>Errata</Btn>
      </div>
    </article>
  </main>
</Layout>
