---
import Layout from '../../../layouts/Layout.astro';
import Btn from '../../../components/Btn.astro';
import K from '../../../components/K.astro';
import { BOOKS } from '../../../data/publications';

export function getStaticPaths() {
  return BOOKS.filter((book) => book.status === 'published').flatMap((book) =>
    book.chapters.map((chapter, index) => ({
      params: { id: book.slug, chapter: chapter.slug },
      props: { book, chapter, index },
    })),
  );
}

const { book, chapter, index } = Astro.props;
const previous = book.chapters[index - 1];
const next = book.chapters[index + 1];
const chapterModules = import.meta.glob('../../../../content/publications/*/chapters/*.mdx');
const chapterKey = `../../../../content/publications/${book.slug}/${chapter.sourceFile}`;
const loadChapter = chapterModules[chapterKey];
if (!loadChapter) throw new Error(`Validated chapter module is missing: ${chapterKey}`);
const ChapterContent = ((await loadChapter()) as { default: (_props: Record<string, unknown>) => unknown }).default;
---
<Layout title={`${chapter.title} | ${book.title} | Komal Nakrani`} description={chapter.summary}>
  <main class="rise">
    <article class="wrap read book-reader">
      <Btn variant="ghost" href={`/books/${book.slug}/`} icon="arrow-left">Book overview</Btn>
      <div class="read-grid reader-grid" style="margin-top:20px">
        <div>
          <K idx={String(index + 1).padStart(2, '0')} sig>{book.title}</K>
          <h1 class="h1" style="margin:18px 0 0">{chapter.title}</h1>
          <p class="lead" style="margin-top:16px">{chapter.summary}</p>
          <div class="prose book-prose">
            <ChapterContent />
          </div>
          <nav class="chapter-nav" aria-label="Chapter navigation">
            <a href={previous ? `/books/${book.slug}/${previous.slug}/` : `/books/${book.slug}/`}>
              <span>{previous ? 'Previous' : 'Overview'}</span>
              <strong>{previous?.title ?? book.title}</strong>
            </a>
            <a href={next ? `/books/${book.slug}/${next.slug}/` : '/books/'}>
              <span>{next ? 'Next' : 'Library'}</span>
              <strong>{next?.title ?? 'All books'}</strong>
            </a>
          </nav>
        </div>
      </div>
    </article>
  </main>
</Layout>
