---
import Layout from '../../../../layouts/Layout.astro';
import Btn from '../../../../components/Btn.astro';
import K from '../../../../components/K.astro';
import { BOOKS } from '../../../../data/publications';

export function getStaticPaths() {
  return BOOKS.map((book) => ({
    params: { id: book.slug, version: book.edition.version },
    props: { book },
  }));
}
const { book } = Astro.props;
---
<Layout title={`${book.edition.label} | ${book.title} | Komal Nakrani`} description={`Edition record for ${book.title}.`}>
  <main class="wrap" style="padding-top:64px; padding-bottom:96px">
    <Btn variant="ghost" href={`/books/${book.slug}/editions/`} icon="arrow-left">All editions</Btn>
    <div style="margin-top:34px"><K idx={book.edition.version} sig>Edition record</K></div>
    <h1 class="h1" style="margin-top:18px">{book.edition.label}</h1>
    <dl class="specrow" style="margin-top:34px; max-width:820px">
      <div><dt class="sk">Book</dt><dd class="sv">{book.title}</dd></div>
      <div><dt class="sk">Published</dt><dd class="sv"><time datetime={book.edition.publishedAt ?? undefined}>{book.edition.publishedAt}</time></dd></div>
      <div><dt class="sk">Status</dt><dd class="sv">{book.status}</dd></div>
    </dl>
    {book.pdf.enabled && (
      <div class="reader-actions">
        <Btn href={`/downloads/${book.pdf.filename}`} icon="file-text">Download this edition</Btn>
        <Btn variant="ghost" href={`/books/${book.slug}/${book.chapters[0].slug}/`} icon="book-open">Read online</Btn>
      </div>
    )}
  </main>
</Layout>
