---
import Layout from '../../../../layouts/Layout.astro';
import Btn from '../../../../components/Btn.astro';
import K from '../../../../components/K.astro';
import { BOOKS, errataForBook } from '../../../../data/publications';

export function getStaticPaths() {
  return BOOKS.flatMap((book) =>
    errataForBook(book.slug).map((erratum) => ({
      params: { id: book.slug, erratum: erratum.id },
      props: { book, erratum },
    })),
  );
}
const { book, erratum } = Astro.props;
---
<Layout title={`${erratum.location} erratum | ${book.title}`} description={erratum.description}>
  <main class="wrap" style="padding-top:64px; padding-bottom:96px">
    <Btn variant="ghost" href={`/books/${book.slug}/errata/`} icon="arrow-left">All errata</Btn>
    <div style="margin-top:34px"><K idx={erratum.id} sig>{erratum.status}</K></div>
    <h1 class="h1" style="margin-top:18px">{erratum.location}</h1>
    <div class="prose" style="margin-top:28px; max-width:760px">
      <p>{erratum.description}</p>
      {erratum.correction && <><h2>Correction</h2><p>{erratum.correction}</p></>}
    </div>
  </main>
</Layout>
