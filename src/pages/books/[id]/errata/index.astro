---
import Layout from '../../../../layouts/Layout.astro';
import Btn from '../../../../components/Btn.astro';
import K from '../../../../components/K.astro';
import { BOOKS, errataForBook } from '../../../../data/publications';

export function getStaticPaths() {
  return BOOKS.map((book) => ({
    params: { id: book.slug },
    props: { book, errata: errataForBook(book.slug) },
  }));
}
const { book, errata } = Astro.props;
---
<Layout title={`Errata | ${book.title} | Komal Nakrani`} description={`Corrections and clarifications for ${book.title}.`}>
  <main class="wrap" style="padding-top:64px; padding-bottom:96px">
    <Btn variant="ghost" href={`/books/${book.slug}/`} icon="arrow-left">Book overview</Btn>
    <div style="margin-top:34px"><K sig>Transparent corrections</K></div>
    <h1 class="h1" style="margin-top:18px">Errata</h1>
    {errata.length === 0 ? (
      <p class="lead" style="margin-top:24px">No errata are recorded for {book.edition.label}.</p>
    ) : (
      <div style="margin-top:32px; max-width:820px">
        {errata.map((item) => (
          <a class="brow" href={`/books/${book.slug}/errata/${item.id}/`}>
            <div><h2 class="h3">{item.location}</h2><p class="small">{item.description}</p></div>
            <span class="tag">{item.status}</span>
          </a>
        ))}
      </div>
    )}
  </main>
</Layout>
