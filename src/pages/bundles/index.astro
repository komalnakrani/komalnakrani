---
import Layout from '../../layouts/Layout.astro';
import K from '../../components/K.astro';
import Icon from '../../components/Icon.astro';
---
<Layout title="Pricing Plans - $29 Single Theme & $199 Lifetime | Komal Nakrani" description="Simple, transparent pricing. Buy individual themes for $29 or unlock all 200 themes + AI kits for $199 lifetime.">
  <main class="rise">
    <section class="wrap section">
      <div style="text-align: center; max-width: 720px; margin: 0 auto 48px;">
        <K idx="01">Pricing Plans</K>
        <h1 class="display" style="margin-top: 14px;">
          Simple, Transparent <span class="grad">Pricing</span>
        </h1>
        <p class="lead" style="margin-top: 16px;">
          Choose individual $29 themes or unlock the complete library of 200 themes + AI kits for a single $199 lifetime fee.
        </p>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1.2fr; gap: 32px; max-width: 960px; margin: 0 auto; align-items: stretch;">
        <!-- Single Theme License ($29) -->
        <div style="background: var(--surface); border: 1px solid var(--line-2); border-radius: var(--r-lg); padding: 40px 32px; display: flex; flex-direction: column;">
          <h3 class="h3">Single Theme License</h3>
          <p class="small" style="margin: 8px 0 20px;">Ideal for launching a single project.</p>
          <div style="font-family: var(--display); font-weight: 700; font-size: 48px; color: var(--ink);">$29 <span style="font-size: 16px; color: var(--ink-3); font-weight: 400;">/ theme</span></div>
          
          <ul style="list-style: none; padding: 0; margin: 28px 0; display: flex; flex-direction: column; gap: 12px; flex: 1;">
            <li class="ai-feature-item"><Icon name="check" /> Full source code for 1 Theme</li>
            <li class="ai-feature-item"><Icon name="check" /> Astro 5 or Next.js 15 version</li>
            <li class="ai-feature-item"><Icon name="check" /> Commercial & Client License</li>
            <li class="ai-feature-item"><Icon name="check" /> Lifetime Theme Updates</li>
            <li class="ai-feature-item"><Icon name="check" /> 100/100 Lighthouse Speed</li>
          </ul>
          <a href="/themes/" class="btn btn-secondary btn-lg" style="width: 100%;">
            Browse $29 Themes
          </a>
        </div>

        <!-- All-Access Pass ($199 Lifetime) -->
        <div style="background: var(--ark-ink); color: #ffffff; border: 2px solid var(--accent); border-radius: var(--r-lg); padding: 44px 36px; display: flex; flex-direction: column; position: relative; box-shadow: var(--sh-lg); transform: translateY(-4px);">
          <div style="position: absolute; top: -14px; left: 50%; transform: translateX(-50%); background: var(--accent); color: #ffffff; font-family: var(--mono); font-size: 10px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; padding: 4px 14px; border-radius: var(--r-pill); box-shadow: 0 4px 12px rgba(255, 103, 17, 0.4);">
            BEST VALUE · MOST POPULAR
          </div>
          <h3 class="h3" style="color: #ffffff;">All-Access Pass</h3>
          <p class="small" style="margin: 8px 0 20px; color: var(--ark-grey-300);">Get everything today and all future releases.</p>
          <div style="font-family: var(--display); font-weight: 700; font-size: 54px; color: #ffffff; line-height: 1;">
            $199 <span style="font-size: 16px; color: var(--ark-grey-400); font-weight: 400;">/ lifetime</span>
          </div>

          <ul style="list-style: none; padding: 0; margin: 28px 0; display: flex; flex-direction: column; gap: 12px; flex: 1;">
            <li class="ai-feature-item" style="color: #ffffff;"><Icon name="check" /> <strong>All 100 Astro 5 Themes</strong></li>
            <li class="ai-feature-item" style="color: #ffffff;"><Icon name="check" /> <strong>All 100 Next.js 15 Themes</strong></li>
            <li class="ai-feature-item" style="color: #ffffff;"><Icon name="check" /> <strong>All 4 Turnkey AI Solution Kits</strong></li>
            <li class="ai-feature-item" style="color: #ffffff;"><Icon name="check" /> Unlimited Client & Commercial Licenses</li>
            <li class="ai-feature-item" style="color: #ffffff;"><Icon name="check" /> All Future Releases Free Forever</li>
          </ul>
          <a href="#" class="btn btn-primary btn-lg" style="width: 100%;">
            Get All-Access Lifetime Pass ($199) <Icon name="arrow-right" />
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
