---
import { themes, type Theme } from '../../data/themes';
import Icon from '../../components/Icon.astro';
import '../../styles/theme.css';
import '../../styles/components.css';

export function getStaticPaths() {
  return themes.map((theme) => ({
    params: { slug: theme.slug },
    props: { theme },
  }));
}

interface Props {
  theme: Theme;
}

const { theme } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{theme.name} - Interactive Demo</title>
    <style>
      body { margin: 0; padding: 0; background: #0d0d0d; color: #ffffff; font-family: var(--body); }
      .demo-nav { padding: 18px 32px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid rgba(255,255,255,0.1); background: rgba(16,24,32,0.95); }
      .demo-hero { padding: 80px 24px; text-align: center; max-width: 900px; margin: 0 auto; }
      .demo-badge { display: inline-block; padding: 4px 14px; border-radius: 99px; background: rgba(255,103,17,0.12); color: #ff6711; font-family: monospace; font-size: 11px; font-weight: 700; border: 1px solid rgba(255,103,17,0.3); margin-bottom: 20px; }
      .demo-[#ff6711] { color: #ff6711; }
      .demo-card-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 24px; max-width: 1100px; margin: 40px auto; padding: 0 24px; }
      .demo-card { background: #101820; border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; padding: 24px; text-align: left; }
      .demo-cta-btn { background: #ff6711; color: #ffffff; padding: 14px 28px; border-radius: 8px; font-weight: 700; text-decoration: none; display: inline-block; }
    </style>
  </head>
  <body>
    <!-- Category-Specific Interactive Demo Interfaces -->

    {theme.category === 'saas' && (
      <div>
        <nav class="demo-nav">
          <div style="font-weight: 800; font-size: 20px;">{theme.name.split(' ')[0]}<span style="color: #ff6711;">SaaS</span></div>
          <div style="display: flex; gap: 20px; font-size: 14px; color: #9ca3af;">
            <span>Features</span><span>Pricing</span><span>Integrations</span>
            <a href="#" class="demo-cta-btn" style="padding: 6px 16px; font-size: 13px;">Get Started</a>
          </div>
        </nav>

        <section class="demo-hero">
          <span class="demo-badge">{theme.badge || 'Next.js 16 SaaS Engine'}</span>
          <h1 style="font-size: clamp(36px, 5vw, 64px); margin: 0 0 16px; font-weight: 800; line-height: 1.1;">
            {theme.tagline}
          </h1>
          <p style="font-size: 18px; color: #9ca3af; line-height: 1.6; max-width: 640px; margin: 0 auto 32px;">
            {theme.description}
          </p>
          <a href="#" class="demo-cta-btn">Start Free Trial →</a>

          <div class="demo-card-grid">
            {theme.features.map((feat, idx) => (
              <div class="demo-card">
                <div style="color: #ff6711; font-family: monospace; font-weight: 700; font-size: 13px; margin-bottom: 8px;">0{idx + 1}. CAPABILITY</div>
                <h3 style="font-size: 18px; margin: 0 0 8px;">{feat}</h3>
                <p style="font-size: 13.5px; color: #9ca3af; margin: 0; line-height: 1.5;">Type-safe production implementation with 100/100 Core Web Vitals performance.</p>
              </div>
            ))}
          </div>
        </section>
      </div>
    )}

    {theme.category === 'agency' && (
      <div style="background: #fffdfa; color: #101820; min-height: 100vh; font-family: Georgia, serif;">
        <nav class="demo-nav" style="background: #fffdfa; border-color: #ede9e3; color: #101820;">
          <div style="font-weight: 700; font-size: 22px;">{theme.name}</div>
          <div style="font-family: sans-serif; font-size: 13px; color: #555;">Editorial Agency & Portfolio</div>
        </nav>

        <section style="max-width: 900px; margin: 0 auto; padding: 80px 24px;">
          <span style="font-family: monospace; font-size: 11px; color: #ff6711; letter-spacing: 0.1em; text-transform: uppercase;">SELECTED WORK & DIRECTION</span>
          <h1 style="font-size: 56px; font-weight: 400; margin: 16px 0 24px; line-height: 1.15;">{theme.tagline}</h1>
          <p style="font-family: sans-serif; font-size: 18px; color: #666; line-height: 1.6;">{theme.description}</p>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 48px;">
            {theme.features.map((feat) => (
              <div style="background: #fdf9f4; border: 1px solid #ede9e3; padding: 28px; border-radius: 8px;">
                <h4 style="font-size: 20px; font-weight: 400; margin: 0 0 8px;">{feat}</h4>
                <p style="font-family: sans-serif; font-size: 13.5px; color: #777; margin: 0;">Editorial grid layout with custom typography tokens.</p>
              </div>
            ))}
          </div>
        </section>
      </div>
    )}

    {theme.category === 'portfolio' && (
      <div style="position: relative; overflow: hidden; min-height: 100vh;">
        <nav class="demo-nav">
          <div style="font-weight: 800; font-size: 18px; color: #ff6711;">3D CANVAS SHADER</div>
          <div style="font-family: monospace; font-size: 12px; color: #9ca3af;">THREE.JS / GLSL</div>
        </nav>

        <section class="demo-hero" style="position: relative; z-index: 2;">
          <span class="demo-badge">60 FPS GPU-ACCELERATED SHADER</span>
          <h1 style="font-size: 52px; font-weight: 800; margin: 0 0 16px;">{theme.name}</h1>
          <p style="font-size: 18px; color: #a1a1aa; max-width: 600px; margin: 0 auto 32px;">{theme.tagline}</p>
          <a href="#" class="demo-cta-btn">Launch Shader Experience</a>

          <div class="demo-card-grid">
            {theme.features.map((feat) => (
              <div class="demo-card">
                <h4 style="color: #ff6711; font-size: 16px; margin: 0 0 6px;">{feat}</h4>
                <p style="font-size: 13px; color: #9ca3af; margin: 0;">GPU-accelerated WebGL fragment shader with custom post-processing pipeline.</p>
              </div>
            ))}
          </div>
        </section>
      </div>
    )}

    {theme.category === 'docs' && (
      <div style="display: grid; grid-template-columns: 240px 1fr; min-height: 100vh;">
        <aside style="border-right: 1px solid #1f2937; padding: 24px; background: #101820;">
          <div style="font-weight: 800; font-size: 16px; color: #ff6711; margin-bottom: 20px;">{theme.name}</div>
          <div style="font-size: 13px; color: #9ca3af; display: flex; flex-direction: column; gap: 10px;">
            <div style="color: #ffffff; font-weight: 600;">1. Overview</div>
            <div>2. Installation</div>
            <div>3. Architecture</div>
            <div>4. API Explorer</div>
          </div>
        </aside>
        <main style="padding: 48px;">
          <span class="demo-badge">PAGEFIND OFFLINE SEARCH</span>
          <h1 style="font-size: 40px; margin: 12px 0;">{theme.name}</h1>
          <p style="font-size: 17px; color: #9ca3af; max-width: 640px; margin-bottom: 32px;">{theme.description}</p>
          
          <div style="background: #101820; border: 1px solid #1f2937; border-radius: 8px; padding: 20px; font-family: monospace; font-size: 13px; color: #ff6711;">
            npm install @komal/{theme.slug}
          </div>
        </main>
      </div>
    )}

    {theme.category === 'ecommerce' && (
      <div>
        <nav class="demo-nav">
          <div style="font-weight: 800; font-size: 20px;">{theme.name}</div>
          <div style="font-size: 13px; color: #ff6711;">🛒 Cart (0)</div>
        </nav>

        <section class="demo-hero">
          <span class="demo-badge">DIGITAL GOODS STOREFRONT</span>
          <h1 style="font-size: 48px; margin: 0 0 16px;">{theme.tagline}</h1>
          <p style="font-size: 17px; color: #9ca3af; max-width: 600px; margin: 0 auto 32px;">{theme.description}</p>

          <div class="demo-card-grid">
            {theme.features.map((feat) => (
              <div class="demo-card">
                <div style="font-weight: 700; font-size: 18px; margin-bottom: 8px;">{feat}</div>
                <div style="font-size: 20px; font-weight: 800; color: #ff6711; margin-bottom: 12px;">$29.00</div>
                <a href="#" class="demo-cta-btn" style="padding: 8px 16px; font-size: 13px; width: 100%; text-align: center; box-sizing: border-box;">Add to Cart</a>
              </div>
            ))}
          </div>
        </section>
      </div>
    )}
  </body>
</html>
