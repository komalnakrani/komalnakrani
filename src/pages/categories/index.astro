---
import Layout from '../../layouts/Layout.astro';
import K from '../../components/K.astro';
import Icon from '../../components/Icon.astro';
import { CATEGORIES, themes, isThemeInCategory } from '../../data/themes';

// Calculate theme count per category (including multi-category themes)
// Only surface categories that hold at least one theme — an empty category
// page is a dead end for the visitor and a thin page for search.
const categoryCounts = CATEGORIES
  .map((cat) => ({ ...cat, count: themes.filter((t) => isThemeInCategory(t, cat.slug)).length }))
  .filter((cat) => cat.count > 0);
---
<Layout title="All Theme Categories | Komal Nakrani Marketplace" description="Browse production-grade web templates across our curated categories.">
  <main class="rise" style="background: var(--bg); min-height: 100vh; color: var(--ink);">
    <section class="wrap section" style="padding-top: 40px; padding-bottom: 80px;">
      <div style="text-align: center; max-width: 760px; margin: 0 auto 36px;">
        <K idx="01">Category Directory</K>
        <h1 class="display" style="margin-top: 14px;">Browse by category</h1>
        <p class="lead" style="margin-top: 14px; color: var(--ink-2); font-size: 17px; line-height: 1.6;">
          Explore themes organized across industry-tailored verticals.
        </p>
      </div>

      <!-- Live Category Search Bar -->
      <div style="max-width: 560px; margin: 0 auto 48px; position: relative;">
        <input
          type="text"
          id="category-search-input"
          placeholder="Filter categories (e.g. Technology, SaaS, Editorial)..."
          class="search-input"
        />
      </div>

      <!-- Category Cards Grid -->
      <div class="category-grid" id="categories-grid">
        {categoryCounts.map((cat) => (
          <a
            href={`/categories/${cat.slug}/`}
            class="category-card"
            data-name={cat.name.toLowerCase()}
            data-slug={cat.slug.toLowerCase()}
          >
            <h3 class="category-title">{cat.name}</h3>
            <p class="category-desc">{cat.description}</p>
            <div class="category-link">
              <span>Browse Category</span>
              <Icon name="arrow-right" size={16} />
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>
</Layout>

<style>
  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 290px), 1fr));
    gap: 20px;
    max-width: 1200px;
    margin: 0 auto;
  }
  .category-card {
    background: #ffffff;
    border: 1px solid var(--rule-3);
    border-radius: var(--r-lg);
    padding: 24px;
    text-decoration: none;
    color: var(--ink);
    display: flex;
    flex-direction: column;
    box-shadow: var(--sh-sm);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.25s ease, box-shadow 0.25s ease;
  }
  .category-card:hover {
    transform: translateY(-3px);
    border-color: var(--ink-200);
    box-shadow: var(--sh);
  }
  .category-tag {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--accent-text);
    background: var(--sage-tint);
    padding: 4px 11px;
    border-radius: var(--r-pill);
  }
  .category-count {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink-3);
  }
  .category-title {
    font-size: 19px;
    font-weight: 400;
    letter-spacing: -.02em;
    margin: 8px 0;
    color: var(--ink);
    line-height: 1.25;
  }
  .category-desc {
    font-size: 14px;
    color: var(--ink-2);
    line-height: 1.65;
    margin: 0 0 22px;
    flex: 1;
    text-wrap: pretty;
  }
  .category-link {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--accent-text);
    font-size: 13px;
    transition: gap 0.2s ease;
  }
  .category-card:hover .category-link {
    gap: 10px;
  }
</style>

<script>
  const searchInput = document.getElementById('category-search-input') as HTMLInputElement | null;
  const categoryCards = document.querySelectorAll<HTMLElement>('#categories-grid .category-card');

  searchInput?.addEventListener('input', () => {
    const query = searchInput.value.toLowerCase().trim();

    categoryCards.forEach((card) => {
      const name = card.getAttribute('data-name') || '';
      const slug = card.getAttribute('data-slug') || '';

      if (!query || name.includes(query) || slug.includes(query)) {
        card.style.display = 'flex';
      } else {
        card.style.display = 'none';
      }
    });
  });
</script>


