---
import Layout from '../../layouts/Layout.astro';
import K from '../../components/K.astro';
import ThemeCard from '../../components/ThemeCard.astro';
import CategorySidebar from '../../components/CategorySidebar.astro';
import Icon from '../../components/Icon.astro';
import { CATEGORIES, themes, isThemeInCategory, type CategoryMeta } from '../../data/themes';

export function getStaticPaths() {
  const allCategories: CategoryMeta[] = [
    { slug: 'featured', name: 'Featured', description: 'Explore top-rated, handpicked themes featured across our catalog.' },
    ...CATEGORIES,
  ];
  return allCategories
    .filter((category) => themes.some((t) => isThemeInCategory(t, category.slug)))
    .map((category) => ({
      params: { slug: category.slug },
      props: { category },
    }));
}

interface Props {
  category: CategoryMeta;
}

const { category } = Astro.props;

const categoryBreadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Categories', url: '/categories/' },
  { name: category.name, url: `/categories/${category.slug}/` }
];

const categoryThemes = themes.filter((t) => isThemeInCategory(t, category.slug));

const categoryItems = categoryThemes.map((t) => ({
  name: t.name || t.slug,
  url: `/themes/${t.slug}/`,
  description: t.description || t.tagline
}));
---
<Layout
  title={`${category.name} Themes | Komal Nakrani`}
  description={`Explore production-ready themes in the ${category.name} category.`}
  type="category"
  breadcrumbs={categoryBreadcrumbs}
  itemList={categoryItems}
>
  <main class="rise" style="background: var(--bg); min-height: 100vh; color: var(--ink);">
    <section class="wrap section" style="padding-top: 36px; padding-bottom: 80px;">
      <!-- Breadcrumbs -->
      <nav class="cat-breadcrumbs" aria-label="Breadcrumb navigation">
        <a href="/">Home</a>
        <Icon name="arrow-right" size={12} />
        <a href="/categories/">Categories</a>
        <Icon name="arrow-right" size={12} />
        <span class="active">{category.name}</span>
      </nav>

      <!-- Category Hero Banner -->
      <div class="cat-hero-banner">
        <div style="max-width: 760px;">
          <K idx="01">Category Catalog</K>
          <h1 class="display" style="margin-top: 10px; font-size: clamp(30px, 4.6vw, 46px);">{category.name} themes</h1>
          <p class="lead" style="margin-top: 10px; color: var(--ink-2); font-size: 16px; line-height: 1.6;">
            {category.description || `Production web templates engineered for ${category.name.toLowerCase()} applications.`}
          </p>
        </div>
      </div>

      <!-- 2-Column Storefront Layout (Sidebar + Themes Grid) -->
      <div class="cat-marketplace-layout">
        <!-- Sticky Sidebar with All Categories -->
        <CategorySidebar activeCategory={category.slug} />

        <!-- Main Content Area -->
        <div class="cat-main-content">
          <!-- Search & Header Bar -->
          <div class="cat-filter-header">
            <div class="cat-search-box">
              <input
                type="text"
                id="category-search-input"
                placeholder={`Search ${category.name} themes...`}
              />
            </div>
          </div>

          <!-- Themes Grid -->
          <div class="themes-catalog-grid" id="category-themes-grid">
            {categoryThemes.map((theme) => (
              <div
                class="theme-card-wrapper"
                data-name={theme.name.toLowerCase()}
                data-tech={theme.techStack.join(' ').toLowerCase()}
              >
                <ThemeCard theme={theme} />
              </div>
            ))}
          </div>

          <div id="no-category-results" style="display: none; text-align: center; padding: 60px 20px; background: #ffffff; border-radius: var(--r-lg); border: 1px solid var(--rule-3);">
            <p style="font-size: 16px; color: var(--ink-2);">No themes match your search query in {category.name}.</p>
            <a href="/themes/" class="btn btn-primary" style="margin-top: 14px;">Explore All Themes</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .cat-breadcrumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink-3);
    margin-bottom: 24px;
  }
  .cat-breadcrumbs a {
    color: var(--ink-2);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .cat-breadcrumbs a:hover {
    color: var(--ink);
  }
  .cat-breadcrumbs .active {
    color: var(--accent-text);
  }

  .cat-hero-banner {
    background: #ffffff;
    border: 1px solid var(--rule-3);
    border-radius: var(--r-lg);
    padding: 36px 40px;
    margin-bottom: 36px;
  }

  .cat-marketplace-layout {
    display: flex;
    gap: 32px;
    align-items: flex-start;
  }

  .cat-main-content {
    flex: 1;
    min-width: 0;
  }

  .cat-filter-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 24px;
    flex-wrap: wrap;
  }

  .cat-search-box {
    flex: 1;
    min-width: 260px;
  }

  .cat-search-box input {
    width: 100%;
    padding: 12px 20px;
    border-radius: var(--r-pill);
    background: #ffffff;
    border: 1px solid var(--rule-2);
    color: var(--ink);
    font-family: var(--body);
    font-size: 14px;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .cat-search-box input:focus {
    border-color: var(--sage);
    box-shadow: 0 0 0 3px var(--sage-tint);
  }

  .cat-count-badge {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink-3);
    background: #ffffff;
    border: 1px solid var(--rule-2);
    padding: 10px 18px;
    border-radius: var(--r-pill);
  }

  .themes-catalog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 290px), 1fr));
    gap: 20px;
  }

  @media (max-width: 960px) {
    .cat-marketplace-layout {
      flex-direction: column;
    }
    .cat-hero-banner {
      padding: 24px;
    }
  }

  @media (max-width: 640px) {
    .themes-catalog-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const searchInput = document.getElementById('category-search-input') as HTMLInputElement | null;
  const themeCards = document.querySelectorAll<HTMLElement>('#category-themes-grid .theme-card-wrapper');
  const noResults = document.getElementById('no-category-results');

  searchInput?.addEventListener('input', () => {
    const query = searchInput.value.toLowerCase().trim();
    let visible = 0;

    themeCards.forEach((card) => {
      const name = card.getAttribute('data-name') || '';
      const tech = card.getAttribute('data-tech') || '';
      if (!query || name.includes(query) || tech.includes(query)) {
        card.style.display = 'block';
        visible++;
      } else {
        card.style.display = 'none';
      }
    });

    if (noResults) {
      noResults.style.display = visible === 0 ? 'block' : 'none';
    }
  });
</script>


