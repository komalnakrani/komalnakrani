---
import '../styles/theme.css';
import '../styles/components.css';
import Masthead from '../components/Masthead.astro';
import Footer from '../components/Footer.astro';
import SEOJsonLd, {
  type FAQItem,
  type BreadcrumbItem,
  type ProductItem,
  type ArticleItem,
  type ListItem
} from '../components/SEOJsonLd.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Social preview image, root-relative. Defaults to the site card. */
  image?: string;
  type?: 'website' | 'product' | 'article' | 'faq' | 'category';
  faqs?: FAQItem[];
  breadcrumbs?: BreadcrumbItem[];
  product?: ProductItem;
  article?: ArticleItem;
  itemList?: ListItem[];
}

const {
  title = 'Komal Nakrani | Production-ready web themes',
  description = 'Hand-built, production-ready Astro web themes with zero-JS output and full source. Preview every breakpoint before you pay.',
  noindex = false,
  image = '/og/default.jpg',
  type = 'website',
  faqs = [],
  breadcrumbs = [],
  product,
  article,
  itemList,
} = Astro.props;

const site = 'https://komalnakrani.com';
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(image, site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FBFAF6" />
    <meta name="author" content="Komal Nakrani" />
    <meta name="keywords" content="Astro themes, web templates, static site templates, portfolio templates, e-commerce templates, zero-JS websites" />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content={type === 'product' ? 'og:product' : 'website'} />
    <meta property="og:site_name" content="Komal Nakrani Themes" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <title>{title}</title>
    <SEOJsonLd
      title={title}
      description={description}
      canonicalUrl={canonical}
      type={type}
      faqs={faqs}
      breadcrumbs={breadcrumbs}
      product={product}
      article={article}
      itemList={itemList}
    />
  </head>
  <body>
    <Masthead />
    <slot />
    <Footer />
  </body>
</html>
