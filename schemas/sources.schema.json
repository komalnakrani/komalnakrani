{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://komalnakrani.com/schemas/sources.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sources"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "title", "authors", "publisher", "url", "publishedAt", "accessedAt", "license", "usedIn"],
        "properties": {
          "id": { "type": "string", "pattern": "^SRC-[0-9]{3,}$" },
          "type": { "enum": ["standard", "documentation", "paper", "book", "report", "dataset", "interview", "job-analysis", "web"] },
          "title": { "type": "string", "minLength": 3 },
          "authors": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2 } },
          "publisher": { "type": "string", "minLength": 2 },
          "url": { "type": "string", "format": "uri" },
          "publishedAt": { "type": ["string", "null"], "format": "date" },
          "accessedAt": { "type": "string", "format": "date" },
          "license": { "type": "string", "minLength": 2 },
          "notes": { "type": "string" },
          "usedIn": {
            "type": "object",
            "additionalProperties": false,
            "required": ["chapterSlugs", "claimIds"],
            "properties": {
              "chapterSlugs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" } },
              "claimIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^CLM-[0-9]{3,}$" } }
            }
          }
        }
      }
    }
  }
}
