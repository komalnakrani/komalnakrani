{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://komalnakrani.com/schemas/publication.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "slug", "roleSlug", "series", "volume", "title", "subtitle", "description", "author", "language", "status", "cover", "edition", "chapters", "registries", "pdf"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "slug": { "$ref": "#/$defs/slug" },
    "roleSlug": { "$ref": "#/$defs/slug" },
    "series": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "title"],
      "properties": {
        "slug": { "$ref": "#/$defs/slug" },
        "title": { "type": "string", "minLength": 3 }
      }
    },
    "volume": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 3 },
    "subtitle": { "type": "string", "minLength": 8 },
    "description": { "type": "string", "minLength": 30 },
    "author": { "const": "Komal Nakrani" },
    "language": { "const": "en" },
    "status": { "$ref": "#/$defs/status" },
    "cover": { "enum": ["indigo", "ink", "clay", "paper", "blueprint"] },
    "edition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "label", "publishedAt", "copyrightYear", "canonicalUrl"],
      "properties": {
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "label": { "type": "string", "minLength": 3 },
        "publishedAt": { "type": ["string", "null"], "format": "date" },
        "copyrightYear": { "type": "integer", "minimum": 2026, "maximum": 2200 },
        "canonicalUrl": { "type": "string", "format": "uri", "pattern": "^https://komalnakrani\\.com/books/" }
      }
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "slug", "title", "summary", "minutes", "sourceFile", "objectiveIds"],
        "properties": {
          "order": { "type": "integer", "minimum": 1 },
          "slug": { "$ref": "#/$defs/slug" },
          "title": { "type": "string", "minLength": 3 },
          "summary": { "type": "string", "minLength": 20 },
          "minutes": { "type": "integer", "minimum": 1 },
          "sourceFile": { "type": "string", "pattern": "^chapters/[a-z0-9][a-z0-9-]*\\.mdx$" },
          "objectiveIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
        }
      }
    },
    "registries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "claims", "figures", "errata"],
      "properties": {
        "sources": { "const": "sources.json" },
        "claims": { "const": "claims.json" },
        "figures": { "const": "figures.json" },
        "errata": { "const": "errata.json" }
      }
    },
    "pdf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "filename"],
      "properties": {
        "enabled": { "type": "boolean" },
        "filename": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*-v[0-9]+\\.[0-9]+\\.[0-9]+\\.pdf$" }
      }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$" },
    "status": { "enum": ["planned", "research", "draft", "review", "published", "withdrawn"] }
  }
}
